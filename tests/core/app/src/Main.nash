module Main exposing (..)

import Builtin exposing (type bool(..), Data(..))
import Eq exposing (Eq)
import Literal
import Num exposing (Num)
import Integral exposing (Integral)
import Semigroup exposing (Semigroup)
import Monoid exposing (Monoid)
import Ord exposing (Ord)
import Ordering exposing (type ordering(..))
import Show exposing (Show)
import Bool exposing (not, xor)
import Prelude exposing (..)
import Lift exposing (Lift)
import Unit exposing (Unit)
import Option exposing (Option, type option(..))

optionalEquality = eq (Some True) (Some False)
optionalDefault = Option.withDefault True None
liftedOption : Option Bool.Bool
liftedOption = lift (Some True)
loweredOption : option bool
loweredOption = lower liftedOption
nestedOption : Option (Option Bool.Bool)
nestedOption = lift (Some (Some True))
loweredNestedOption : option (option bool)
loweredNestedOption = lower nestedOption
emptyOption : Option Unit
emptyOption = lift emptyLittleOption
emptyLittleOption : option unit
emptyLittleOption = None
loweredEmptyOption : option unit
loweredEmptyOption = lower emptyOption

liftedBool : Bool.Bool
liftedBool = lift True
loweredBool : bool
loweredBool = lower liftedBool
liftedUnit : Unit
liftedUnit = lift ()
loweredUnit : unit
loweredUnit = lower liftedUnit
liftedOrdering : Ordering.Ordering
liftedOrdering = lift LT
loweredOrdering : ordering
loweredOrdering = lower liftedOrdering
reflexiveBool : Bool.Bool
reflexiveBool = lift liftedBool

integers = eq 1 2
preludeOps = ((1 + 2) * 3, 1 == 1, [1] ++ [2])
booleanOps = (not True, xor True False, True && False || True)
tupleEquality = ((1, True) == (1, True), (1, True, "x") /= (2, False, "y"), (1, True, "x", #"00") == (1, True, "x", #"ff"))
tupleOrdering = (compare (1, False) (1, True), compare (1, False, "a") (1, False, "b"), compare (1, False, "a", #"00") (1, False, "a", #"ff"))
shownTuples = (show (1, True), show (1, True, "x"), show (1, True, "x", #"00ff"))
prepended = 1 :: [2, 3]
piped = 2 |> ((+) 1)
composed = ((\x -> x + 1) << (\x -> x * 2)) 3
strings = neq "one" "two"
bytes = eq #"cafe" #"cafe"
booleans = eq True False
integerOrder = compare 1 2
byteOrder = compare #"00" #"ff"
stringOrder = compare "a" "b"
boolOrder = compare False True
unitOrder = compare () ()
listOrder = compare [1, 2] [1, 3]
orderingEqual = eq (Ordering.invert LT) GT
orderingThen = Ordering.then_ EQ LT
shownIntegers = (show 0, show (-123), show 123456789012345678901234567890)
shownBytes = (show #"", show #"00ff")
shownString = show "quoted \"text\"\n"
shownControls = show "\u{0000}\t\r\n\\"
shownUnicode = show "λ😀"
shownBool = show True
shownUnit = show ()
shownList = (show emptyList, show [1, 2, 3])
shownPair = show (Builtin.mkPairData (I 1) (B #"ff"))
shownData = show (Constr 0 [I 1, List [B #"ff"], Map [Builtin.mkPairData (I 2) (B #"")]])
orderDefaults = ((lt 1 2, le 1 2, gt 2 1), (ge 2 1, max 1 2, min 1 2))

orderedEqual : Ord 'a => 'a -> 'a -> bool
orderedEqual a b = if lt a b then False else eq a b
units = eq () ()
lists = eq [1, 2] [1, 2]
pairs a b = eq (Builtin.mkPairData a b) (Builtin.mkPairData b a)
data = eq (I 1) (Constr 0 [I 1])

negative = -1
arithmetic = add (mul 2 3) (sub 5 4)
division = (div (-7) 3, mod (-7) 3)
quotient = (quot (-7) 3, rem (-7) 3)

twice : Integral 'a => 'a -> 'a
twice x = add x x

withEmpty : Monoid 'a => 'a -> 'a
withEmpty x = append empty x

emptyString : string
emptyString = empty
emptyBytes : bytes
emptyBytes = empty
emptyList : list int
emptyList = empty
emptyUnit : unit
emptyUnit = empty
combined = append [1, 2] [3]
text = withEmpty "text"
