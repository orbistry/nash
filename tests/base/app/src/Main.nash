rightMap : Map Int Bytes
rightMap = fromData (Map [Builtin.mkPairData (I 2) (B #"cc"), Builtin.mkPairData (I 2) (B #"dd")])
combinedMap : list (pair Int Bytes)
combinedMap = Map.union leftMap rightMap
mapWithEmpty : list (pair Int Bytes)
mapWithEmpty = Map.union leftMap emptyEntries
mergeMaps : Eq 'k => Map 'k 'v -> Map 'k 'v -> list (pair 'k 'v)
mergeMaps = Map.union

