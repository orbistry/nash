module Main exposing (..)


projectedPair = Pair.snd (Builtin.unConstrData (Builtin.constrData 0 [I 1]))
madePair = Pair.fst (Pair.make (I 1) (B #"ff"))
arrayValues = Array.fromList [1, 2]
arrayQueries = (Array.length arrayValues, Array.at arrayValues 1, Array.get arrayValues (-1), Array.get arrayValues 2)
bigArray : array Packet
bigArray = Array.fromList [Packet integerLiteral]
bigArrayResult : option Packet
bigArrayResult = Array.get bigArray 0

mappedOption = map (\x -> (x, x)) (Some ())
appliedOption = apply (Some (\x -> (x, x))) (Some ())
optionDo = do
    first <- Some ()
    second <- Some (first, first)
    pure (first, second)

mappedBuiltinList = map Builtin.iData [1, 2]
mappedOperator = (\x -> (x, x)) <$> Some ()
appliedOperator = Some (\x -> (x, x)) <*> Some ()
boundOperator = Some () >>= (\x -> Some (x, x))

mappedCons = map (\x -> (x, x)) (Cons.singleton ())

type Packet = Packet Int
automaticBigEq = (eq (Packet integerLiteral) (Packet bigInteger), neq (Packet integerLiteral) (Packet bigInteger))

ledgerValue = Builtin.unValueData (Map [])
ledgerValueNegative = Builtin.insertCoin #"" #"" (-1) ledgerValue
ledgerValueEquality = eq ledgerValueNegative ledgerValueNegative

functions = Cons.singleton (\x -> x)
appliedFunctions = Cons.map (\f -> f ()) functions
termPairs = Cons.map (\x -> (x, x)) (Cons.fromList [1, 2])
consEquality = eq appliedFunctions (Cons.singleton ())
shownCons = show termPairs
consIndices = Cons.indexedMap (\index value -> (index, value)) appliedFunctions
consPaired = Cons.map2 (\a b -> (a, b)) (Cons.fromList [1, 2]) appliedFunctions
consLength = Cons.length (Cons.append appliedFunctions Nil)
consLeftFold = Cons.foldl (\item acc -> sub item acc) 0 (Cons.fromList [1, 2])
consRightFold = Cons.foldr sub 0 (Cons.fromList [1, 2])
consRoundTrip = Cons.toList (Cons.fromList [1, 2])

emptyBigMap : Map Int Bytes
