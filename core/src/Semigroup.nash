module Semigroup exposing (Semigroup)

import Builtin
import Eq exposing (Eq)

trait Semigroup 'a where
    append : 'a -> 'a -> 'a

impl Semigroup bytes where
    append = Builtin.appendByteString

impl Semigroup string where
    append = Builtin.appendString

impl Semigroup (list 'a) where
    append xs ys =
        case xs of
            [] -> ys
            head :: tail -> Builtin.mkCons head (append tail ys)

impl Semigroup unit where
    append _ _ = ()

impl Semigroup Bytes where
    append a b =
        Builtin.castLift
            (Builtin.appendByteString
                (Builtin.unBData (Builtin.castToData a))
                (Builtin.unBData (Builtin.castToData b)))

impl Semigroup (List 'a) where
    append xs ys =
        Builtin.castLift
            (append
                (Builtin.unListData (Builtin.castToData xs))
                (Builtin.unListData (Builtin.castToData ys)))

impl Eq 'k => Semigroup (Map 'k 'v) where
    append left right =
        let
            leftEntries = unwrapMap left
            rightEntries = unwrapMap right
        in
        wrapMap (append (withoutRightKeys leftEntries rightEntries) rightEntries)

wrapMap : list (pair 'k 'v) -> Map 'k 'v
wrapMap = Builtin.castLift

unwrapMap : Map 'k 'v -> list (pair 'k 'v)
unwrapMap = Builtin.castLower

withoutRightKeys : Eq 'k => list (pair 'k 'v) -> list (pair 'k 'v) -> list (pair 'k 'v)
withoutRightKeys left right =
    case left of
        [] -> []
        entry :: rest ->
            if containsKey (Builtin.fstPair entry) right then
                withoutRightKeys rest right
            else Builtin.mkCons entry (withoutRightKeys rest right)

containsKey : Eq 'k => 'k -> list (pair 'k 'v) -> bool
containsKey key entries =
    case entries of
        [] -> Builtin.False
        entry :: rest ->
            if eq key (Builtin.fstPair entry) then Builtin.True
            else containsKey key rest
