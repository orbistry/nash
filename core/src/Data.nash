module Data exposing (ToData, FromData, serialise, tag, fields)

import Builtin exposing (Data(..), Big)
import Option exposing (type option(..))

trait ToData ('a : Big) where
    toData : 'a -> Data
    toData = Builtin.coerce

impl Big 'a => ToData 'a where

trait FromData ('a : Big) where
    fromData : Data -> 'a
    fromData = Builtin.coerce
    validateData : Data -> 'a

impl FromData Data where
    validateData value = value

impl FromData Int where
    validateData value =
        case value of
            I _ -> Builtin.coerce value
            _ -> fail

impl FromData Bytes where
    validateData value =
        case value of
            B _ -> Builtin.coerce value
            _ -> fail

serialise : Data -> bytes
serialise = Builtin.serialiseData

tag : Data -> option int
tag value =
    case value of
        Constr index _ -> Some index
        _ -> None

fields : Data -> option (list Data)
fields value =
    case value of
        Constr _ items -> Some items
        _ -> None

impl FromData 'a => FromData (List 'a) where
    validateData value =
        case value of
            List values -> Builtin.listData (mapList validateData values)
            _ -> fail

impl (FromData 'k, FromData 'v) => FromData (Map 'k 'v) where
    validateData value =
        case value of
            Map values -> Builtin.mapData (mapList pairValidateData values)
            _ -> fail

mapList : ('a -> 'b) -> list 'a -> list 'b
mapList f values =
    case values of
        [] -> []
        first :: rest -> Builtin.mkCons (f first) (mapList f rest)

pairValidateData : (FromData 'k, FromData 'v) => pair Data Data -> pair 'k 'v
pairValidateData value = Builtin.mkPairData (validateData (Builtin.fstPair value)) (validateData (Builtin.sndPair value))
