module Main exposing (..)
type int = Mine
local = Mine
little : Builtin.list Builtin.Int -> list Int
little x = x
big : Builtin.List Builtin.Int -> List Int
big x = x
integer : Builtin.int -> Builtin.int
integer x = x
trait Keep 'a where
    keep : 'a -> 'a
impl Keep () where
    keep x = x
main : Builtin.unit
main = keep ()
