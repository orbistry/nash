module Main exposing (..)

import Types exposing (..)

type local 'f 'a = Local ('f 'a)
type w = W (applied tag unit) (local tag unit)
type nested = Nested (app (app tag) unit)

witness : applied tag unit
witness = Applied (Tag ())

identity : applied tag unit -> applied tag unit
identity value = value

trait Marker 'a where
    marker : 'a -> unit

impl Marker (applied tag unit) where
    marker _ = ()
