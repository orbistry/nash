module Main exposing (..)
import Applicative exposing (Applicative)
import Monad exposing (Monad)
import Prelude exposing (..)
import Option exposing (type option(..))
import Result exposing (type result(..))
pairActions action = do
    first <- action
    second <- action
    pure (first, second)
optionResult = pairActions (Some ())
resultResult : result unit (unit, unit)
resultResult = pairActions (Ok ())
mapped = (\x -> (x, x)) <$> Some ()
applied = Some (\x -> (x, x)) <*> Some ()
bound = Some () >>= (\x -> Some (x, x))
