module Main exposing (..)
trait Pick 'a where
    pick : 'a -> 'a
type box 'a = Box 'a
impl Pick (box (box unit)) where
    pick x = x
impl Pick (box (box int)) where
    pick x = x
nested = pick (Box (Box ()))
trait Same 'a 'b where
    same : 'a -> 'b -> 'a
impl Same (box 'a) (box 'a) where
    same first _ = first
repeated = same (Box ()) (Box ())
