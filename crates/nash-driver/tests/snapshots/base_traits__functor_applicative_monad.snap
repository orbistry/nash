description: "module Main exposing (..)\n\nincrement x = x + 1\noptionNone : option int\noptionNone = None\nbigList : List Int\nbigList = lift [Builtin.iData 1, Builtin.iData 2]\n\ndoOption : option int\ndoOption = do\n    x <- Some 1\n    y <- Some 2\n    pure (x + y)\n\nfailOption : int -> option int\nfailOption _ = fail \"must not bind None\"\ntests\n    test \"builtin list functor changes representation\" = do\n        assert (map Builtin.iData [1, 2] == [Builtin.iData 1, Builtin.iData 2])\n        assert (map Builtin.unIData (map Builtin.iData [1, 2]) == [1, 2])\n    test \"Big list helper returns little list\" = do\n        assert (List.map (\\x -> Int.add x 1) bigList == [2, 3])\n    test \"option functor applicative and monad\" = do\n        assert ((increment <$> Some 1) == Some 2)\n        assert ((increment <$> optionNone) == None)\n        assert ((pure increment <*> Some 1) == Some 2)\n        assert ((Some increment <*> optionNone) == None)\n        assert ((Some 1 >>= (\\x -> Some (x + 1))) == Some 2)\n        assert ((optionNone >>= failOption) == None)\n    test \"do binding\" = do\n        assert (doOption == Some 3)\n"
