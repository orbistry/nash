source: crates/nash-driver/tests/base_traits.rs
description: "module Main exposing (..)\n\nincrement x = x + 1\noptionNone : option int\noptionNone = None\nresultOk : result string int\nresultOk = Ok 1\nresultErr : result string int\nresultErr = Err \"bad\"\nresultFunction : result string (int -> int)\nresultFunction = pure increment\nbigList : List Int\nbigList = lift [Builtin.iData 1, Builtin.iData 2]\n\ndoResult : option int\ndoResult = do\n    x <- Some 1\n    y <- Some 2\n    pure (x + y)\n\nfailOption : int -> option int\nfailOption _ = fail \"must not bind None\"\nfailResult : int -> result string int\nfailResult _ = fail \"must not bind Err\"\n\ntests\n    test \"builtin list functor changes representation\" = do\n        assert (map Builtin.iData [1, 2] == [Builtin.iData 1, Builtin.iData 2])\n        assert (map Builtin.unIData (map Builtin.iData [1, 2]) == [1, 2])\n    test \"Big list functor\" = do\n        assert (Builtin.unListData (map (\\x -> x + 1) bigList) == [Builtin.iData 2, Builtin.iData 3])\n    test \"option functor applicative and monad\" = do\n        assert ((increment <$> Some 1) == Some 2)\n        assert ((increment <$> optionNone) == None)\n        assert ((pure increment <*> Some 1) == Some 2)\n        assert ((Some increment <*> optionNone) == None)\n        assert ((Some 1 >>= (\\x -> Some (x + 1))) == Some 2)\n        assert ((optionNone >>= failOption) == None)\n    test \"result functor applicative and monad\" = do\n        assert (map increment resultOk == Ok 2)\n        assert (map increment resultErr == Err \"bad\")\n        assert ((resultFunction <*> resultOk) == Ok 2)\n        assert ((resultFunction <*> resultErr) == Err \"bad\")\n        assert ((resultOk >>= (\\x -> Ok (x + 1))) == Ok 2)\n        assert ((resultErr >>= failResult) == Err \"bad\")\n    test \"do binding\" = do\n        assert (doResult == Some 3)\n"
