---
source: crates/nash-driver/tests/cardano.rs
description: "validator module Values exposing (main)\n\nimport Cardano.Value as Value\n\ncoin = Value.singleton #\"706f6c696379\" #\"6173736574\" 5\nquantity value = Value.quantityOf #\"706f6c696379\" #\"6173736574\" value\n\nmain : Data -> unit\nmain raw =\n    case raw of\n        Constr pair(0, [amountData, comparisonData]) ->\n            let\n                amounts : List Int\n                amounts = validate amountData\n                comparisons : List Bool\n                comparisons = validate comparisonData\n                actualAmounts = [quantity coin, Value.quantityOf #\"706f6c696379\" #\"6d697373696e67\" coin, Value.quantityOf #\"6d697373696e67\" #\"6173736574\" coin, quantity (Value.add coin coin), quantity (Value.scale -2 coin), quantity (Value.singleton #\"706f6c696379\" #\"6173736574\" 0)]\n                actualComparisons = [Value.contains (Value.scale 2 coin) coin, Value.contains coin (Value.scale 2 coin), Value.contains coin (Value.singleton #\"706f6c696379\" #\"6d697373696e67\" 1)]\n                _ = assert (actualAmounts == List.map lower amounts)\n            in\n            assert (actualComparisons == List.map lower comparisons)\n        _ -> fail\n"
---
Ok(Constant(Unit))
