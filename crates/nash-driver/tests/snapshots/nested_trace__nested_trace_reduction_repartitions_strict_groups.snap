source: crates/nash-driver/tests/nested_trace.rs
description: "module NestedTrace exposing (generate, replay, dependent, siblings, repartition)\n\nimport Cons exposing (type cons(..))\nimport Prop exposing (type choiceTree(..), type prng(..), type generator, choice, group)\n\nreverse values = reverseOnto values Nil\nreverseOnto values result =\n    case values of\n        Nil -> result\n        Cons first rest -> reverseOnto rest (Cons first result)\n\nfinish : option ('a, prng) -> option ('a, choiceTree)\nfinish result =\n    case result of\n        None -> None\n        Some (value, Seeded _ recorded) -> Some (value, Group (reverse recorded))\n        Some (value, Replayed _ recorded) -> Some (value, Group (reverse recorded))\n\nitems : int -> generator (list int)\nitems limit = Prop.listBetween 0 limit (choice 100)\n\ngenerate : bytes -> option (list int, choiceTree)\ngenerate seed = finish (items 4 (Seeded seed Nil))\n\nreplay : choiceTree -> option (list int, choiceTree)\nreplay choiceTree =\n    case choiceTree of\n        Group children -> finish (items 4 (Replayed children Nil))\n        _ -> None\n\nbounds : generator (int, int)\nbounds state =\n    case group (choice 9) state of\n        None -> None\n        Some (offset, next) ->\n            case group (choice offset) next of\n                None -> None\n                Some (index, final) -> Some ((offset + 1, index), final)\n\ndependent : choiceTree -> option ((int, int), choiceTree)\ndependent choiceTree =\n    case choiceTree of\n        Group children -> finish (bounds (Replayed children Nil))\n        _ -> None\n\nlistAndNumber : generator (list int, int)\nlistAndNumber state =\n    case group (items 4) state of\n        None -> None\n        Some (values, next) ->\n            case group (choice 100) next of\n                None -> None\n                Some (number, final) -> Some ((values, number), final)\n\nsiblings : choiceTree -> option ((list int, int), choiceTree)\nsiblings choiceTree =\n    case choiceTree of\n        Group children -> finish (listAndNumber (Replayed children Nil))\n        _ -> None\n\nbranch : generator int\nbranch state = do\n    (mode, next) <- choice 1 state\n    (_, following) <- choice 100 next\n    if mode == 0 then extra mode following else Some (mode, following)\n\nextra mode state =\n    case choice 100 state of\n        None -> None\n        Some (_, final) -> Some (mode, final)\n\nremaining : int -> generator int\nremaining mode state = do\n    (_, next) <- choice 100 state\n    if mode == 1 then choice 100 next else Some (mode, next)\n\nshifted : generator int\nshifted state = do\n    (mode, next) <- group branch state\n    (_, final) <- group (remaining mode) next\n    Some (mode, final)\n\nrepartition : choiceTree -> option (int, choiceTree)\nrepartition tree =\n    case tree of\n        Group children -> finish (shifted (Replayed children Nil))\n        _ -> None\n"
