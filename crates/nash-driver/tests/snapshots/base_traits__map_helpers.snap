---
source: crates/nash-driver/tests/base_traits.rs
description: "module Main exposing (..)\n\none : Int\none = 1\ntwo : Int\ntwo = 2\nthree : Int\nthree = 3\nemptyEntries : list (pair Int Int)\nemptyEntries = Map.empty\n\nentries : list (pair Int Int)\nentries = List.append (Map.singleton one two) (List.append (Map.singleton one three) (Map.singleton two one))\nbig : Map Int Int\nbig = lift entries\n\nnativeKey : int\nnativeKey = 4\n\nnative = [Builtin.unConstrData (Builtin.constrData 3 []), Builtin.unConstrData (Builtin.constrData 4 [toData one])]\n\nmissing : option Int\nmissing = Map.get three big\nmissingEmpty : option Int\nmissingEmpty = Map.get one emptyEntries\nremovedAll : list (pair Int Int)\nremovedAll = Map.remove one (Map.singleton one two)\nnormalized : list (pair Int Int)\nnormalized = Map.toList big\nsumEntry : Int -> Int -> int -> int\nsumEntry k v acc = acc * 10 + lower k + lower v\ncountEntry : Int -> Int -> int -> int\ncountEntry _ _ acc = acc + 1\nfilteredNative : list (pair int (list Data))\nfilteredNative = Map.remove 3 native\nunionNative : list (pair int (list Data))\nunionNative = Map.union native native\n\ntests\n    test \"lookup preserves elements and returns first duplicate\" = do\n        assert (Map.get one entries == Some two)\n        assert (Map.get one big == Some two)\n        assert (missing == None)\n        assert (missingEmpty == None)\n    test \"insertion replaces all duplicates and appends\" = do\n        assert (Map.insert one one big == List.append (Map.singleton two one) (Map.singleton one one))\n        assert (Map.insert three two big == List.append entries (Map.singleton three two))\n        assert (Map.insert one two emptyEntries == Map.singleton one two)\n    test \"removal preserves other entries\" = do\n        assert (Map.remove one big == Map.singleton two one)\n        assert (Map.remove three big == entries)\n        assert (removedAll == [])\n    test \"collections and folds preserve order and duplicates\" = do\n        assert (Map.keys normalized == [one, one, two])\n        assert (Map.values entries == [two, three, one])\n        assert (Map.toList big == entries)\n        assert (Map.toList entries == entries)\n        assert (Map.foldl sumEntry 0 big == 343)\n        assert (Map.foldl countEntry 0 emptyEntries == 0)\n    test \"read and filter little native pairs\" = do\n        assert (Map.keys native == [3, 4])\n        assert (Map.get nativeKey native == Some [toData one])\n        assert (Map.keys filteredNative == [4])\n        assert (Map.values unionNative == [[], [toData one]])\n"
