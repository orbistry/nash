---
source: crates/nash-driver/tests/base_traits.rs
description: "module Main exposing (..)\n\nimport Cons exposing (type cons(..))\n\nreplay choices = Prop.Replayed choices Nil\nc = Prop.Choice\ng = Prop.Group\none x = Cons x Nil\ntwo x y = Cons x (one y)\n\nvalue generator state = case generator state of\n    Some (result, _) -> Some result\n    None -> None\n\nseed = Prop.Seeded #\"\" Nil\nweights : cons (int, Prop.generator int)\nweights = Cons (0, \\_ -> fail) (Cons (3, Prop.constant 10) (Cons (1, Prop.constant 20) Nil))\nemptyWeights : cons (int, Prop.generator int)\nemptyWeights = Nil\nbigWeight : Int\nbigWeight = 2\nbigCount : Int\nbigCount = 3\n\nbyteDraw n = g (one (g (one (c n))))\n\nrebuild choices = Prop.Rebuilding choices Nil\nhuge : Int\nhuge = lift (18446744073709551616 * 18446744073709551616)\n\nhugeLittle : int\nhugeLittle = lower huge\nnever : Prop.generator int\nnever _ = fail\n\nsampleOffsets : int -> Prop.prng -> (int, int, int)\nsampleOffsets count state =\n    if count == 0 then (0, 0, 0)\n    else case Prop.intAtLeast 0 state of\n        None -> fail\n        Some (n, next) ->\n            let (zeros, small, large) = sampleOffsets (count - 1) next in\n            if n == 0 then (zeros + 1, small, large)\n            else if n <= 255 then (zeros, small + 1, large)\n            else (zeros, small, large + 1)\n\ntests\n    test \"small widths produce useful nonzero offsets\" = do\n        assert (value (Prop.intAtLeast 0) (rebuild [0, 0, 1]) == Some 1)\n        assert (value (Prop.intAtLeast 0) (rebuild [0, 1, 2]) == Some 2)\n        assert (value (Prop.intAtLeast 0) (rebuild [0, 3, 10]) == Some 10)\n        assert (value (Prop.intAtLeast 0) (rebuild [0, 6, 100]) == Some 100)\n        assert (value (Prop.intAtLeast 0) (rebuild [0, 7, 255]) == Some 255)\n        assert (value (Prop.intAtLeast 0) (rebuild [3, 0, 0, 256]) == Some 256)\n    test \"seeded offsets favor small nonzero values\" = do\n        let (zeros, small, large) = sampleOffsets 256 seed in\n            let _ = assert (zeros < 64 && small > 128 && large > 0) in\n            Builtin.trace (show (zeros, small, large)) ()\n    test \"wide range strict replay isolates rejected attempts\" = do\n        assert (value (Prop.intBetween 0 18446744073709551616) (replay (Cons (g (one (c 1))) (Cons (g (one (c 1))) (two (g (one (c 1))) (g (one (c 0))))))) == Some 18446744073709551616)\n    test \"weight totals can exceed one choice\" = do\n        let options = two (18446744073709551616, Prop.constant 10) (1, Prop.constant 20) in\n            assert (value (Prop.frequency options) (rebuild [1, 0]) == Some 20)\n        let options = two (18446744073709551616, Prop.constant 10) (1, Prop.constant 20) in\n            assert (value (Prop.frequency options) (rebuild [0, 18446744073709551615]) == Some 10)\n    test \"reversed byte lengths fail\" fail = do\n        case Prop.bytesBetween 3 2 of\n            _ -> ()\n    prop \"wide range counterexample replays and reduces\" fail once =\n        let n via Prop.intBetween hugeLittle (hugeLittle * 2) in\n        do\n            assert (n < 0)\n    test \"arbitrary integer offsets preserve large lower bounds\" = do\n        assert (value (Prop.intAtLeast huge) (rebuild [0, 0, 0]) == Some (lower huge))\n        assert (value (Prop.intAtLeast (-hugeLittle)) (rebuild [3, 3, 3, 3, 3, 3, 3, 3, 0, 0, 1, 0]) == Some (18446744073709551616 - lower huge))\n        assert (value Prop.int (rebuild [2, 3, 3, 3, 3, 3, 3, 3, 3, 0, 0, 1, 0, 0]) == Some 18446744073709551616)\n        assert (value Prop.int (rebuild [2, 3, 3, 3, 3, 3, 3, 3, 3, 0, 0, 1, 0, 1]) == Some (-18446744073709551616))\n    test \"wide bounded generation rejects overshoot then retries\" = do\n        assert (value (Prop.intBetween 0 18446744073709551616) (rebuild [1, 1, 1, 0]) == Some 18446744073709551616)\n        assert (value (Prop.intBetween 0 18446744073709551616) (rebuild [1, 1]) == None)\n    prop \"arbitrary integer lower bound\" =\n        let n via Prop.intAtLeast huge in\n        do\n            assert (n >= lower huge)\n    test \"boolean choices\" = do\n        assert (value Prop.bool (replay (one (c 0))) == Some False)\n        assert (value Prop.bool (replay (one (c 1))) == Some True)\n    test \"optional draw preserves absence and groups the payload\" = do\n        assert (value (Prop.option never) (replay (one (g (one (c 0))))) == Some None)\n        assert (value (Prop.option (Prop.choice 9)) (replay (two (g (one (c 1))) (g (one (c 7))))) == Some (Some 7))\n    test \"tuple bind preserves groups and remaining siblings\" = do\n        case Prop.tuple2 (Prop.choice 9) (Prop.choice 9) (replay (Cons (g (one (c 4))) (Cons (g (one (c 5))) (one (c 8))))) of\n            Some ((4, 5), Prop.Replayed rest used) ->\n                case (rest, used) of\n                    (Cons (Prop.Choice 8) Nil, Cons (Prop.Group (Cons (Prop.Choice 5) Nil)) (Cons (Prop.Group (Cons (Prop.Choice 4) Nil)) Nil)) -> ()\n                    _ -> fail\n            _ -> fail\n    test \"weighted endpoints skip zero weights\" = do\n        assert (value (Prop.frequency weights) (replay (two (c 0) (g Nil))) == Some 10)\n        assert (value (Prop.frequency weights) (replay (two (c 2) (g Nil))) == Some 10)\n        assert (value (Prop.frequency weights) (replay (two (c 3) (g Nil))) == Some 20)\n        assert (value (Prop.frequency (one (bigWeight, Prop.constant 9))) seed == Some 9)\n        assert (value (Prop.frequency emptyWeights) seed == None)\n        assert (value (Prop.frequency (one (0, Prop.constant 9))) seed == None)\n    test \"negative weights fail even after a positive entry\" fail = do\n        case Prop.frequency (Cons (1, Prop.constant 1) (one (-1, Prop.constant 2))) of\n            _ -> ()\n    test \"exact byte replay includes both endpoints\" = do\n        assert (value (Prop.bytesExactly 2) (replay (two (byteDraw 0) (byteDraw 255))) == Some #\"00ff\")\n        assert (value (Prop.bytesExactly 2) (replay (one (byteDraw 0))) == None)\n    test \"exact bytes normalize Big counts\" = do\n        case value (Prop.bytesExactly bigCount) seed of\n            Some bytes -> assert (Bytes.length bytes == 3)\n            None -> fail\n        assert (value (Prop.bytesExactly 0) (replay Nil) == Some #\"\")\n    test \"negative byte count fails\" fail = do\n        case Prop.bytesExactly -1 of\n            _ -> ()\n    prop \"byte length in bounds\" =\n        let bytes via Prop.bytesBetween 2 7 in\n        do\n            assert (Bytes.length bytes >= 2 && Bytes.length bytes <= 7)\n    prop \"generated integer bounds\" =\n        let lo via Prop.int\n            span via Prop.intBetween 0 1000\n        in\n        do\n            case value (Prop.intBetween lo (lo + span)) seed of\n                Some n -> assert (n >= lo && n <= lo + span)\n                None -> fail\n    prop \"listOf reduces to empty\" fail once =\n        let items via Prop.listOf Prop.int in\n        do\n            assert (List.length items < 0)\n    prop \"listOf reduces to one zero\" fail once =\n        let items via Prop.listOf Prop.int in\n        do\n            assert (List.length items == 0)\n"
