source: crates/nash-driver/tests/base_traits.rs
description: "module Main exposing (..)\n\nimport Cardano.Time as Time\nimport Cardano.Tx as Tx\nimport Cardano.Address as Address\nimport Cardano.Value as Value exposing (Value)\n\ncheckBool : Data -> bool\ncheckBool raw = let checked : Bool\n                    checked = validate raw\n                in lower checked\ncheckOption : Data -> option Int\ncheckOption raw = let checked : Option Int\n                      checked = validate raw\n                  in lower checked\ncheckCommittee raw = let checked : Tx.Committee\n                         checked = validate raw\n                     in toData checked\ncheckAddress raw = let checked : Address.Address\n                       checked = validate raw\n                   in toData checked\ncheckValue raw = let checked : Value\n                     checked = validate raw\n                 in toData checked\n\ncommittee = Tx.Committee (Builtin.mapData []) (Tx.Rational 2 3)\n\nbigStart : Int\nbigStart = lift (-10)\n\ntests\n    test \"closed interval builders accept Big endpoints\" = do\n        assert (Time.member bigStart (Time.interval bigStart 20))\n        assert (Time.member 20 (Time.interval bigStart 20))\n        assert (Bool.not (Time.member 21 (Time.interval bigStart 20)))\n        assert (Time.contains Time.always (Time.interval bigStart 20))\n        assert (Time.contains (Time.from bigStart) (Time.to -20) == False)\n        assert (Time.contains (Time.interval 0 1) Time.never)\n        assert (Time.isEmpty Time.never)\n        assert (Time.member -999 (Time.to 20))\n        assert (Time.member 999 (Time.from 20))\n    test \"committee validates rational tuple representation\" = do\n        assert (checkCommittee (toData committee) == toData committee)\n    test \"Bool invalid tag\" fail = do\n        let _ = checkBool (Builtin.constrData 2 []) in ()\n    test \"Bool extra field\" fail = do\n        let _ = checkBool (Builtin.constrData 0 [toData 1]) in ()\n    test \"Option missing field\" fail = do\n        let _ = checkOption (Builtin.constrData 0 []) in ()\n    test \"Option wrong element\" fail = do\n        let _ = checkOption (Builtin.constrData 0 [toData #\"aa\"]) in ()\n    test \"Option extra field\" fail = do\n        let _ = checkOption (Builtin.constrData 1 [toData 1]) in ()\n    test \"record rejects wrong tag\" fail = do\n        let _ = checkAddress (Builtin.constrData 1 [toData (Address.PubKeyCredential (lift #\"aa\")), Builtin.constrData 1 []]) in ()\n    test \"record rejects missing field\" fail = do\n        let _ = checkAddress (Builtin.constrData 0 []) in ()\n    test \"record rejects extra field\" fail = do\n        let _ = checkAddress (Builtin.constrData 0 [toData (Address.PubKeyCredential (lift #\"aa\")), Builtin.constrData 1 [], toData 1]) in ()\n    test \"record rejects invalid nested credential\" fail = do\n        let _ = checkAddress (Builtin.constrData 0 [Builtin.constrData 2 [], Builtin.constrData 1 []]) in ()\n    test \"Value rejects non-map\" fail = do\n        let _ = checkValue (toData 1) in ()\n"
