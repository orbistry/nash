---
source: crates/nash-driver/tests/base_traits.rs
description: "module Main exposing (..)\n\ntype count = Count int\n\nimpl ToData count where\n    toData (Count n) = toData n\n\nimpl FromData count where\n    fromData raw = Count (fromData raw)\n\nimpl Decode count where\n    decode raw = do\n        n <- decode raw\n        Some (Count n)\n\nasInt : Data -> option int\nasInt = decode\nasBytes : Data -> option bytes\nasBytes = decode\nasString : Data -> option string\nasString = decode\nasBool : Data -> option bool\nasBool = decode\nasUnit : Data -> option unit\nasUnit = decode\nasList : Data -> option (list int)\nasList = decode\nasBigList : Data -> option (List Int)\nasBigList = decode\nasMap : Data -> option (Map Int Bytes)\nasMap = decode\nasOption : Data -> option (option int)\nasOption = decode\nasBigOption : Data -> option (Option Int)\nasBigOption = decode\nasData : Data -> option Data\nasData = decode\nunchecked : Data -> Int\nunchecked = fromData\nchecked : Data -> Int\nchecked = validate\nlittle : Data -> int\nlittle = fromData\ntext : Data -> string\ntext = fromData\ncountValue : count\ncountValue = fromData (I 42)\ncountDecoded : option count\ncountDecoded = decode (I 42)\n\nentries = [Builtin.mkPairData (I 1) (B #\"aa\"), Builtin.mkPairData (I 1) (B #\"bb\")]\n\nnumber : int\nnumber = 42\nrawBytes : bytes\nrawBytes = #\"aaff\"\nyes : bool\nyes = True\nno : bool\nno = False\nnumbers : list int\nnumbers = [1, 2]\nbigOne : Int\nbigOne = 1\nfirstBytes : Bytes\nfirstBytes = #\"aa\"\nsecondBytes : Bytes\nsecondBytes = #\"bb\"\nthree : int\nthree = 3\n\nfromList : Data -> list int\nfromList = fromData\nfromOption : Data -> option int\nfromOption = fromData\nfromBool : Data -> bool\nfromBool = fromData\nfromUnit : Data -> unit\nfromUnit = fromData\nfromBytes : Data -> bytes\nfromBytes = fromData\nbigBool : Data -> option Bool\nbigBool = decode\n\ntests\n    test \"little list unpacking\" = do\n        assert (fromList (toData numbers) == numbers)\n    test \"little option unpacking\" = do\n        assert (fromOption (toData (Some number)) == Some number)\n    test \"little bool unpacking\" = do\n        assert (fromBool (toData yes) == yes)\n    test \"little unit unpacking\" = do\n        assert (fromUnit (toData ()) == ())\n    test \"little bytes unpacking\" = do\n        assert (fromBytes (toData rawBytes) == rawBytes)\n    test \"Big Bool optional decoding\" = do\n        assert (bigBool (toData yes) == Some Bool.True)\n    test \"Big Bool optional rejection\" = do\n        assert (bigBool (Builtin.constrData 0 [I 1]) == None)\n    test \"little string unpacking rejects bad UTF8\" fail = do\n        let _ = text (B #\"80\") in ()\n    test \"little scalar conversions 1\" = do\n        assert (toData number == I 42)\n    test \"little scalar conversions 2\" = do\n        assert (little (I 42) == 42)\n    test \"little scalar conversions 3\" = do\n        assert (asBytes (toData rawBytes) == Some #\"aaff\")\n    test \"little scalar conversions 4\" = do\n        assert (asString (toData \"é\") == Some \"é\")\n    test \"little scalar conversions 5\" = do\n        assert (text (toData \"é\") == \"é\")\n    test \"little scalar conversions 6\" = do\n        assert (asBool (toData yes) == Some True)\n    test \"little scalar conversions 7\" = do\n        assert (asBool (toData no) == Some False)\n    test \"little scalar conversions 8\" = do\n        assert (asUnit (toData ()) == Some ())\n    test \"user little conversions and ordinary option composition 1\" = do\n        assert (toData countValue == I 42)\n    test \"user little conversions and ordinary option composition 2\" = do\n        assert (case countDecoded of\n            Some (Count n) -> n == 42\n            None -> False)\n    test \"Big blanket conversion remains unchecked 1\" = do\n        assert (toData (unchecked (B #\"aa\")) == B #\"aa\")\n    test \"Big blanket conversion remains unchecked 2\" = do\n        assert (toData (checked (I 42)) == I 42)\n    test \"independent validation fails\" fail = do\n        let _ = checked (B #\"aa\") in ()\n    test \"little unpacking fails\" fail = do\n        let _ = little (B #\"aa\") in ()\n    test \"scalar decode wrong shapes 1\" = do\n        assert (asInt (B #\"aa\") == None)\n    test \"scalar decode wrong shapes 2\" = do\n        assert (asBytes (I 1) == None)\n    test \"scalar decode wrong shapes 3\" = do\n        assert (asString (I 1) == None)\n    test \"scalar decode wrong shapes 4\" = do\n        assert (asInt (List []) == None)\n    test \"scalar decode wrong shapes 5\" = do\n        assert (asInt (Map []) == None)\n    test \"scalar decode wrong shapes 6\" = do\n        assert (asInt (Builtin.constrData 0 []) == None)\n    test \"boolean and unit exact shape 1\" = do\n        assert (asBool (Builtin.constrData 2 []) == None)\n    test \"boolean and unit exact shape 2\" = do\n        assert (asBool (Builtin.constrData 0 [I 1]) == None)\n    test \"boolean and unit exact shape 3\" = do\n        assert (asBool (I 0) == None)\n    test \"boolean and unit exact shape 4\" = do\n        assert (asUnit (Builtin.constrData 1 []) == None)\n    test \"boolean and unit exact shape 5\" = do\n        assert (asUnit (Builtin.constrData 0 [I 1]) == None)\n    test \"UTF8 accepts boundaries 1\" = do\n        assert (asString (B #\"00c280e0a080eda080\") == None)\n    test \"UTF8 accepts boundaries 2\" = do\n        assert (asString (B #\"00c280e0a080ed9fbff0908080f48fbfbf\") /= None)\n    test \"UTF8 rejects malformed sequences 1\" = do\n        assert (asString (B #\"80\") == None)\n    test \"UTF8 rejects malformed sequences 2\" = do\n        assert (asString (B #\"c080\") == None)\n    test \"UTF8 rejects malformed sequences 3\" = do\n        assert (asString (B #\"c2\") == None)\n    test \"UTF8 rejects malformed sequences 4\" = do\n        assert (asString (B #\"e08080\") == None)\n    test \"UTF8 rejects malformed sequences 5\" = do\n        assert (asString (B #\"eda080\") == None)\n    test \"UTF8 rejects malformed sequences 6\" = do\n        assert (asString (B #\"f0808080\") == None)\n    test \"UTF8 rejects malformed sequences 7\" = do\n        assert (asString (B #\"f4908080\") == None)\n    test \"UTF8 rejects malformed sequences 8\" = do\n        assert (asString (B #\"f5808080\") == None)\n    test \"little collection conversion 1\" = do\n        assert (asList (toData numbers) == Some [1, 2])\n    test \"little collection conversion 2\" = do\n        assert (asList (List []) == Some [])\n    test \"little collection conversion 3\" = do\n        assert (asList (List [I 1, B #\"aa\"]) == None)\n    test \"little collection conversion 4\" = do\n        assert (asList (I 1) == None)\n    test \"Big collection decode validates children 1\" = do\n        assert (asBigList (List [I 1, I 2]) == Some (lift [1, 2]))\n    test \"Big collection decode validates children 2\" = do\n        assert (asBigList (List [B #\"aa\"]) == None)\n    test \"Big collection decode validates children 3\" = do\n        assert (asMap (Map entries) == Some (lift [Builtin.mkPairData bigOne firstBytes, Builtin.mkPairData bigOne secondBytes]))\n    test \"Big collection decode validates children 4\" = do\n        assert (asMap (Map [Builtin.mkPairData (B #\"aa\") (B #\"bb\")]) == None)\n    test \"Big collection decode validates children 5\" = do\n        assert (asMap (Map [Builtin.mkPairData (I 1) (I 2)]) == None)\n    test \"optional values exact shape 1\" = do\n        assert (asOption (toData (Some three)) == Some (Some 3))\n    test \"optional values exact shape 2\" = do\n        assert (asOption (Builtin.constrData 1 []) == Some None)\n    test \"optional values exact shape 3\" = do\n        assert (asOption (Builtin.constrData 0 []) == None)\n    test \"optional values exact shape 4\" = do\n        assert (asOption (Builtin.constrData 0 [B #\"aa\"]) == None)\n    test \"optional values exact shape 5\" = do\n        assert (asOption (Builtin.constrData 1 [I 1]) == None)\n    test \"optional values exact shape 6\" = do\n        assert (asBigOption (Builtin.constrData 0 [I 3]) == Some (Option.Some 3))\n    test \"optional values exact shape 7\" = do\n        assert (asBigOption (Builtin.constrData 0 [B #\"aa\"]) == None)\n    test \"Data decode preserves any shape 1\" = do\n        assert (asData (Map entries) == Some (Map entries))\n"
