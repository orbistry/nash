---
source: crates/nash-driver/tests/base_traits.rs
description: "module Main exposing (..)\n\nbig : Int\nbig = 48\nbigGcd : Int\nbigGcd = 6\nbigLcm : Int\nbigLcm = 144\n\ntests\n    test \"gcd mixed inputs\" = do\n        assert (Int.gcd big 18 == 6)\n    test \"gcd zero\" = do\n        assert (Int.gcd 0 0 == 0)\n    test \"gcd signs\" = do\n        assert (Int.gcd -48 -18 == 6)\n    test \"lcm mixed inputs\" = do\n        assert (Int.lcm 18 big == 144)\n    test \"lcm zero\" = do\n        assert (Int.lcm 0 0 == 0)\n    test \"lcm signs\" = do\n        assert (Int.lcm -48 18 == 144)\n    test \"sqrt zero\" = do\n        assert (Int.isqrt 0 == 0)\n    test \"sqrt one\" = do\n        assert (Int.isqrt 1 == 1)\n    test \"sqrt rounds down\" = do\n        assert (Int.isqrt big == 6)\n    test \"sqrt exact\" = do\n        assert (Int.isqrt 49 == 7)\n    test \"sqrt rejects negative\" fail = do\n        let _ = Int.isqrt -1 in ()\n    test \"oracle gcd 0\" = do\n        assert (Int.gcd (0) (0) == 0)\n    test \"oracle lcm 0\" = do\n        assert (Int.lcm (0) (0) == 0)\n    test \"oracle isGcd 0\" = do\n        assert (Int.isGcd (0) (0) 0)\n    test \"oracle isGcd rejects 0\" = do\n        assert (not (Int.isGcd (0) (0) 1))\n    test \"oracle isLcm 0\" = do\n        assert (Int.isLcm (0) (0) 0)\n    test \"oracle isLcm rejects 0\" = do\n        assert (not (Int.isLcm (0) (0) 1))\n    test \"oracle gcd 1\" = do\n        assert (Int.gcd (0) (-18) == 18)\n    test \"oracle lcm 1\" = do\n        assert (Int.lcm (0) (-18) == 0)\n    test \"oracle isGcd 1\" = do\n        assert (Int.isGcd (0) (-18) 18)\n    test \"oracle isGcd rejects 1\" = do\n        assert (not (Int.isGcd (0) (-18) 19))\n    test \"oracle isLcm 1\" = do\n        assert (Int.isLcm (0) (-18) 0)\n    test \"oracle isLcm rejects 1\" = do\n        assert (not (Int.isLcm (0) (-18) 1))\n    test \"oracle gcd 2\" = do\n        assert (Int.gcd (-48) (18) == 6)\n    test \"oracle lcm 2\" = do\n        assert (Int.lcm (-48) (18) == 144)\n    test \"oracle isGcd 2\" = do\n        assert (Int.isGcd (-48) (18) 6)\n    test \"oracle isGcd rejects 2\" = do\n        assert (not (Int.isGcd (-48) (18) 7))\n    test \"oracle isLcm 2\" = do\n        assert (Int.isLcm (-48) (18) 144)\n    test \"oracle isLcm rejects 2\" = do\n        assert (not (Int.isLcm (-48) (18) 145))\n    test \"oracle gcd 3\" = do\n        assert (Int.gcd (48) (-18) == 6)\n    test \"oracle lcm 3\" = do\n        assert (Int.lcm (48) (-18) == 144)\n    test \"oracle isGcd 3\" = do\n        assert (Int.isGcd (48) (-18) 6)\n    test \"oracle isGcd rejects 3\" = do\n        assert (not (Int.isGcd (48) (-18) 7))\n    test \"oracle isLcm 3\" = do\n        assert (Int.isLcm (48) (-18) 144)\n    test \"oracle isLcm rejects 3\" = do\n        assert (not (Int.isLcm (48) (-18) 145))\n    test \"oracle gcd 4\" = do\n        assert (Int.gcd (-48) (-18) == 6)\n    test \"oracle lcm 4\" = do\n        assert (Int.lcm (-48) (-18) == 144)\n    test \"oracle isGcd 4\" = do\n        assert (Int.isGcd (-48) (-18) 6)\n    test \"oracle isGcd rejects 4\" = do\n        assert (not (Int.isGcd (-48) (-18) 7))\n    test \"oracle isLcm 4\" = do\n        assert (Int.isLcm (-48) (-18) 144)\n    test \"oracle isLcm rejects 4\" = do\n        assert (not (Int.isLcm (-48) (-18) 145))\n    test \"oracle gcd 5\" = do\n        assert (Int.gcd (35) (64) == 1)\n    test \"oracle lcm 5\" = do\n        assert (Int.lcm (35) (64) == 2240)\n    test \"oracle isGcd 5\" = do\n        assert (Int.isGcd (35) (64) 1)\n    test \"oracle isGcd rejects 5\" = do\n        assert (not (Int.isGcd (35) (64) 2))\n    test \"oracle isLcm 5\" = do\n        assert (Int.isLcm (35) (64) 2240)\n    test \"oracle isLcm rejects 5\" = do\n        assert (not (Int.isLcm (35) (64) 2241))\n    test \"oracle gcd 6\" = do\n        assert (Int.gcd ((Int.fromBytes True #\"1500000000000000000000000000000015\")) ((Int.fromBytes True #\"2300000000000000000000000000000023\")) == (Int.fromBytes True #\"0700000000000000000000000000000007\"))\n    test \"oracle lcm 6\" = do\n        assert (Int.lcm ((Int.fromBytes True #\"1500000000000000000000000000000015\")) ((Int.fromBytes True #\"2300000000000000000000000000000023\")) == (Int.fromBytes True #\"6900000000000000000000000000000069\"))\n    test \"oracle isGcd 6\" = do\n        assert (Int.isGcd ((Int.fromBytes True #\"1500000000000000000000000000000015\")) ((Int.fromBytes True #\"2300000000000000000000000000000023\")) (Int.fromBytes True #\"0700000000000000000000000000000007\"))\n    test \"oracle isGcd rejects 6\" = do\n        assert (not (Int.isGcd ((Int.fromBytes True #\"1500000000000000000000000000000015\")) ((Int.fromBytes True #\"2300000000000000000000000000000023\")) (Int.fromBytes True #\"0700000000000000000000000000000008\")))\n    test \"oracle isLcm 6\" = do\n        assert (Int.isLcm ((Int.fromBytes True #\"1500000000000000000000000000000015\")) ((Int.fromBytes True #\"2300000000000000000000000000000023\")) (Int.fromBytes True #\"6900000000000000000000000000000069\"))\n    test \"oracle isLcm rejects 6\" = do\n        assert (not (Int.isLcm ((Int.fromBytes True #\"1500000000000000000000000000000015\")) ((Int.fromBytes True #\"2300000000000000000000000000000023\")) (Int.fromBytes True #\"690000000000000000000000000000006a\")))\n    test \"oracle sqrt 0\" = do\n        assert (Int.isqrt 0 == 0)\n    test \"oracle isSqrt 0\" = do\n        assert (Int.isSqrt 0 0)\n    test \"oracle isSqrt rejects 0\" = do\n        assert (not (Int.isSqrt 0 1))\n    test \"oracle sqrt 1\" = do\n        assert (Int.isqrt 1 == 1)\n    test \"oracle isSqrt 1\" = do\n        assert (Int.isSqrt 1 1)\n    test \"oracle isSqrt rejects 1\" = do\n        assert (not (Int.isSqrt 1 2))\n    test \"oracle sqrt 2\" = do\n        assert (Int.isqrt 2 == 1)\n    test \"oracle isSqrt 2\" = do\n        assert (Int.isSqrt 2 1)\n    test \"oracle isSqrt rejects 2\" = do\n        assert (not (Int.isSqrt 2 2))\n    test \"oracle sqrt 3\" = do\n        assert (Int.isqrt 3 == 1)\n    test \"oracle isSqrt 3\" = do\n        assert (Int.isSqrt 3 1)\n    test \"oracle isSqrt rejects 3\" = do\n        assert (not (Int.isSqrt 3 2))\n    test \"oracle sqrt 4\" = do\n        assert (Int.isqrt 4 == 2)\n    test \"oracle isSqrt 4\" = do\n        assert (Int.isSqrt 4 2)\n    test \"oracle isSqrt rejects 4\" = do\n        assert (not (Int.isSqrt 4 3))\n    test \"oracle sqrt 5\" = do\n        assert (Int.isqrt 15 == 3)\n    test \"oracle isSqrt 5\" = do\n        assert (Int.isSqrt 15 3)\n    test \"oracle isSqrt rejects 5\" = do\n        assert (not (Int.isSqrt 15 4))\n    test \"oracle sqrt 6\" = do\n        assert (Int.isqrt 16 == 4)\n    test \"oracle isSqrt 6\" = do\n        assert (Int.isSqrt 16 4)\n    test \"oracle isSqrt rejects 6\" = do\n        assert (not (Int.isSqrt 16 5))\n    test \"oracle sqrt 7\" = do\n        assert (Int.isqrt 17 == 4)\n    test \"oracle isSqrt 7\" = do\n        assert (Int.isSqrt 17 4)\n    test \"oracle isSqrt rejects 7\" = do\n        assert (not (Int.isSqrt 17 5))\n    test \"oracle sqrt 8\" = do\n        assert (Int.isqrt (Int.fromBytes True #\"0100000000000000020000000000000000\") == 18446744073709551616)\n    test \"oracle isSqrt 8\" = do\n        assert (Int.isSqrt (Int.fromBytes True #\"0100000000000000020000000000000000\") 18446744073709551616)\n    test \"oracle isSqrt rejects 8\" = do\n        assert (not (Int.isSqrt (Int.fromBytes True #\"0100000000000000020000000000000000\") 18446744073709551617))\n    test \"oracle sqrt 9\" = do\n        assert (Int.isqrt (Int.fromBytes True #\"0100000000000000020000000000000001\") == 18446744073709551617)\n    test \"oracle isSqrt 9\" = do\n        assert (Int.isSqrt (Int.fromBytes True #\"0100000000000000020000000000000001\") 18446744073709551617)\n    test \"oracle isSqrt rejects 9\" = do\n        assert (not (Int.isSqrt (Int.fromBytes True #\"0100000000000000020000000000000001\") 18446744073709551618))\n    test \"oracle sqrt 10\" = do\n        assert (Int.isqrt (Int.fromBytes True #\"0100000000000000020000000000000002\") == 18446744073709551617)\n    test \"oracle isSqrt 10\" = do\n        assert (Int.isSqrt (Int.fromBytes True #\"0100000000000000020000000000000002\") 18446744073709551617)\n    test \"oracle isSqrt rejects 10\" = do\n        assert (not (Int.isSqrt (Int.fromBytes True #\"0100000000000000020000000000000002\") 18446744073709551618))\n    test \"oracle sqrt 11\" = do\n        assert (Int.isqrt (Int.fromBytes True #\"0100000000000000040000000000000003\") == 18446744073709551617)\n    test \"oracle isSqrt 11\" = do\n        assert (Int.isSqrt (Int.fromBytes True #\"0100000000000000040000000000000003\") 18446744073709551617)\n    test \"oracle isSqrt rejects 11\" = do\n        assert (not (Int.isSqrt (Int.fromBytes True #\"0100000000000000040000000000000003\") 18446744073709551618))\n    test \"oracle sqrt 12\" = do\n        assert (Int.isqrt (Int.fromBytes True #\"01000000000000000000000000000000f600000000000000000000000000003b18\") == (Int.fromBytes True #\"010000000000000000000000000000007a\"))\n    test \"oracle isSqrt 12\" = do\n        assert (Int.isSqrt (Int.fromBytes True #\"01000000000000000000000000000000f600000000000000000000000000003b18\") (Int.fromBytes True #\"010000000000000000000000000000007a\"))\n    test \"oracle isSqrt rejects 12\" = do\n        assert (not (Int.isSqrt (Int.fromBytes True #\"01000000000000000000000000000000f600000000000000000000000000003b18\") (Int.fromBytes True #\"010000000000000000000000000000007b\")))\n    test \"oracle sqrt 13\" = do\n        assert (Int.isqrt (Int.fromBytes True #\"01000000000000000000000000000000f600000000000000000000000000003b19\") == (Int.fromBytes True #\"010000000000000000000000000000007b\"))\n    test \"oracle isSqrt 13\" = do\n        assert (Int.isSqrt (Int.fromBytes True #\"01000000000000000000000000000000f600000000000000000000000000003b19\") (Int.fromBytes True #\"010000000000000000000000000000007b\"))\n    test \"oracle isSqrt rejects 13\" = do\n        assert (not (Int.isSqrt (Int.fromBytes True #\"01000000000000000000000000000000f600000000000000000000000000003b19\") (Int.fromBytes True #\"010000000000000000000000000000007c\")))\n    test \"oracle sqrt 14\" = do\n        assert (Int.isqrt (Int.fromBytes True #\"01000000000000000000000000000000f600000000000000000000000000003b1a\") == (Int.fromBytes True #\"010000000000000000000000000000007b\"))\n    test \"oracle isSqrt 14\" = do\n        assert (Int.isSqrt (Int.fromBytes True #\"01000000000000000000000000000000f600000000000000000000000000003b1a\") (Int.fromBytes True #\"010000000000000000000000000000007b\"))\n    test \"oracle isSqrt rejects 14\" = do\n        assert (not (Int.isSqrt (Int.fromBytes True #\"01000000000000000000000000000000f600000000000000000000000000003b1a\") (Int.fromBytes True #\"010000000000000000000000000000007c\")))\n    test \"oracle sqrt 15\" = do\n        assert (Int.isqrt (Int.fromBytes True #\"01000000000000000000000000000000f800000000000000000000000000003c0f\") == (Int.fromBytes True #\"010000000000000000000000000000007b\"))\n    test \"oracle isSqrt 15\" = do\n        assert (Int.isSqrt (Int.fromBytes True #\"01000000000000000000000000000000f800000000000000000000000000003c0f\") (Int.fromBytes True #\"010000000000000000000000000000007b\"))\n    test \"oracle isSqrt rejects 15\" = do\n        assert (not (Int.isSqrt (Int.fromBytes True #\"01000000000000000000000000000000f800000000000000000000000000003c0f\") (Int.fromBytes True #\"010000000000000000000000000000007c\")))\n    test \"gcd negative expected\" = do\n        assert (not (Int.isGcd 12 18 -6))\n    test \"lcm negative expected\" = do\n        assert (not (Int.isLcm 12 18 -36))\n    test \"sqrt negative expected\" = do\n        assert (not (Int.isSqrt 4 -2))\n    test \"sqrt negative input\" = do\n        assert (not (Int.isSqrt -4 2))\n    test \"reject non-greatest common divisor\" = do\n        assert (not (Int.isGcd 12 18 3))\n    test \"reject non-least common multiple\" = do\n        assert (not (Int.isLcm 12 18 72))\n    test \"predicate mixed Big inputs\" = do\n        assert (Int.isGcd big 18 bigGcd && Int.isLcm big 18 bigLcm && Int.isSqrt big bigGcd)\n    test \"gcd predicate exhaustive small inputs\" = do\n        assert (List.all (\\a -> List.all (\\b -> List.all (\\g -> Int.isGcd a b g == (Int.gcd a b == g)) (List.range -1 6)) (List.range -3 4)) (List.range -3 4))\n    test \"lcm predicate exhaustive small inputs\" = do\n        assert (List.all (\\a -> List.all (\\b -> List.all (\\m -> Int.isLcm a b m == (Int.lcm a b == m)) (List.range -1 14)) (List.range -3 4)) (List.range -3 4))\n    test \"sqrt predicate exhaustive small inputs\" = do\n        assert (List.all (\\n -> List.all (\\r -> Int.isSqrt n r == (Int.isqrt n == r)) (List.range -1 12)) (List.range 0 101))\n"
