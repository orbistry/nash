---
source: crates/nash-driver/tests/base_traits.rs
description: "module Main exposing (..)\n\ntrait Kind 'a where\n    kind : 'a -> string\n\nimpl Kind ('a : Storable) where\n    kind _ = \"storable\"\n\ntype box 'a = Box 'a\n\nimpl Kind (box ('a : Big)) where\n    kind _ = \"big box\"\n\nimpl Kind 'a => Kind (box ('a : Little)) where\n    kind _ = \"little box\"\n\ntrait Kind 'a => Child 'a where\n    child : 'a -> string\n\nimpl Kind (box 'a) => Child (box 'a) where\n    child x = kind x\n\nviaBox : Kind 'a => 'a -> string\nviaBox x = kind (Box x)\n\nfromSuper : Child 't => 't -> string\nfromSuper x = kind x\n\nviaElement : Kind 'a => 'a -> string\nviaElement x = fromSuper (Box x)\n\nviaCaller : Kind 'a => 'a -> string\nviaCaller x = viaBox x\n\nsame : Eq 'a => list 'a -> list 'a -> bool\nsame xs ys = xs == ys\n\nbigValue : Int\nbigValue = 42\nlittleValue : int\nlittleValue = 42\n\ntests\n    test \"a split impl is selected for each use, big element first\" = do\n        assert (viaBox bigValue == \"big box\")\n        assert (viaBox littleValue == \"little box\")\n\n    test \"a split impl is selected for each use, little element first\" = do\n        assert (viaBox littleValue == \"little box\")\n        assert (viaBox bigValue == \"big box\")\n\n    test \"a superclass of a delayed context, big element first\" = do\n        assert (viaElement bigValue == \"big box\")\n        assert (viaElement littleValue == \"little box\")\n\n    test \"a superclass of a delayed context, little element first\" = do\n        assert (viaElement littleValue == \"little box\")\n        assert (viaElement bigValue == \"big box\")\n\n    test \"a generic caller passes the selecting type on, big element first\" = do\n        assert (viaCaller bigValue == \"big box\")\n        assert (viaCaller littleValue == \"little box\")\n\n    test \"a generic caller passes the selecting type on, little element first\" = do\n        assert (viaCaller littleValue == \"little box\")\n        assert (viaCaller bigValue == \"big box\")\n\n    test \"list equality under an element constraint\" = do\n        assert (same [bigValue] [bigValue])\n        assert (same [littleValue] [littleValue])\n        assert (not (same [littleValue] [littleValue, littleValue]))\n"
---
