source: crates/nash-driver/tests/cardano.rs
description: "validator module Context exposing (main)\n\nimport Cardano.Tx exposing (..)\nimport Cardano.Address exposing (..)\nimport Cardano.Time as Time\nimport Cardano.Value as Value exposing (Value)\n\ninteger : int -> Int\ninteger = lift\n\nbytes : bytes -> Bytes\nbytes = lift\n\nkey = PubKeyCredential (lift #\"6b6579\")\nscript = ScriptCredential (lift #\"736372697074\")\nref = OutputReference (lift #\"7478\") 2\nrep = DRep key\n\ncertificates : List Certificate\ncertificates = lift\n    [ RegStaking key Option.None\n    , UnRegStaking script (Option.Some 12)\n    , DelegStaking key (DelegStake (lift #\"706f6f6c\"))\n    , RegDeleg key (DelegVote DRepAlwaysAbstain) 13\n    , RegDRep key 14\n    , UpdateDRep script\n    , UnRegDRep key 15\n    , PoolRegister (lift #\"706f6f6c\") (lift #\"767266\")\n    , PoolRetire (lift #\"706f6f6c\") 16\n    , AuthHotCommittee key script\n    , ResignColdCommittee script\n    , DelegStaking key (DelegStakeVote (lift #\"706f6f6c\") rep)\n    , DelegStaking key (DelegVote DRepAlwaysNoConfidence)\n    ]\nactionId = GovernanceActionId (lift #\"70726576696f7573\") 3\n\nactions : list GovernanceAction\nactions =\n    [ ParameterChange Option.None (toData (Builtin.mapData (Map.singleton (integer 0) (integer 42)))) (Option.Some (lift #\"6775617264\"))\n    , HardForkInitiation (Option.Some actionId) (ProtocolVersion 11 0)\n    , TreasuryWithdrawals (lift (Map.singleton key (integer 17))) Option.None\n    , NoConfidence (Option.Some actionId)\n    , UpdateCommittee Option.None (lift [key]) (lift (Map.singleton script (integer 18))) (Rational 2 3)\n    , NewConstitution (Option.Some actionId) (Constitution Option.None)\n    , InfoAction\n    , NewConstitution Option.None (Constitution (Option.Some (lift #\"636f6e737469747574696f6e\")))\n    ]\nproposals : List Proposal\nproposals = lift (List.map (Proposal 19 key) actions)\nproposal = Proposal 19 key InfoAction\nvoters = [CommitteeVoter key, DRepVoter script, StakePoolVoter (lift #\"706f6f6c\")]\npurposes = [Minting (lift #\"706f6c696379\"), Spending ref, Rewarding key, Certifying 0 (RegStaking key Option.None), Voting (CommitteeVoter key), Proposing 6 proposal]\ninfos = [MintingScript (lift #\"706f6c696379\"), SpendingScript ref (Option.Some (toData (integer 99))), RewardingScript key, CertifyingScript 0 (RegStaking key Option.None), VotingScript (CommitteeVoter key), ProposingScript 6 proposal]\ncoin : Value\ncoin = lift (Value.singleton #\"\" #\"\" 100)\nmint : Value\nmint = lift (Value.singleton #\"706f6c696379\" #\"6173736574\" -2)\naddresses = [Address key Option.None, Address script (Option.Some (StakingHash key)), Address key (Option.Some (StakingPtr 20 21 22))]\ndatums = [NoDatum, DatumHash (lift #\"646174756d\"), InlineDatum (toData (integer 23))]\noutputs = List.map2 (\\address datum -> Output address coin datum (Option.Some (lift #\"7265662d736372697074\"))) addresses datums\nfirstOutput = Output (Address key Option.None) coin NoDatum (Option.Some (lift #\"7265662d736372697074\"))\nlastOutput = Output (Address key (Option.Some (StakingPtr 20 21 22))) coin (InlineDatum (toData (integer 23))) (Option.Some (lift #\"7265662d736372697074\"))\n\ntx = Tx\n    (lift [Input ref firstOutput])\n    (lift [Input (OutputReference (lift #\"7265666572656e6365\") 1) lastOutput])\n    (lift outputs)\n    2\n    mint\n    certificates\n    (lift (Map.singleton key (integer 24)))\n    (Time.Interval (Time.IntervalBound (Time.Finite 10) Bool.False) (Time.IntervalBound (Time.Finite 30) Bool.True))\n    (lift [lift #\"6b6579\"])\n    (lift (List.map (\\purpose -> Builtin.mkPairData purpose (toData (integer 25))) purposes))\n    (lift (Map.singleton (bytes #\"646174756d\") (toData (integer 23))))\n    (lift #\"7472616e73616374696f6e\")\n    (lift (List.map2 (\\voter vote -> Builtin.mkPairData voter (Builtin.mapData (Map.singleton actionId vote))) voters [VoteNo, VoteYes, Abstain]))\n    proposals\n    (Option.Some 26)\n    Option.None\n\nmain : Data -> unit\nmain packet =\n    case packet of\n        Constr pair(0, [raw, B encoded]) -> check raw encoded\n        _ -> fail\n\ncheck : Data -> bytes -> unit\ncheck raw encoded =\n    let\n        context : ScriptContext\n        context = validate raw\n        index = Data.tag (toData context.scriptInfo)\n        expected =\n            case context.scriptInfo of\n                SpendingScript _ Option.None ->\n                    ScriptContext\n                        { tx | currentTreasury = Option.None, treasuryDonation = (Option.Some 28), outputs = (lift [Output (Address key Option.None) coin NoDatum Option.None]) }\n                        (toData (integer 27))\n                        (SpendingScript ref Option.None)\n                _ -> ScriptContext tx (toData (integer 27)) (List.at index infos |> Option.unwrap)\n        _ = assert (context == expected)\n        _ = assert (decode raw == Some expected)\n        _ = assert (Data.serialise (toData expected) == encoded)\n        _ = assert (Value.lovelace (List.at 0 context.tx.outputs |> Option.unwrap).value == 100)\n        _ = assert (Value.quantityOf #\"706f6c696379\" #\"6173736574\" context.tx.mint == -2)\n        _ = assert (Time.member 11 context.tx.validityRange)\n        _ = assert (Bool.not (Time.member 10 context.tx.validityRange))\n    in\n    ()\n"
---
