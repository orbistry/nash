description: "module Main exposing (..)\n\nincrement x = x + 1\ndouble x = x * 2\nstrictAnd : bool -> bool\nstrictAnd = and False\n\nnamedAnd = and False (fail \"unselected outside assertion\")\nnamedOr = Bool.or True (fail \"unselected outside assertion\")\n\ntests\n    test \"helpers and composition\" = do\n        assert (identity 42 == 42)\n        assert (always 42 () == 42)\n        assert ((1 |> increment) == 2)\n        assert ((increment <| 1) == 2)\n        assert ((increment << double) 3 == 7)\n        assert ((increment >> double) 3 == 8)\n        assert (1 :: [2, 3] == [1, 2, 3])\n    test \"boolean helpers and lazy operators\" = do\n        assert (not namedAnd)\n        assert (namedOr)\n        assert (not False)\n        assert (xor True False)\n        assert (not (xor True True))\n        assert (not (False && (fail \"unselected and\")))\n        assert (True || (fail \"unselected or\"))\n        assert (not (and False (fail \"unselected named and\")))\n        assert (or True (fail \"unselected named or\"))\n        assert (not (Bool.and False (fail \"unselected qualified and\")))\n        assert (Bool.or True (fail \"unselected qualified or\"))\n        assert (and True True)\n        assert (not (or False False))\n    test \"trace result\" = do\n        assert ((trace \"value\" 42) == 42)\n    test \"trace precedes failure\" fail = do\n        (trace \"before\" (fail \"after\"))\n    test \"todo fails\" fail = do\n        (todo \"unfinished\")\n    test \"partial boolean application is strict\" fail = do\n        assert (strictAnd (fail \"strict argument\"))\n"
