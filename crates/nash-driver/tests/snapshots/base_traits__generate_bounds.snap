---
source: crates/nash-driver/tests/base_traits.rs
description: "module Main exposing (..)\n\nimport Cons\n\nzero : Int\nzero = 0\ntwo : Int\ntwo = 2\nfive : Int\nfive = 5\n\ndraw : Prop.generator 'a -> option 'a\ndraw generator =\n    case generator (Prop.Seeded #\"\" []) of\n        Some (value, _) -> Some value\n        None -> None\n\ncomposed : Prop.generator int\ncomposed state = do\n    (x, next) <- Prop.choice 10 state\n    (y, final) <- Prop.choice x next\n    Some (x + y, final)\n\nincrement x = x + 1\n\ncustom : Prop.generator int\ncustom state = Some (9, state)\n\nemptyGenerators : Cons.cons (Prop.generator int)\nemptyGenerators = Cons.Nil\n\ntests\n    test \"direct draws with option do\" = do\n        case composed (Prop.Replayed [4, 3, 9]) of\n            Some (value, Prop.Replayed rest) ->\n                assert (value == 7 && rest == [9])\n            _ -> fail\n        case composed (Prop.Replayed []) of\n            None -> ()\n            Some _ -> fail\n        case composed (Prop.Replayed [4]) of\n            None -> ()\n            Some _ -> fail\n        case composed (Prop.Replayed [4, 5]) of\n            None -> ()\n            Some _ -> fail\n        assert (draw custom == Some 9)\n    test \"function values survive draw tuples\" = do\n        case draw (Prop.constant increment) of\n            Some function -> assert (function 3 == 4)\n            None -> fail\n    test \"Nash preparation returns deferred functions\" = do\n        case Test.prepare custom (\\_ -> fail) (\\n -> [show n]) (Prop.Replayed []) of\n            Some (_, _, display) -> assert (display () == [\"9\"])\n            None -> fail\n    prop \"function alias generator\" =\n        let n via custom in\n        do\n            assert (n == 9)\n    test \"Big choice bound\" = do\n        assert (draw (Prop.choice zero) == Some 0)\n    test \"mixed integer bounds\" = do\n        assert (draw (Prop.intBetween five 5) == Some 5)\n        assert (draw (Prop.intBetween 5 five) == Some 5)\n    test \"mixed list bounds\" = do\n        assert (draw (Prop.listBetween two 2 (Prop.constant 7)) == Some [7, 7])\n        assert (draw (Prop.listBetween 2 two (Prop.constant 7)) == Some [7, 7])\n    test \"reversed bounds fail before drawing\" fail = do\n        case Prop.intBetween 2 1 of\n            _ -> ()\n    test \"empty alternatives fail before drawing\" fail = do\n        case Prop.oneOf emptyGenerators of\n            _ -> ()\n"
