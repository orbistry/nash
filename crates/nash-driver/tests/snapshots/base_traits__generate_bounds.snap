---
source: crates/nash-driver/tests/base_traits.rs
description: "module Main exposing (..)\n\nimport Cons\n\nzero : Int\nzero = 0\ntwo : Int\ntwo = 2\nfive : Int\nfive = 5\n\ndraw : Prop.generator 'a -> option 'a\ndraw generator =\n    case generator (Prop.Seeded #\"\" Cons.Nil) of\n        Some (value, _) -> Some value\n        None -> None\n\ncomposed : Prop.generator int\ncomposed state = do\n    (x, next) <- Prop.choice 10 state\n    (y, final) <- Prop.choice x next\n    Some (x + y, final)\n\nreplay values = Prop.Replayed (Cons.map Prop.Choice (Cons.fromList values)) Cons.Nil\n\nincrement x = x + 1\n\ncustom : Prop.generator int\ncustom state = Some (9, state)\n\nemptyGenerators : Cons.cons (Prop.generator int)\nemptyGenerators = Cons.Nil\n\ndependent : Prop.generator (int, int)\ndependent = do\n    count <- Prop.intBetween 1 10\n    index <- Prop.intBetween 0 (count - 1)\n    pure (count, index)\n\nmapped : Prop.generator int\nmapped = pure increment <*> (map (\\x -> x + 1) (Prop.constant 7))\n\ntests\n    test \"direct draws with option do\" = do\n        case composed (replay [4, 3, 9]) of\n            Some (value, Prop.Replayed (Cons.Cons (Prop.Choice 9) Cons.Nil) _) ->\n                assert (value == 7)\n            _ -> fail\n        case composed (replay []) of\n            None -> ()\n            Some _ -> fail\n        case composed (replay [4]) of\n            None -> ()\n            Some _ -> fail\n        case composed (replay [4, 5]) of\n            None -> ()\n            Some _ -> fail\n        assert (draw custom == Some 9)\n    test \"function values survive draw tuples\" = do\n        case draw (Prop.constant increment) of\n            Some function -> assert (function 3 == 4)\n            None -> fail\n        case draw (map (\\n -> \\x -> n + x) (Prop.constant 7)) of\n            Some function -> assert (function 3 == 10)\n            None -> fail\n    test \"Nash preparation returns deferred functions\" = do\n        case Test.prepare custom (\\_ -> fail) (\\n -> [show n]) (replay []) of\n            Some (_, _, display) -> assert (display () == [\"9\"])\n            None -> fail\n    prop \"function alias generator\" =\n        let n via custom in\n        do\n            assert (n == 9)\n    test \"Big choice bound\" = do\n        assert (draw (Prop.choice zero) == Some 0)\n    test \"mixed integer bounds\" = do\n        assert (draw (Prop.intBetween five 5) == Some 5)\n        assert (draw (Prop.intBetween 5 five) == Some 5)\n    test \"mixed list bounds\" = do\n        assert (draw (Prop.listBetween two 2 (Prop.constant 7)) == Some [7, 7])\n        assert (draw (Prop.listBetween 2 two (Prop.constant 7)) == Some [7, 7])\n    test \"reversed bounds fail before drawing\" fail = do\n        case Prop.intBetween 2 1 of\n            _ -> ()\n    test \"empty alternatives reject generation\" = do\n        case draw (Prop.oneOf emptyGenerators) of\n            None -> ()\n            Some _ -> fail\n\n    prop \"generator do preserves dependent bounds\" =\n        let (count, index) via dependent in\n        do\n            assert (count > index)\n    prop \"generator map and apply support functions\" =\n        let n via mapped in\n        do\n            assert (n == 9)\n    prop \"integer counterexample\" fail once =\n        let n via Prop.intBetween 10 100 in\n        do\n            assert (n < 20)\n    prop \"list counterexample\" fail once =\n        let values via Prop.listBetween 2 5 (Prop.intBetween 10 100) in\n        do\n            assert (List.length values < 2)\n    prop \"dependent counterexample\" fail once =\n        let (count, index) via dependent in\n        do\n            assert (index < count - 1)\n"
