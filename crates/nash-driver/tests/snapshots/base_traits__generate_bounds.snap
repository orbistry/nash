---
source: crates/nash-driver/tests/base_traits.rs
description: "module Main exposing (..)\n\nzero : Int\nzero = 0\ntwo : Int\ntwo = 2\nfive : Int\nfive = 5\n\ndraw : Prop.generator 'a -> option 'a\ndraw generator =\n    case Prop.run generator (Prop.Seeded #\"\" []) of\n        Some (value, _) -> Some value\n        None -> None\n\nincrement x = x + 1\n\ncomposed : Prop.generator int\ncomposed = do\n    x <- Prop.constant 2\n    y <- Prop.constant 3\n    pure (x + y)\n\ncustom : Prop.generator int\ncustom state = Some (9, state)\n\ntests\n    test \"generator alias traits\" = do\n        assert (draw (increment <$> Prop.constant 1) == Some 2)\n        assert (draw (Prop.constant increment <*> Prop.constant 2) == Some 3)\n        assert (draw composed == Some 5)\n        assert (draw custom == Some 9)\n    test \"function values survive draw tuples\" = do\n        case draw (Prop.constant increment) of\n            Some function -> assert (function 3 == 4)\n            None -> fail\n    test \"Nash preparation returns deferred functions\" = do\n        case Test.prepare custom (\\_ -> fail) (\\n -> [show n]) (Prop.Replayed []) of\n            Some (_, _, display) -> assert (display () == [\"9\"])\n            None -> fail\n    prop \"function alias generator\" =\n        let n via custom in\n        do\n            assert (n == 9)\n    test \"Big choice bound\" = do\n        assert (draw (Prop.choice zero) == Some 0)\n    test \"mixed integer bounds\" = do\n        assert (draw (Prop.intBetween five 5) == Some 5)\n        assert (draw (Prop.intBetween 5 five) == Some 5)\n    test \"mixed list bounds\" = do\n        assert (draw (Prop.listBetween two 2 (Prop.constant 7)) == Some [7, 7])\n        assert (draw (Prop.listBetween 2 two (Prop.constant 7)) == Some [7, 7])\n"
---
