source: crates/nash-driver/tests/base_traits.rs
description: "module Main exposing (..)\n\nimport Lift exposing (Lift)\n\ntype twins 'a 'b = Twins\n\ntrait Label 'a where\n    label : 'a -> string\n\nimpl Label (twins 'a 'a) where\n    label _ = \"same\"\n\nimpl Label (twins int bool) where\n    label _ = \"mixed\"\n\ntrait Label 'a => Named 'a where\n    name : 'a -> string\n\nimpl Named (twins 'a 'a) where\n    name _ = \"named\"\n\nviaSuper : Named 't => 't -> string\nviaSuper x = label x\n\npairLabel : twins 'p 'p -> string\npairLabel t = viaSuper t\n\nimpl Lift (twins 'a 'a) (twins int bool) where\n    lift _ = Twins\n    lower _ = Twins\n\ntrait Lift 'small 'big => Convert 'small 'big where\n    convert : 'small -> 'big\n\nimpl Convert (twins 'a 'a) (twins int bool) where\n    convert t = lift t\n\nviaLift : Convert 'small 'big => 'small -> 'big\nviaLift x = lift x\n\npairToMixed : twins 'p 'p -> twins int bool\npairToMixed t = viaLift t\n\ntests\n    test \"an open pair selects the impl that matches every pair\" = do\n        assert (pairLabel Twins == \"same\")\n\n    test \"an open pair lifts through an impl that reflexivity cannot decide\" = do\n        assert (label (pairToMixed Twins) == \"mixed\")\n"
---
an open pair selects the impl that matches every pair: Pass; traces: []
