description: "module Main exposing (..)\n\ntype Token = Token Int\nbigBool : Bool\nbigBool = lift True\nbigUnit : Unit\nbigUnit = lift ()\nbigOrder : Ordering\nbigOrder = lift LT\nbigOption : Option Int\nbigOption = lift (Some 42)\nbigNone : Option Int\nbigNone = lift littleNone\nbigResult : Result Bytes Int\nbigResult = lift littleOk\nbigError : Result Bytes Int\nbigError = lift littleErr\nsmallResult : result string int\nsmallResult = lower bigResult\nsmallError : result string int\nsmallError = lower bigError\nbigList : List Int\nbigList = lift [1, 2]\nsmallList : list int\nsmallList = lower bigList\nreflexiveList : List Int\nreflexiveList = lift [Builtin.iData 1, Builtin.iData 2]\nnested : List (List Int)\nnested = lift [[1], [2]]\nsmallNested : list (list int)\nsmallNested = lower nested\nentries : list (pair Int Bytes)\nentries = [Builtin.mkPairData (Builtin.iData 1) (Builtin.bData #\"aa\")]\nbigMap : Map Int Bytes\nbigMap = lift entries\nroundTripMap : list (pair Int Bytes)\nroundTripMap = lower bigMap\nutf8 : Bytes\nutf8 = lift \"é\"\ntext : string\ntext = lower utf8\nplainBytes : bytes\nplainBytes = lower utf8\nrestored : Token\nrestored = fromData (toData (Token 7))\ncheckedInt : Int\ncheckedInt = validate (I 42)\ncheckedBytes : Bytes\ncheckedBytes = validate (B #\"aa\")\ncheckedList : List Int\ncheckedList = validate (List [I 1, I 2])\ncheckedMap : Map Int Bytes\ncheckedMap = validate (Map [Builtin.mkPairData (I 1) (B #\"aa\")])\ncheckInt : Data -> Int\ncheckInt = validate\ncheckList : Data -> List Int\ncheckList = validate\ncheckMap : Data -> Map Int Bytes\ncheckMap = validate\n\nlittleNone : option int\nlittleNone = None\nexpectedNone : Option Int\nexpectedNone = Option.None\nlittleOk : result string int\nlittleOk = Ok 42\nlittleErr : result string int\nlittleErr = Err \"bad\"\n\ntests\n    test \"primitive and twin lift\" = do\n        assert (Builtin.unIData (lift 42) == 42)\n        assert (text == \"é\" && plainBytes == #\"c3a9\")\n        assert (bigBool == Bool.True)\n        assert (lower bigBool == True)\n        assert (lower bigUnit == ())\n        assert (lower bigOrder == LT)\n        assert (bigOption == Option.Some (Builtin.iData 42))\n        assert (lower bigOption == Some 42)\n        assert (bigNone == expectedNone)\n        assert (smallResult == Ok 42)\n        assert (smallError == Err \"bad\")\n    test \"container lift and reflexive Big lift\" = do\n        assert (smallList == [1, 2])\n        assert (bigList == reflexiveList)\n        assert (smallNested == [[1], [2]])\n        assert (roundTripMap == entries)\n        assert (lift (Token 7) == Token 7)\n    test \"Data conversions and validation\" = do\n        assert (restored == Token 7)\n        assert (Builtin.unIData checkedInt == 42)\n        assert (Builtin.unBData checkedBytes == #\"aa\")\n        assert (checkedList == bigList)\n        assert (checkedMap == bigMap)\n        assert (validate (I 1) == I 1)\n    test \"reject malformed scalar\" fail = do\n        assert (checkInt (B #\"aa\") == checkedInt)\n    test \"reject malformed list element\" fail = do\n        assert (checkList (List [B #\"aa\"]) == checkedList)\n    test \"reject malformed map value\" fail = do\n        assert (checkMap (Map [Builtin.mkPairData (I 1) (I 2)]) == checkedMap)\n"
