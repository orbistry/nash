---
source: crates/nash-driver/tests/base_traits.rs
description: "module Main exposing (..)\n\nbig : List Int\nbig = lift items\nitems : list Int\nitems = [1, 2, 3]\nempty : list int\nempty = []\nnone : option int\nnone = None\nnested : List (List Int)\nnested = lift [big, big]\n\nbadBool : unit -> bool\nbadBool _ = fail\n\ntests\n    test \"construction and count boundaries\" = do\n        assert (List.singleton 3 == [3])\n        assert (List.repeat 3 7 == [7, 7, 7])\n        assert (List.repeat (-1) 7 == [])\n        assert (List.range 2 5 == [2, 3, 4])\n    test \"construction and count boundaries 2\" = do\n        assert (List.range 5 2 == [])\n        assert (List.range 2 2 == [])\n    test \"Big and little inputs preserve elements\" = do\n        assert (List.reverse big == [3, 2, 1])\n        assert (List.reverse items == [3, 2, 1])\n        assert (List.append items big == [1, 2, 3, 1, 2, 3])\n        assert (List.append big items == [1, 2, 3, 1, 2, 3])\n    test \"Big and little inputs preserve elements 2\" = do\n        assert (List.concat nested == [1, 2, 3, 1, 2, 3])\n        assert (List.map Builtin.unIData big == [1, 2, 3])\n        assert (List.map Builtin.iData [1, 2, 3] == items)\n        assert (List.indexedMap (\\i x -> i + x) [10, 10] == [10, 11])\n    test \"Big and little inputs preserve elements 3\" = do\n        assert (List.length big == 3)\n        assert (List.head big == Some (Builtin.iData 1))\n        assert (List.tail big == Some [Builtin.iData 2, Builtin.iData 3])\n    test \"empty access\" = do\n        assert (List.head empty == none)\n        assert (List.tail empty == None)\n        assert (List.isEmpty empty)\n        assert (List.length empty == 0)\n    test \"empty access 2\" = do\n        assert (List.at 0 empty == none)\n        assert (List.at (-1) [1] == none)\n        assert (List.at 3 [1, 2, 3] == none)\n        assert (List.at 1 [1, 2, 3] == Some 2)\n    test \"slicing\" = do\n        assert (List.take 2 big == [1, 2])\n        assert (List.drop 2 big == [3])\n        assert (List.take (-1) [1, 2] == [])\n        assert (List.drop (-1) [1, 2] == [1, 2])\n    test \"slicing 2\" = do\n        assert (List.take 9 [1, 2] == [1, 2])\n        assert (List.drop 9 [1, 2] == [])\n    test \"folds filtering and search\" = do\n        assert (List.foldl (\\x acc -> x - acc) 0 [1, 2] == 1)\n        assert (List.foldr (\\x acc -> x - acc) 0 [1, 2] == -1)\n        assert (List.filter (\\x -> x > 1) [1, 2, 3] == [2, 3])\n        assert (List.filterMap (\\x -> if x > 1 then Some (x + 1) else None) [1, 2, 3] == [3, 4])\n    test \"folds filtering and search 2\" = do\n        assert (List.any (\\x -> x == 2) [1, 2, 3])\n        assert (List.all (\\x -> x > 0) [1, 2, 3])\n        assert (List.any (\\x -> if x == 1 then True else badBool ()) [1, 2])\n        assert (not (List.all (\\x -> if x == 1 then False else badBool ()) [1, 2]))\n    test \"folds filtering and search 3\" = do\n        assert (List.all (\\_ -> badBool ()) empty)\n        assert (not (List.any (\\_ -> badBool ()) empty))\n        assert (List.find (\\x -> x > 1) [1, 2, 3] == Some 2)\n        assert (List.member 2 [1, 2, 3])\n    test \"folds filtering and search 4\" = do\n        assert (List.partition (\\x -> x > 1) [1, 2, 3] == ([2, 3], [1]))\n        assert (List.sum [1, 2, 3] == 6)\n    test \"map2 truncates and sort is stable\" = do\n        assert (List.map2 (\\x y -> x + y) items big == [2, 4, 6])\n        assert (List.map2 (\\x y -> x + y) [1, 2] [10] == [11])\n        assert (List.sort [3, 1, 2, 1] == [1, 1, 2, 3])\n        assert (List.sortBy (\\a b -> compare (rem a 10) (rem b 10)) [21, 12, 11, 22] == [21, 11, 12, 22])\n    test \"map2 truncates and sort is stable 2\" = do\n        assert (Array.at (List.toArray big) 1 == Builtin.iData 2)\n        assert (Array.at (Array.fromList big) 1 == Builtin.iData 2)\n        assert (Cons.toList (Cons.fromList big) == items)\n    test \"Big control results and little sum\" = do\n        assert (List.filter (\\_ -> Bool.True) big == items)\n        assert (List.filterMap (\\x -> Option.Some x) big == items)\n        assert (List.any (\\_ -> Bool.True) big)\n        assert (List.all (\\_ -> Bool.True) big)\n    test \"Big comparison and selection\" = do\n        assert (List.sortBy (\\_ _ -> Ordering.EQ) big == items)\n        assert (List.find (\\_ -> Bool.True) big == Some (Builtin.iData 1))\n        assert (List.partition (\\_ -> Bool.True) big == (items, []))\n        assert (Builtin.equalsInteger (List.sum big) 6)\n    test \"isLength empty and zero\" = do\n        assert (List.isLength empty 0)\n        assert (not (List.isLength empty 1))\n        assert (not (List.isLength [1] 0))\n        assert (not (List.isLength empty (-1)))\n    test \"isLength boundaries\" = do\n        assert (List.isLength [1] 1)\n        assert (List.isLength items 3)\n        assert (not (List.isLength items 2))\n        assert (not (List.isLength items 4))\n    test \"isLength Big inputs and negative counts\" = do\n        assert (List.isLength big (Builtin.iData 3))\n        assert (List.isLength items (Builtin.iData 3))\n        assert (List.isLength big 3)\n        assert (not (List.isLength items (-1)))\n"
