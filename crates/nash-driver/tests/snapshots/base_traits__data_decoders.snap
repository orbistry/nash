---
source: crates/nash-driver/tests/base_traits.rs
description: "module Main exposing (..)\n\nimport Data.Decode as Decode\nimport Data.Encode as Encode\nimport Cons exposing (type cons(..))\n\nrecord : Decode.decoder (int, bytes)\nrecord = Decode.constr 7 <| do\n    first <- Decode.field 0 Decode.int\n    second <- Decode.field 1 Decode.bytes\n    pure (first, second)\n\napplied : Decode.decoder int\napplied = pure (\\a b -> a + b) <*> Decode.field 0 Decode.int <*> Decode.field 1 Decode.int\n\nconstant : Decode.decoder int\nconstant = pure 42\n\nemptyAlternatives : Decode.decoder int\nemptyAlternatives = Decode.oneOf Nil\n\nbad : Decode.decoder int\nbad _ = fail\n\nfunction : Decode.decoder (int -> int)\nfunction = map (\\n -> \\x -> n + x) Decode.int\n\nemptyPairs : cons (int, int)\nemptyPairs = Nil\n\nencoded = Encode.constr 7 [Encode.int 42, Encode.bytes #\"ff\"]\n\nbigInt : Int\nbigInt = 42\nbigBytes : Bytes\nbigBytes = lift #\"ff\"\nbigBool : Bool\nbigBool = True\nbigList : List Int\nbigList = lift [bigInt]\nbigFields : List Data\nbigFields = lift [Encode.int bigInt]\nrejected : Decode.decoder int\nrejected = Decode.reject\nrejectBind : Decode.decoder int\nrejectBind = do\n    _ <- rejected\n    bad\nrejectApply : Decode.decoder int\nrejectApply = pure (\\a b -> a + b) <*> rejected <*> bad\n\ntests\n    test \"implicit qualified decoder modules\" = do\n        assert (Data.Decode.run Data.Decode.int (Data.Encode.int 5) == Some 5)\n    test \"bind rejection skips continuation\" = do\n        assert (Decode.run rejectBind encoded == None)\n    test \"applicative rejection skips argument\" = do\n        assert (Decode.run rejectApply encoded == None)\n    test \"empty map decoding\" = do\n        assert (Decode.run (Decode.map Decode.int Decode.int) (Encode.map Encode.int Encode.int emptyPairs) == Some Nil)\n    test \"map key failure\" = do\n        assert (Decode.run (Decode.map Decode.bytes Decode.int) (Encode.map Encode.int Encode.int (Cons (1, 2) Nil)) == None)\n    test \"extra constructor fields accepted\" = do\n        assert (Decode.run record (Encode.constr 7 [Encode.int 42, Encode.bytes #\"ff\", Encode.int 9]) == Some (42, #\"ff\"))\n    test \"Big int encoding\" = do\n        assert (Decode.run Decode.int (Encode.int bigInt) == Some 42)\n    test \"Big bytes encoding\" = do\n        assert (Decode.run Decode.bytes (Encode.bytes bigBytes) == Some #\"ff\")\n    test \"Big bool encoding\" = do\n        assert (Decode.run Decode.bool (Encode.bool bigBool) == Some True)\n    test \"Big list encoding\" = do\n        assert (Decode.run (Decode.list Decode.int) (Encode.list Encode.int bigList) == Some [42])\n    test \"Big constructor inputs\" = do\n        assert (Data.tag (Encode.constr bigInt bigFields) == 42)\n    test \"primitive decoding and wrong shapes 1\" = do\n        assert (Decode.run Decode.int (Encode.int -42) == Some -42)\n    test \"primitive decoding and wrong shapes 2\" = do\n        assert (Decode.run Decode.bytes (Encode.bytes #\"00ff\") == Some #\"00ff\")\n    test \"primitive decoding and wrong shapes 3\" = do\n        assert (Decode.run Decode.data encoded == Some encoded)\n    test \"primitive decoding and wrong shapes 4\" = do\n        assert (Decode.run Decode.int (Encode.bytes #\"\") == None)\n    test \"primitive decoding and wrong shapes 5\" = do\n        assert (Decode.run Decode.bytes (Encode.int 1) == None)\n    test \"primitive decoding and wrong shapes 6\" = do\n        assert (Decode.run Decode.int (Encode.list Encode.int [1]) == None)\n    test \"primitive decoding and wrong shapes 7\" = do\n        assert (Decode.run Decode.int (Encode.map Encode.int Encode.int emptyPairs) == None)\n    test \"primitive decoding and wrong shapes 8\" = do\n        assert (Decode.run Decode.int encoded == None)\n    test \"primitive decoding and wrong shapes 9\" = do\n        assert (Decode.run Decode.string (Encode.int 1) == None)\n    test \"booleans require exact constructor shape 1\" = do\n        assert (Decode.run Decode.bool (Encode.bool True) == Some True)\n    test \"booleans require exact constructor shape 2\" = do\n        assert (Decode.run Decode.bool (Encode.bool False) == Some False)\n    test \"booleans require exact constructor shape 3\" = do\n        assert (Decode.run Decode.bool (Encode.constr 2 []) == None)\n    test \"booleans require exact constructor shape 4\" = do\n        assert (Decode.run Decode.bool (Encode.constr 0 [Encode.int 1]) == None)\n    test \"booleans require exact constructor shape 5\" = do\n        assert (Decode.run Decode.bool (Encode.constr 1 [Encode.int 1]) == None)\n    test \"booleans require exact constructor shape 6\" = do\n        assert (Decode.run Decode.bool (Encode.int 1) == None)\n    test \"UTF8 accepts empty\" = do\n        assert (Option.isSome (Decode.run Decode.string (Encode.bytes #\"\")))\n    test \"UTF8 accepts 00\" = do\n        assert (Option.isSome (Decode.run Decode.string (Encode.bytes #\"00\")))\n    test \"UTF8 accepts 7f\" = do\n        assert (Option.isSome (Decode.run Decode.string (Encode.bytes #\"7f\")))\n    test \"UTF8 accepts c280\" = do\n        assert (Option.isSome (Decode.run Decode.string (Encode.bytes #\"c280\")))\n    test \"UTF8 accepts dfbf\" = do\n        assert (Option.isSome (Decode.run Decode.string (Encode.bytes #\"dfbf\")))\n    test \"UTF8 accepts e0a080\" = do\n        assert (Option.isSome (Decode.run Decode.string (Encode.bytes #\"e0a080\")))\n    test \"UTF8 accepts ed9fbf\" = do\n        assert (Option.isSome (Decode.run Decode.string (Encode.bytes #\"ed9fbf\")))\n    test \"UTF8 accepts ee8080\" = do\n        assert (Option.isSome (Decode.run Decode.string (Encode.bytes #\"ee8080\")))\n    test \"UTF8 accepts efbfbf\" = do\n        assert (Option.isSome (Decode.run Decode.string (Encode.bytes #\"efbfbf\")))\n    test \"UTF8 accepts f0908080\" = do\n        assert (Option.isSome (Decode.run Decode.string (Encode.bytes #\"f0908080\")))\n    test \"UTF8 accepts f48fbfbf\" = do\n        assert (Option.isSome (Decode.run Decode.string (Encode.bytes #\"f48fbfbf\")))\n    test \"UTF8 accepts 61c28062\" = do\n        assert (Option.isSome (Decode.run Decode.string (Encode.bytes #\"61c28062\")))\n    test \"UTF8 accepts e18080\" = do\n        assert (Option.isSome (Decode.run Decode.string (Encode.bytes #\"e18080\")))\n    test \"UTF8 accepts ecbfbf\" = do\n        assert (Option.isSome (Decode.run Decode.string (Encode.bytes #\"ecbfbf\")))\n    test \"UTF8 accepts f1808080\" = do\n        assert (Option.isSome (Decode.run Decode.string (Encode.bytes #\"f1808080\")))\n    test \"UTF8 accepts f3bfbfbf\" = do\n        assert (Option.isSome (Decode.run Decode.string (Encode.bytes #\"f3bfbfbf\")))\n    test \"UTF8 rejects 80\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"80\") == None)\n    test \"UTF8 rejects bf\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"bf\") == None)\n    test \"UTF8 rejects c080\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"c080\") == None)\n    test \"UTF8 rejects c1bf\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"c1bf\") == None)\n    test \"UTF8 rejects e09fbf\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"e09fbf\") == None)\n    test \"UTF8 rejects eda080\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"eda080\") == None)\n    test \"UTF8 rejects f08fbfbf\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"f08fbfbf\") == None)\n    test \"UTF8 rejects f4908080\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"f4908080\") == None)\n    test \"UTF8 rejects f5808080\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"f5808080\") == None)\n    test \"UTF8 rejects ff\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"ff\") == None)\n    test \"UTF8 rejects c2\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"c2\") == None)\n    test \"UTF8 rejects e0\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"e0\") == None)\n    test \"UTF8 rejects e0a0\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"e0a0\") == None)\n    test \"UTF8 rejects f0\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"f0\") == None)\n    test \"UTF8 rejects f090\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"f090\") == None)\n    test \"UTF8 rejects f09080\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"f09080\") == None)\n    test \"UTF8 rejects c27f\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"c27f\") == None)\n    test \"UTF8 rejects c2c0\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"c2c0\") == None)\n    test \"UTF8 rejects e0a07f\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"e0a07f\") == None)\n    test \"UTF8 rejects f090807f\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"f090807f\") == None)\n    test \"UTF8 rejects 61ff\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"61ff\") == None)\n    test \"UTF8 rejects e0a0c0\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"e0a0c0\") == None)\n    test \"UTF8 rejects f09080c0\" = do\n        assert (Decode.run Decode.string (Encode.bytes #\"f09080c0\") == None)\n    test \"UTF8 text roundtrip\" = do\n        assert (Decode.run Decode.string (Encode.string \"hello λ 😀\") == Some \"hello λ 😀\")\n    test \"constructor decoder do\" = do\n        assert (Decode.run record encoded == Some (42, #\"ff\"))\n    test \"constructor wrong tag\" = do\n        assert (Decode.run record (Encode.constr 8 []) == None)\n    test \"constructor wrong shape\" = do\n        assert (Decode.run record (Encode.int 7) == None)\n    test \"negative field index\" = do\n        assert (Decode.run (Decode.field -1 Decode.int) encoded == None)\n    test \"missing field\" = do\n        assert (Decode.run (Decode.field 2 Decode.int) encoded == None)\n    test \"field on nonconstructor\" = do\n        assert (Decode.run (Decode.field 0 Decode.int) (Encode.int 0) == None)\n    test \"direct tag\" = do\n        assert (Data.tag encoded == 7)\n    test \"direct fields\" = do\n        assert (Data.fields encoded == [Encode.int 42, Encode.bytes #\"ff\"])\n    test \"applicative and bind share original input 1\" = do\n        assert (Decode.run applied (Encode.constr 0 [Encode.int 2, Encode.int 3]) == Some 5)\n    test \"applicative and bind share original input 2\" = do\n        assert (Decode.run constant encoded == Some 42)\n    test \"applicative and bind share original input 3\" = do\n        assert (Decode.run (Decode.oneOf (Cons Decode.reject (Cons Decode.int (Cons bad Nil)))) (Encode.int 5) == Some 5)\n    test \"applicative and bind share original input 4\" = do\n        assert (Decode.run emptyAlternatives encoded == None)\n    test \"applicative and bind share original input 5\" = do\n        assert (Decode.run (Decode.oneOf (Cons Decode.int Nil)) encoded == None)\n    test \"list decoding\" = do\n        assert (Decode.run (Decode.list Decode.int) (Encode.list Encode.int [1, 2, 3]) == Some [1, 2, 3])\n    test \"empty list decoding\" = do\n        assert (Decode.run (Decode.list Decode.int) (Encode.list identity []) == Some [])\n    test \"list item failure\" = do\n        assert (Decode.run (Decode.list Decode.int) (Encode.list identity [Encode.int 1, Encode.bytes #\"\", Encode.int 3]) == None)\n    test \"list wrong shape\" = do\n        assert (Decode.run (Decode.list Decode.int) (Encode.int 1) == None)\n    test \"map order and duplicates\" = do\n        assert (Decode.run (Decode.map Decode.int Decode.bytes) (Encode.map Encode.int Encode.bytes (Cons (1, #\"aa\") (Cons (1, #\"bb\") Nil))) == Some (Cons (1, #\"aa\") (Cons (1, #\"bb\") Nil)))\n    test \"map value failure\" = do\n        assert (Decode.run (Decode.map Decode.int Decode.bytes) (Encode.map Encode.int Encode.int (Cons (1, 2) Nil)) == None)\n    test \"map wrong shape\" = do\n        assert (Decode.run (Decode.map Decode.int Decode.bytes) (Encode.int 1) == None)\n    test \"decoded maps can contain functions\" = do\n        case Decode.run (Decode.map Decode.int function) (Encode.map Encode.int Encode.int (Cons (1, 7) Nil)) of\n            Some (Cons (key, f) Nil) -> assert (key == 1 && f 3 == 10)\n            _ -> fail\n    test \"tag expects constructor\" fail = do\n        let _ = Data.tag (Encode.int 1) in ()\n    test \"fields expects constructor\" fail = do\n        let _ = Data.fields (Encode.bytes #\"\") in ()\n    prop \"integer roundtrip\" =\n        let value via Prop.int in\n        do\n            assert (Decode.run Decode.int (Encode.int value) == Some value)\n    prop \"bytes roundtrip\" =\n        let value via Prop.bytes in\n        do\n            assert (Decode.run Decode.bytes (Encode.bytes value) == Some value)\n    prop \"integer list roundtrip\" =\n        let values via Prop.listBetween 0 10 Prop.int in\n        do\n            assert (Decode.run (Decode.list Decode.int) (Encode.list Encode.int values) == Some values)\n"
---
