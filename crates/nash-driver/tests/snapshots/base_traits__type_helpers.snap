---
source: crates/nash-driver/tests/base_traits.rs
description: "module Main exposing (..)\n\nbigInt : Int\nbigInt = 7\nbigBytes : Bytes\nbigBytes = #\"abcd\"\nbigIndices : List Int\nbigIndices = lift [Builtin.iData 0, Builtin.iData 8]\nbigOption : Option Int\nbigOption = Option.Some 7\nlittleOption : option Int\nlittleOption = Some 7\nnone : option int\nnone = None\nboth : (Lift bool 'a, Lift bool 'b) => 'a -> 'b -> bool\nboth a b = Bool.and a b\nbadBig : unit -> Bool\nbadBig _ = fail\n\ntests\n    test \"mixed booleans and ordering\" = do\n        assert (Bool.and Bool.True True)\n        assert (Bool.or False Bool.True)\n        assert (not (Bool.xor Bool.True True))\n        assert (not (Bool.not Bool.True))\n    test \"mixed booleans and ordering 2\" = do\n        assert (Bool.or Bool.True (badBig ()))\n        assert (not (Bool.and False (badBig ())))\n        assert (Bool.True || badBig ())\n        assert (both Bool.True True)\n    test \"mixed booleans and ordering 3\" = do\n        assert (Ordering.invert Ordering.LT == GT)\n        assert (Ordering.then_ EQ Ordering.GT == GT)\n    test \"integer helpers\" = do\n        assert (Int.abs (-7) == 7)\n        assert (Int.abs bigInt == 7)\n        assert (Int.pow 2 10 == 1024)\n        assert (Int.pow bigInt 0 == 1)\n    test \"exact powers of two across byte boundaries\" = do\n        assert (Int.pow2 0 == 1)\n        assert (Int.pow2 bigInt == 128)\n        assert (Int.pow2 8 == 256)\n        assert (Int.pow2 9 == 512)\n        assert (Int.pow2 64 == 18446744073709551616)\n        assert (Int.pow2 128 == 18446744073709551616 * 18446744073709551616)\n        assert (Int.pow 2 128 == Int.pow2 128)\n        assert (Int.pow (-2) 9 == -512)\n        assert (Int.pow 3 5 == 243)\n        assert (Int.pow 0 0 == 1)\n    test \"negative power of two exponent\" fail = do\n        assert (Int.pow2 (-1) == 0)\n    test \"integer helpers 2\" = do\n        assert (Int.powMod 2 10 7 == 2)\n        assert (Int.toBytes True 2 bigInt == #\"0007\")\n        assert (Int.fromBytes False bigBytes == 52651)\n        assert (Int.toString bigInt == \"7\")\n    test \"negative exponent\" fail = do\n        assert (Int.pow 2 (-1) == 0)\n    test \"negative integer encoding\" fail = do\n        assert (Int.toBytes True 0 (-1) == #\"\")\n    test \"byte access and slicing\" = do\n        assert (Bytes.length bigBytes == 2)\n        assert (Bytes.at bigBytes 1 == 205)\n        assert (Bytes.slice 1 1 bigBytes == #\"cd\")\n        assert (Bytes.take 1 bigBytes == #\"ab\")\n    test \"byte access and slicing 2\" = do\n        assert (Bytes.drop 1 bigBytes == #\"cd\")\n        assert (Bytes.drop (-1) bigBytes == #\"abcd\")\n        assert (Bytes.take (-1) bigBytes == #\"\")\n        assert (Bytes.toHex bigBytes == \"abcd\")\n    test \"byte access and slicing 3\" = do\n        assert (Bytes.concat [bigBytes, bigBytes] == #\"abcdabcd\")\n    test \"byte logic\" = do\n        assert (Bytes.and False bigBytes #\"ff00\" == #\"ab00\")\n        assert (Bytes.or False bigBytes #\"00ff\" == #\"abff\")\n        assert (Bytes.xor False bigBytes #\"ffff\" == #\"5432\")\n        assert (Bytes.complement bigBytes == #\"5432\")\n    test \"byte logic 2\" = do\n        assert (Bytes.readBit #\"01\" 0)\n        assert (Bytes.writeBits #\"0000\" bigIndices True == #\"0101\")\n        assert (Bytes.shift #\"01\" 1 == #\"02\")\n        assert (Bytes.rotate #\"80\" 1 == #\"01\")\n    test \"byte logic 3\" = do\n        assert (Bytes.countSetBits bigBytes == 10)\n        assert (Bytes.findFirstSetBit #\"08\" == 3)\n        assert (Bytes.findFirstSetBit #\"00\" == -1)\n    test \"hashes\" = do\n        assert (Bytes.sha2_256 #\"\" == #\"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\")\n        assert (Bytes.sha3_256 #\"\" == #\"a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a\")\n        assert (Bytes.blake2b_256 #\"\" == #\"0e5751c026e543b2e8ab2eb06099daa1d1e5df47778f7787faab45cdf12fe3a8\")\n        assert (Bytes.blake2b_224 #\"\" == #\"836cc68931c2e4e3e838602eca1902591d216837bafddfe6f0c8cb07\")\n    test \"hashes 2\" = do\n        assert (Bytes.keccak_256 #\"\" == #\"c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470\")\n        assert (Bytes.ripemd_160 #\"\" == #\"9c1185a5c5e9fc54612808977ee8f548b2258d31\")\n    test \"byte index out of bounds\" fail = do\n        assert (Bytes.at #\"\" 0 == 0)\n    test \"text helpers\" = do\n        assert (String.toBytes \"é\" == #\"c3a9\")\n        assert (String.fromBytes #\"c3a9\" == \"é\")\n        assert (String.fromInt bigInt == \"7\")\n        assert (String.concat [\"a\", \"b\"] == \"ab\")\n    test \"text helpers 2\" = do\n        assert (String.join \",\" [\"a\", \"b\", \"c\"] == \"a,b,c\")\n        assert (String.join \",\" [] == \"\")\n    test \"invalid UTF-8\" fail = do\n        assert (String.fromBytes #\"ff\" == \"\")\n    test \"option helpers preserve payloads\" = do\n        assert (Option.map Builtin.unIData bigOption == Some 7)\n        assert (Option.map2 Int.add littleOption bigOption == Some 14)\n        assert (Option.andThen (\\x -> Option.Some x) littleOption == littleOption)\n        assert (Option.isSome bigOption)\n        assert (Option.apply (Some Builtin.unIData) bigOption == Some 7)\n    test \"option helpers preserve payloads 2\" = do\n        assert (not (Option.isSome none))\n        assert (Option.unwrap bigOption == bigInt)\n        assert (Option.withDefault bigInt bigOption == bigInt)\n    test \"unwrap None\" fail = do\n        assert (Option.unwrap none == 0)\n    test \"Big scalar control inputs\" = do\n        assert (List.take bigInt [1, 2] == [1, 2])\n        assert (Int.pow 2 bigInt == 128)\n        assert (Int.toBytes Bool.True bigInt 1 == #\"00000000000001\")\n        assert (Bytes.or Bool.True #\"00\" #\"ff\" == #\"ff\")\n    test \"Big array indices\" = do\n        assert (Array.at (Array.fromList [5, 6]) (Builtin.iData 1) == 6)\n        assert (Array.get (Array.fromList [5, 6]) bigInt == None)\n"
---
