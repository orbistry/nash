description: "module Main exposing (..)\n\nbigList : List Int\nbigList = lift [1, 2]\nbigMap : Map Int Bytes\nbigMap = lift [Builtin.mkPairData (Builtin.iData 1) (Builtin.bData #\"aa\")]\n\ntests\n    test \"scalar formats\" = do\n        assert (show 0 == \"0\")\n        assert (show (-12345) == \"-12345\")\n        assert (show #\"00abff\" == \"#\\\"00abff\\\"\")\n        assert (show \"a\\n\\t\\\"\\\\\" == \"\\\"a\\\\n\\\\t\\\\\\\"\\\\\\\\\\\"\")\n        assert (show True == \"True\")\n        assert (show False == \"False\")\n        assert (show () == \"()\")\n    test \"container formats\" = do\n        assert (show [1, 2] == \"[1, 2]\")\n        assert (show (Builtin.mkPairData (I 1) (B #\"aa\")) == \"(I 1, B #\\\"aa\\\")\")\n        assert (show (1, True) == \"(1, True)\")\n        assert (show (1, True, ()) == \"(1, True, ())\")\n        assert (show (1, 2, 3, 4) == \"(1, 2, 3, 4)\")\n    test \"Big formats\" = do\n        assert (show (Builtin.iData 42) == \"42\")\n        assert (show (Builtin.bData #\"ab\") == \"#\\\"ab\\\"\")\n        assert (show bigList == \"[1, 2]\")\n        assert (show bigMap == \"Map [(1, #\\\"aa\\\")]\")\n    test \"Data formats\" = do\n        assert (show (Builtin.constrData 7 [I 42]) == \"Constr (7, [I 42])\")\n        assert (show (Map [Builtin.mkPairData (I 1) (B #\"aa\")]) == \"Map [(I 1, B #\\\"aa\\\")]\")\n        assert (show (List [I 1]) == \"List [I 1]\")\n"
