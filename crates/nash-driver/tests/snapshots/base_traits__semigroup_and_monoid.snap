gElementsMap == leftEntries)\n        assert (unionForward /= unionReverse)\n    test \"mixed byte helpers return little bytes\" = do\n        assert (Bytes.append #\"aa\" (Builtin.bData #\"bb\") == #\"aabb\")\n        assert (Bytes.compare (Builtin.bData #\"aa\") #\"aa\" == EQ)\n        assert (Bytes.min #\"aa\" (Builtin.bData #\"bb\") == #\"aa\")\n        assert (Bytes.max (Builtin.bData #\"aa\") #\"bb\" == #\"bb\")\n"
