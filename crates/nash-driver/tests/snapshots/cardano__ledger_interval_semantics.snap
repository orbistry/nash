---
source: crates/nash-driver/tests/cardano.rs
description: "validator module Intervals exposing (main)\n\nimport Cardano.Time as Time exposing (Interval)\n\nmain : Data -> unit\nmain raw =\n    case raw of\n        Constr pair(0, [rangeData, emptyData, memberData, rangesData, containsData]) ->\n            let\n                range : Interval\n                range = validate rangeData\n                expectedEmpty : Bool\n                expectedEmpty = validate emptyData\n                expectedMembers : List Bool\n                expectedMembers = validate memberData\n                ranges : List Interval\n                ranges = validate rangesData\n                expectedContains : List Bool\n                expectedContains = validate containsData\n                _ = assert (Time.isEmpty range == lower expectedEmpty)\n                _ = assert (List.map (\\point -> Time.member point range) [-2, -1, 0, 1, 2] == List.map lower expectedMembers)\n            in\n            assert (List.map (Time.contains range) ranges == List.map lower expectedContains)\n        _ -> fail\n"
---
