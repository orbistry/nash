source: crates/nash-driver/tests/base_traits.rs
description: "module Main exposing (..)\n\ntype Token = Token Int\nbigList : List Int\nbigList = lift [Builtin.iData 1, Builtin.iData 2]\nbigMap : Map Int Bytes\nbigMap = lift [Builtin.mkPairData (Builtin.iData 1) (Builtin.bData #\"aa\")]\n\ntests\n    test \"primitive equality\" = do\n        assert (1 == 1)\n        assert (1 /= 2)\n        assert (#\"aa\" == #\"aa\")\n        assert (#\"aa\" /= #\"ab\")\n        assert (\"a\" == \"a\")\n        assert (\"a\" /= \"b\")\n        assert (True /= False)\n        assert (() == ())\n    test \"list and pair equality\" = do\n        assert ([1, 2] == [1, 2])\n        assert ([1] /= [1, 2])\n        assert ([1, 2] /= [1])\n        assert ([1, 2] /= [1, 3])\n        assert (Builtin.unConstrData (Builtin.constrData 1 []) == Builtin.unConstrData (Builtin.constrData 1 []))\n        assert (Builtin.unConstrData (Builtin.constrData 1 []) /= Builtin.unConstrData (Builtin.constrData 2 []))\n    test \"Big equality\" = do\n        assert (Token 1 == Token 1)\n        assert (Token 1 /= Token 2)\n        assert (bigList == lift [Builtin.iData 1, Builtin.iData 2])\n        assert (bigMap == bigMap)\n        assert (I 1 /= B #\"01\")\n        assert (Bool.True /= Bool.False)\n        assert (Unit.Unit == Unit.Unit)\n        assert (Option.Some (Token 1) /= Option.None)\n        assert (Ordering.LT /= Ordering.GT)\n    test \"little twin equality\" = do\n        assert (Some 1 == Some 1)\n        assert (Some 1 /= None)\n        assert (LT /= GT)\n    test \"ordering and defaults\" = do\n        assert (compare 1 2 == LT)\n        assert (compare 2 2 == EQ)\n        assert (compare 3 2 == GT)\n        assert (compare #\"00ff\" #\"01\" == LT)\n        assert (compare \"a\" \"b\" == LT)\n    test \"boolean and list ordering\" = do\n        assert (compare False True == LT)\n        assert (compare () () == EQ)\n        assert (compare [1, 2] [1, 3] == LT)\n        assert (compare [1] [1, 0] == LT)\n        assert (compare [1, 0] [1] == GT)\n        assert (Int.compare (Builtin.iData 2) (Builtin.iData 1) == GT)\n        assert (Bytes.compare (Builtin.bData #\"aa\") (Builtin.bData #\"bb\") == LT)\n    test \"ordering operators and bounds\" = do\n        assert (1 < 2 && 2 <= 2 && 3 > 2 && 3 >= 3)\n        assert (max 1 2 == 2 && min 1 2 == 1)\n    test \"tuple equality and ordering\" = do\n        assert ((1, True) == (1, True))\n        assert ((1, True, #\"aa\") /= (1, False, #\"aa\"))\n        assert ((1, 2, 3, 4) /= (1, 2, 3, 5))\n        assert (compare (1, 2) (1, 3) == LT)\n        assert (compare (1, 2, 3) (1, 2, 2) == GT)\n        assert (compare (1, 2, 3, 4) (1, 2, 3, 4) == EQ)\n"
