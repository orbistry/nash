module Main exposing (..)

bigInt : Int
bigInt = 7
bigBytes : Bytes
bigBytes = #"abcd"
bigIndices : List Int
bigIndices = lift [Builtin.iData 0, Builtin.iData 8]
bigOption : Option Int
bigOption = Option.Some 7
bigResult : Result Bytes Int
bigResult = Result.Ok 7
bigError : Result Bytes Int
bigError = Result.Err #"aa"
littleOption : option Int
littleOption = Some 7
littleResult : result Bytes Int
littleResult = Ok 7
none : option int
none = None
emptyResult : result bytes int
emptyResult = Err #""

both : (Lift bool 'a, Lift bool 'b) => 'a -> 'b -> bool
both a b = Bool.and a b
badBig : unit -> Bool
badBig _ = fail

tests
    test "mixed booleans and ordering" = do
        assert (Bool.and Bool.True True)
        assert (Bool.or False Bool.True)
        assert (not (Bool.xor Bool.True True))
        assert (not (Bool.not Bool.True))
    test "mixed booleans and ordering 2" = do
        assert (Bool.or Bool.True (badBig ()))
        assert (not (Bool.and False (badBig ())))
        assert (Bool.True || badBig ())
        assert (both Bool.True True)
    test "mixed booleans and ordering 3" = do
        assert (Ordering.invert Ordering.LT == GT)
        assert (Ordering.then_ EQ Ordering.GT == GT)
    test "integer helpers" = do
        assert (Int.abs (-7) == 7)
        assert (Int.abs bigInt == 7)
        assert (Int.pow 2 10 == 1024)
        assert (Int.pow bigInt 0 == 1)
    test "integer helpers 2" = do
        assert (Int.powMod 2 10 7 == 2)
        assert (Int.toBytes True 2 bigInt == #"0007")
        assert (Int.fromBytes False bigBytes == 52651)
        assert (Int.toString bigInt == "7")
    test "negative exponent" fail = do
        assert (Int.pow 2 (-1) == 0)
    test "negative integer encoding" fail = do
        assert (Int.toBytes True 0 (-1) == #"")
    test "byte access and slicing" = do
        assert (Bytes.length bigBytes == 2)
        assert (Bytes.at bigBytes 1 == 205)
        assert (Bytes.slice 1 1 bigBytes == #"cd")
        assert (Bytes.take 1 bigBytes == #"ab")
    test "byte access and slicing 2" = do
        assert (Bytes.drop 1 bigBytes == #"cd")
        assert (Bytes.drop (-1) bigBytes == #"abcd")
        assert (Bytes.take (-1) bigBytes == #"")
        assert (Bytes.toHex bigBytes == "abcd")
    test "byte access and slicing 3" = do
        assert (Bytes.concat [bigBytes, bigBytes] == #"abcdabcd")
    test "byte logic" = do
        assert (Bytes.and False bigBytes #"ff00" == #"ab00")
        assert (Bytes.or False bigBytes #"00ff" == #"abff")
        assert (Bytes.xor False bigBytes #"ffff" == #"5432")
        assert (Bytes.complement bigBytes == #"5432")
    test "byte logic 2" = do
        assert (Bytes.readBit #"01" 0)
        assert (Bytes.writeBits #"0000" bigIndices True == #"0101")
        assert (Bytes.shift #"01" 1 == #"02")
        assert (Bytes.rotate #"80" 1 == #"01")
    test "byte logic 3" = do
        assert (Bytes.countSetBits bigBytes == 10)
        assert (Bytes.findFirstSetBit #"08" == 3)
        assert (Bytes.findFirstSetBit #"00" == -1)
    test "hashes" = do
        assert (Bytes.sha2_256 #"" == #"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
        assert (Bytes.sha3_256 #"" == #"a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a")
        assert (Bytes.blake2b_256 #"" == #"0e5751c026e543b2e8ab2eb06099daa1d1e5df47778f7787faab45cdf12fe3a8")
        assert (Bytes.blake2b_224 #"" == #"836cc68931c2e4e3e838602eca1902591d216837bafddfe6f0c8cb07")
    test "hashes 2" = do
        assert (Bytes.keccak_256 #"" == #"c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470")
        assert (Bytes.ripemd_160 #"" == #"9c1185a5c5e9fc54612808977ee8f548b2258d31")
    test "byte index out of bounds" fail = do
        assert (Bytes.at #"" 0 == 0)
    test "text helpers" = do
        assert (String.toBytes "é" == #"c3a9")
        assert (String.fromBytes #"c3a9" == "é")
        assert (String.fromInt bigInt == "7")
        assert (String.concat ["a", "b"] == "ab")
    test "text helpers 2" = do
        assert (String.join "," ["a", "b", "c"] == "a,b,c")
        assert (String.join "," [] == "")
    test "invalid UTF-8" fail = do
        assert (String.fromBytes #"ff" == "")
    test "option helpers preserve payloads" = do
        assert (Option.map Builtin.unIData bigOption == Some 7)
        assert (Option.map2 (\a b -> a + b) littleOption bigOption == Some (Builtin.iData 14))
        assert (Option.andThen (\x -> Option.Some x) littleOption == littleOption)
        assert (Option.isSome bigOption)
    test "option helpers preserve payloads 2" = do
        assert (not (Option.isSome none))
        assert (Option.unwrap bigOption == bigInt)
        assert (Option.withDefault bigInt bigOption == bigInt)
        assert (Option.toResult #"" bigOption == littleResult)
    test "unwrap None" fail = do
        assert (Option.unwrap none == 0)
    test "result helpers preserve payloads" = do
        assert (Result.map Builtin.unIData bigResult == Ok 7)
        assert (Result.map2 (\a b -> a + b) littleResult bigResult == Ok (Builtin.iData 14))
        assert (Result.andThen (\x -> Result.Ok x) littleResult == littleResult)
        assert (Result.withDefault bigInt bigError == bigInt)
    test "result helpers preserve payloads 2" = do
        assert (Result.mapError Builtin.unBData bigError == Err #"aa")
        assert (Result.map (\x -> x + 1) emptyResult == emptyResult)
    test "Big scalar control inputs" = do
        assert (List.take bigInt [1, 2] == [1, 2])
        assert (Int.pow 2 bigInt == 128)
        assert (Int.toBytes Bool.True bigInt 1 == #"00000000000001")
        assert (Bytes.or Bool.True #"00" #"ff" == #"ff")
    test "Big array indices" = do
        assert (Array.at (Array.fromList [5, 6]) (Builtin.iData 1) == 6)
        assert (Array.get (Array.fromList [5, 6]) bigInt == None)
