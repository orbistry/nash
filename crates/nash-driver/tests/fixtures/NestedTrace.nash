module NestedTrace exposing (generate, replay, dependent, siblings, repartition, topologyReplay, topologyBuild, repartitionBuild)

import Cons exposing (type cons(..))
import Prop exposing (type choiceTree(..), type prng(..), type generator, choice, group)

reverse values = reverseOnto values Nil
reverseOnto values result =
    case values of
        Nil -> result
        Cons first rest -> reverseOnto rest (Cons first result)

finish : option ('a, prng) -> option ('a, choiceTree)
finish result =
    case result of
        None -> None
        Some (value, Seeded _ recorded) -> Some (value, Group (reverse recorded))
        Some (value, Replayed _ recorded) -> Some (value, Group (reverse recorded))
        Some (value, Rebuilding _ recorded) -> Some (value, Group (reverse recorded))

items : int -> generator (list int)
items limit = Prop.listBetween 0 limit (choice 100)

generate : bytes -> option (list int, choiceTree)
generate seed = finish (items 4 (Seeded seed Nil))

replay : choiceTree -> option (list int, choiceTree)
replay choiceTree =
    case choiceTree of
        Group children -> finish (items 4 (Replayed children Nil))
        _ -> None

bounds : generator (int, int)
bounds state =
    case group (choice 9) state of
        None -> None
        Some (offset, next) ->
            case group (choice offset) next of
                None -> None
                Some (index, final) -> Some ((offset + 1, index), final)

dependent : choiceTree -> option ((int, int), choiceTree)
dependent choiceTree =
    case choiceTree of
        Group children -> finish (bounds (Replayed children Nil))
        _ -> None

listAndNumber : generator (list int, int)
listAndNumber state =
    case group (items 4) state of
        None -> None
        Some (values, next) ->
            case group (choice 100) next of
                None -> None
                Some (number, final) -> Some ((values, number), final)

siblings : choiceTree -> option ((list int, int), choiceTree)
siblings choiceTree =
    case choiceTree of
        Group children -> finish (listAndNumber (Replayed children Nil))
        _ -> None

branch : generator int
branch state = do
    (mode, next) <- choice 1 state
    (_, following) <- choice 100 next
    if mode == 0 then extra mode following else Some (mode, following)

extra mode state =
    case choice 100 state of
        None -> None
        Some (_, final) -> Some (mode, final)

remaining : int -> generator int
remaining mode state = do
    (_, next) <- choice 100 state
    if mode == 1 then choice 100 next else Some (mode, next)

shifted : generator int
shifted state = do
    (mode, next) <- group branch state
    (_, final) <- group (remaining mode) next
    Some (mode, final)

repartition : choiceTree -> option (int, choiceTree)
repartition tree =
    case tree of
        Group children -> finish (shifted (Replayed children Nil))
        _ -> None

reshaped : generator (int, int)
reshaped state = do
    (mode, next) <- choice 1 state
    (value, final) <- (if mode == 0 then group (group (choice 100)) else choice 100) next
    Some ((mode, value), final)

topologyReplay : choiceTree -> option ((int, int), choiceTree)
topologyReplay tree =
    case tree of
        Group children -> finish (reshaped (Replayed children Nil))
        _ -> None

topologyBuild : list int -> option ((int, int), choiceTree)
topologyBuild values = finish (reshaped (Rebuilding values Nil))

repartitionBuild : list int -> option (int, choiceTree)
repartitionBuild values = finish (shifted (Rebuilding values Nil))
