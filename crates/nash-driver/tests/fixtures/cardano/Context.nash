validator module Context exposing (main)

import Cardano.Tx exposing (..)
import Cardano.Address exposing (..)
import Cardano.Time as Time
import Cardano.Value as Value exposing (Value)

integer : int -> Int
integer = lift

bytes : bytes -> Bytes
bytes = lift

key = PubKeyCredential (lift #"6b6579")
script = ScriptCredential (lift #"736372697074")
ref = OutputReference (lift #"7478") 2
rep = DRep key

certificates : List Certificate
certificates = lift
    [ RegStaking key Option.None
    , UnRegStaking script (Option.Some 12)
    , DelegStaking key (DelegStake (lift #"706f6f6c"))
    , RegDeleg key (DelegVote DRepAlwaysAbstain) 13
    , RegDRep key 14
    , UpdateDRep script
    , UnRegDRep key 15
    , PoolRegister (lift #"706f6f6c") (lift #"767266")
    , PoolRetire (lift #"706f6f6c") 16
    , AuthHotCommittee key script
    , ResignColdCommittee script
    , DelegStaking key (DelegStakeVote (lift #"706f6f6c") rep)
    , DelegStaking key (DelegVote DRepAlwaysNoConfidence)
    ]
actionId = GovernanceActionId (lift #"70726576696f7573") 3

actions : list GovernanceAction
actions =
    [ ParameterChange Option.None (toData (Builtin.mapData (Map.singleton (integer 0) (integer 42)))) (Option.Some (lift #"6775617264"))
    , HardForkInitiation (Option.Some actionId) (ProtocolVersion 11 0)
    , TreasuryWithdrawals (lift (Map.singleton key (integer 17))) Option.None
    , NoConfidence (Option.Some actionId)
    , UpdateCommittee Option.None (lift [key]) (lift (Map.singleton script (integer 18))) (Rational 2 3)
    , NewConstitution (Option.Some actionId) (Constitution Option.None)
    , InfoAction
    , NewConstitution Option.None (Constitution (Option.Some (lift #"636f6e737469747574696f6e")))
    ]
proposals : List Proposal
proposals = lift (List.map (Proposal 19 key) actions)
proposal = Proposal 19 key InfoAction
voters = [CommitteeVoter key, DRepVoter script, StakePoolVoter (lift #"706f6f6c")]
purposes = [Minting (lift #"706f6c696379"), Spending ref, Rewarding key, Certifying 0 (RegStaking key Option.None), Voting (CommitteeVoter key), Proposing 6 proposal]
infos = [MintingScript (lift #"706f6c696379"), SpendingScript ref (Option.Some (toData (integer 99))), RewardingScript key, CertifyingScript 0 (RegStaking key Option.None), VotingScript (CommitteeVoter key), ProposingScript 6 proposal]
coin : Value
coin = lift (Value.singleton #"" #"" 100)
mint : Value
mint = lift (Value.singleton #"706f6c696379" #"6173736574" -2)
addresses = [Address key Option.None, Address script (Option.Some (StakingHash key)), Address key (Option.Some (StakingPtr 20 21 22))]
datums = [NoDatum, DatumHash (lift #"646174756d"), InlineDatum (toData (integer 23))]
outputs = List.map2 (\address datum -> Output address coin datum (Option.Some (lift #"7265662d736372697074"))) addresses datums
firstOutput = Output (Address key Option.None) coin NoDatum (Option.Some (lift #"7265662d736372697074"))
lastOutput = Output (Address key (Option.Some (StakingPtr 20 21 22))) coin (InlineDatum (toData (integer 23))) (Option.Some (lift #"7265662d736372697074"))

tx = Tx
    (lift [Input ref firstOutput])
    (lift [Input (OutputReference (lift #"7265666572656e6365") 1) lastOutput])
    (lift outputs)
    2
    mint
    certificates
    (lift (Map.singleton key (integer 24)))
    (Time.Interval (Time.IntervalBound (Time.Finite 10) Bool.False) (Time.IntervalBound (Time.Finite 30) Bool.True))
    (lift [lift #"6b6579"])
    (lift (List.map (\purpose -> Builtin.mkPairData purpose (toData (integer 25))) purposes))
    (lift (Map.singleton (bytes #"646174756d") (toData (integer 23))))
    (lift #"7472616e73616374696f6e")
    (lift (List.map2 (\voter vote -> Builtin.mkPairData voter (Builtin.mapData (Map.singleton actionId vote))) voters [VoteNo, VoteYes, Abstain]))
    proposals
    (Option.Some 26)
    Option.None

main : Data -> unit
main packet =
    case packet of
        Constr pair(0, [raw, B encoded]) -> check raw encoded
        _ -> fail

check : Data -> bytes -> unit
check raw encoded =
    let
        context : ScriptContext
        context = validate raw
        index = Data.tag (toData context.scriptInfo)
        expected =
            case context.scriptInfo of
                SpendingScript _ Option.None ->
                    ScriptContext
                        { tx | currentTreasury = Option.None, treasuryDonation = (Option.Some 28), outputs = (lift [Output (Address key Option.None) coin NoDatum Option.None]) }
                        (toData (integer 27))
                        (SpendingScript ref Option.None)
                _ -> ScriptContext tx (toData (integer 27)) (List.at index infos |> Option.unwrap)
        _ = assert (context == expected)
        _ = assert (Data.serialise (toData expected) == encoded)
        _ = assert (Value.lovelace (List.at 0 context.tx.outputs |> Option.unwrap).value == 100)
        _ = assert (Value.quantityOf #"706f6c696379" #"6173736574" context.tx.mint == -2)
        _ = assert (Time.member 11 context.tx.validityRange)
        _ = assert (Bool.not (Time.member 10 context.tx.validityRange))
    in
    ()
