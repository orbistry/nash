module Array exposing ( fromList, length, at, get )


import Builtin
import Function exposing ( (|>) )
import Lift exposing ( Lift )
import Literal
import Option exposing ( type option(..) )


{-| Convert a Big or little list to an array, preserving element representations. -}
fromList : Lift (list 'a) ('f 'a) => 'f 'a -> array 'a
fromList values =
    values
        |> lower
        |> Builtin.listToArray


{-| Return the number of array elements. -}
length : array 'a -> int
length = Builtin.lengthOfArray


{-| Read a zero-based index. An invalid index fails. -}
at : Lift int 'n => array 'a -> 'n -> 'a
at values index = Builtin.indexArray values (lower index)


{-| Read a zero-based index, returning None for an invalid index. -}
get : Lift int 'n => array 'a -> 'n -> option 'a
get values index = getIndex values (lower index)


getIndex : array 'a -> int -> option 'a
getIndex values index =
    if Builtin.lessThanInteger index 0 then
        None
    else if Builtin.lessThanInteger index (length values) then
        Some (at values index)
    else
        None
