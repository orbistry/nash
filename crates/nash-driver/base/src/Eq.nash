module Eq exposing (Eq)

import Literal
import Primitive exposing (..)
import Builtin exposing (..)

trait Eq 'a where
    eq : 'a -> 'a -> bool

    neq : 'a -> 'a -> bool
    neq a b = if eq a b then False else True

impl Eq int where
    eq = Builtin.equalsInteger

impl Eq bytes where
    eq = Builtin.equalsByteString

impl Eq string where
    eq = Builtin.equalsString

impl Eq bool where
    eq a b = if a then b else if b then False else True

impl Eq unit where
    eq _ _ = True

impl Eq 'a => Eq (list 'a) where
    eq xs ys =
        case xs of
            [] -> case ys of
                [] -> True
                _ :: _ -> False
            x :: restX -> case ys of
                [] -> False
                y :: restY -> if eq x y then eq restX restY else False

impl (Eq 'a, Eq 'b) => Eq (pair 'a 'b) where
    eq a b =
        let
            pair(firstA, secondA) = a
            pair(firstB, secondB) = b
        in
        if eq firstA firstB then eq secondA secondB else False

impl Eq value where
    eq a b = Builtin.equalsData (Builtin.valueData a) (Builtin.valueData b)
