module Ordering exposing ( Ordering(..), type ordering(..), invert, then_ )


import Primitive exposing ( type bool(..) )
import Eq exposing ( Eq )
import Lift exposing ( Lift )


{-| A little comparison result: LT, EQ, or GT. -}
type ordering
    = LT
    | EQ
    | GT


{-| A Data-represented comparison result: LT, EQ, or GT. -}
type Ordering
    = LT
    | EQ
    | GT


{-| Exchange LT and GT, leaving EQ unchanged; return little ordering. -}
invert : Lift ordering 'a => 'a -> ordering
invert order =
    case lower order of
        LT ->
            GT

        EQ ->
            EQ

        GT ->
            LT


{-| Use the second ordering when the first is EQ; otherwise keep the first. -}
then_ : ( Lift ordering 'a, Lift ordering 'b ) => 'a -> 'b -> ordering
then_ first second =
    case lower first of
        EQ ->
            lower second

        order ->
            order


impl Eq ordering where
    eq a b =
        case ( a, b ) of
            ( LT, LT ) ->
                True

            ( EQ, EQ ) ->
                True

            ( GT, GT ) ->
                True

            _ ->
                False


impl Lift ordering Ordering where
    lift value =
        case value of
            LT ->
                Ordering.LT

            EQ ->
                Ordering.EQ

            GT ->
                Ordering.GT

    lower value =
        case value of
            Ordering.LT ->
                LT

            Ordering.EQ ->
                EQ

            Ordering.GT ->
                GT
