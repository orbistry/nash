module Ord exposing ( Ord )


import Builtin
import Primitive exposing ( type bool(..) )
import Eq exposing ( Eq )
import Ordering exposing ( type ordering(..) )


trait Eq 'a => Ord 'a where
    compare : 'a -> 'a -> ordering

    lt : 'a -> 'a -> bool
    lt a b =
        case compare a b of
            LT ->
                True

            _ ->
                False

    le : 'a -> 'a -> bool
    le a b =
        case compare a b of
            GT ->
                False

            _ ->
                True

    gt : 'a -> 'a -> bool
    gt a b = lt b a

    ge : 'a -> 'a -> bool
    ge a b = le b a

    max : 'a -> 'a -> 'a
    max a b =
        if lt a b then
            b
        else
            a

    min : 'a -> 'a -> 'a
    min a b =
        if lt a b then
            a
        else
            b


impl Ord int where
    compare a b =
        if Builtin.lessThanInteger a b then
            LT
        else if Builtin.equalsInteger a b then
            EQ
        else
            GT


impl Ord bytes where
    compare a b =
        if Builtin.lessThanByteString a b then
            LT
        else if Builtin.equalsByteString a b then
            EQ
        else
            GT


impl Ord string where
    compare a b = compare (Builtin.encodeUtf8 a) (Builtin.encodeUtf8 b)


impl Ord bool where
    compare a b =
        if a then
            if b then
                EQ
            else
                GT
        else if b then
            LT
        else
            EQ


impl Ord unit where
    compare _ _ = EQ


impl ( Ord 'a, Eq (list 'a) ) => Ord (list 'a) where
    compare xs ys =
        case xs of
            [] ->
                case ys of
                    [] ->
                        EQ

                    _ :: _ ->
                        LT

            x :: restX ->
                case ys of
                    [] ->
                        GT

                    y :: restY ->
                        case compare x y of
                            EQ ->
                                compare restX restY

                            order ->
                                order
