module String exposing ( toBytes, fromBytes, fromInt, concat, join )


import Literal
import Lift exposing ( Lift )
import Builtin
import Function exposing ( (|>) )
import Int


{-| Encode a string as UTF-8 bytes. -}
toBytes : string -> bytes
toBytes = Builtin.encodeUtf8


{-| Decode UTF-8 bytes. Invalid UTF-8 fails. -}
fromBytes : Lift bytes 'b => 'b -> string
fromBytes value =
    value
        |> lower
        |> Builtin.decodeUtf8


{-| Render an integer in decimal notation. -}
fromInt : Lift int 'n => 'n -> string
fromInt = Int.toString


{-| Concatenate strings in list order. -}
concat : list string -> string
concat values = concatList values


concatList : list string -> string
concatList xs =
    case xs of
        [] ->
            ""

        x :: rest ->
            Builtin.appendString x (concatList rest)


{-| Join strings with a separator placed only between entries. -}
join : string -> list string -> string
join separator values =
    case values of
        [] ->
            ""

        x :: rest ->
            Builtin.appendString x (joinRest separator rest)


joinRest : string -> list string -> string
joinRest separator xs =
    case xs of
        [] ->
            ""

        x :: rest ->
            Builtin.appendString
                separator
                (Builtin.appendString x (joinRest separator rest))
