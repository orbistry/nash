module Num exposing (Num)

import Builtin
import Literal
import Lift exposing (Lift)

trait Num 'a where
    add : 'a -> 'a -> 'a
    sub : 'a -> 'a -> 'a
    mul : 'a -> 'a -> 'a
    negate : 'a -> 'a

impl Num int where
    add = Builtin.addInteger
    sub = Builtin.subtractInteger
    mul = Builtin.multiplyInteger
    negate x = Builtin.subtractInteger 0 x

impl Num Int where
    add a b = lift (Builtin.addInteger (lower a) (lower b))
    sub a b = lift (Builtin.subtractInteger (lower a) (lower b))
    mul a b = lift (Builtin.multiplyInteger (lower a) (lower b))
    negate value = lift (Builtin.subtractInteger 0 (lower value))
