module Option exposing
    ( Option(..)
    , type option(..)
    , withDefault
    , map
    , apply
    , map2
    , andThen
    , isSome
    , unwrap
    )


import Primitive exposing ( type bool(..) )
import Eq exposing ( Eq )
import Lift exposing ( Lift )
import Functor
import Applicative exposing ( Applicative )
import Monad exposing ( Monad )


{-| A little optional value: None or Some payload. -}
type option 'a
    = Some 'a
    | None


{-| A Data-represented optional value with a Big payload. -}
type Option 'a
    = Some 'a
    | None


impl Functor.Functor option where
    map f value =
        case value of
            Some item ->
                Some (f item)

            None ->
                None


impl Applicative option where
    pure = Some

    apply functions value =
        case functions of
            Some f ->
                Functor.map f value

            None ->
                None


impl Monad option where
    bind value f =
        case value of
            Some item ->
                f item

            None ->
                None


{-| Return a present payload or the supplied default. -}
withDefault : Lift (option 'a) ('f 'a) => 'a -> 'f 'a -> 'a
withDefault fallback value =
    case lowerOuter value of
        Some item ->
            item

        None ->
            fallback


impl Eq 'a => Eq (option 'a) where
    eq a b =
        case ( a, b ) of
            ( Some x, Some y ) ->
                eq x y

            ( None, None ) ->
                True

            _ ->
                False


impl Lift (option ('a : Big)) (Option 'a) where
    lift value =
        case value of
            Some item ->
                Option.Some item

            None ->
                Option.None

    lower value =
        case value of
            Option.Some item ->
                Some item

            Option.None ->
                None


{-| Map a present payload, returning a little option. -}
map : Lift (option 'a) ('f 'a) => ('a -> 'b) -> 'f 'a -> option 'b
map f value = Functor.map f (lowerOuter value)


{-| Apply an optional function to an optional value. -}
apply : Lift (option 'a) ('f 'a) => option ('a -> 'b) -> 'f 'a -> option 'b
apply functions value = map2 (\f x -> f x) functions value


{-| Combine two present payloads; return None if either input is absent. -}
map2 : ( Lift (option 'a) ('f 'a), Lift (option 'b) ('g 'b) )
    => ('a -> 'b -> 'c) -> 'f 'a -> 'g 'b -> option 'c
map2 f left right =
    case ( lowerOuter left, lowerOuter right ) of
        ( Some a, Some b ) ->
            Some (f a b)

        _ ->
            None


{-| Pass a present payload to a function returning an option. -}
andThen : ( Lift (option 'a) ('f 'a), Lift (option 'b) ('g 'b) )
    => ('a -> 'g 'b) -> 'f 'a -> option 'b
andThen f value =
    case lowerOuter value of
        Some x ->
            lower (f x)

        None ->
            None


{-| Test whether a payload is present. -}
isSome : Lift (option 'a) ('f 'a) => 'f 'a -> bool
isSome value =
    case lowerOuter value of
        Some _ ->
            True

        None ->
            False


{-| Return the payload or fail for None. -}
unwrap : Lift (option 'a) ('f 'a) => 'f 'a -> 'a
unwrap value =
    case lowerOuter value of
        Some x ->
            x

        None ->
            fail


lowerOuter : Lift (option 'a) ('f 'a) => 'f 'a -> option 'a
lowerOuter = lower
