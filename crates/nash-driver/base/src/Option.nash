module Option exposing (Option(..), type option(..), withDefault, map, map2, andThen, isSome, unwrap, toResult)

import Primitive exposing (type bool(..))
import Eq exposing (Eq)
import Lift exposing (Lift)
import Functor
import Result exposing (type result(..))
import Applicative exposing (Applicative)
import Monad exposing (Monad)

type option 'a = Some 'a | None
type Option 'a = Some 'a | None

impl Functor.Functor option where
    map f value =
        case value of
            Some item -> Some (f item)
            None -> None

impl Applicative option where
    pure = Some
    apply functions value =
        case functions of
            Some f -> Functor.map f value
            None -> None

impl Monad option where
    bind value f =
        case value of
            Some item -> f item
            None -> None

withDefault : Lift (option 'a) ('f 'a) => 'a -> 'f 'a -> 'a
withDefault fallback value =
    case lowerOuter value of
        Some item -> item
        None -> fallback

impl Eq 'a => Eq (option 'a) where
    eq a b =
        case (a, b) of
            (Some x, Some y) -> eq x y
            (None, None) -> True
            _ -> False

impl Lift (option ('a : Big)) (Option 'a) where
    lift value =
        case value of
            Some item -> Option.Some item
            None -> Option.None
    lower value =
        case value of
            Option.Some item -> Some item
            Option.None -> None

map : Lift (option 'a) ('f 'a) => ('a -> 'b) -> 'f 'a -> option 'b
map f value = Functor.map f (lowerOuter value)

map2 : (Lift (option 'a) ('f 'a), Lift (option 'b) ('g 'b)) => ('a -> 'b -> 'c) -> 'f 'a -> 'g 'b -> option 'c
map2 f left right =
    case (lowerOuter left, lowerOuter right) of
        (Some a, Some b) -> Some (f a b)
        _ -> None

andThen : (Lift (option 'a) ('f 'a), Lift (option 'b) ('g 'b)) => ('a -> 'g 'b) -> 'f 'a -> option 'b
andThen f value =
    case lowerOuter value of
        Some x -> lower (f x)
        None -> None

isSome : Lift (option 'a) ('f 'a) => 'f 'a -> bool
isSome value =
    case lowerOuter value of
        Some _ -> True
        None -> False

unwrap : Lift (option 'a) ('f 'a) => 'f 'a -> 'a
unwrap value =
    case lowerOuter value of
        Some x -> x
        None -> fail

toResult : Lift (option 'a) ('f 'a) => 'e -> 'f 'a -> result 'e 'a
toResult error value =
    case lowerOuter value of
        Some x -> Ok x
        None -> Err error

lowerOuter : Lift (option 'a) ('f 'a) => 'f 'a -> option 'a
lowerOuter = lower
