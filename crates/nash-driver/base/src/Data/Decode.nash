module Data.Decode exposing (type decoder, run, int, bytes, string, bool, data, list, map, constr, field, oneOf, reject)

import Primitive exposing (Data(..), type bool(..))
import Builtin
import Prelude exposing (..)
import Literal
import Option exposing (type option(..))
import Cons exposing (type cons(..))
import List
import Functor
import Applicative
import Monad

type alias decoder 'a = Data -> option 'a

run : decoder 'a -> Data -> option 'a
run dec value = dec value

impl Functor.Functor decoder where
    map f dec value = Option.map f (dec value)

impl Applicative.Applicative decoder where
    pure value _ = Some value
    apply functions values input = do
        f <- functions input
        value <- values input
        Some (f value)

impl Monad.Monad decoder where
    bind dec next input = do
        value <- dec input
        next value input

reject : decoder 'a
reject _ = None

int : decoder int
int value = case value of
    I number -> Some number
    _ -> None

bytes : decoder bytes
bytes value = case value of
    B raw -> Some raw
    _ -> None

string : decoder string
string value = case value of
    B raw ->
        if utf8 raw (Builtin.lengthOfByteString raw) 0 then Some (Builtin.decodeUtf8 raw)
        else None
    _ -> None

utf8 : bytes -> int -> int -> bool
utf8 raw size index =
    if index == size then True
    else
        let first = Builtin.indexByteString raw index in
        if first < 128 then utf8 raw size (index + 1)
        else if first >= 194 && first <= 223 then continuation raw size (index + 1) 1 128 191
        else if first == 224 then continuation raw size (index + 1) 2 160 191
        else if first >= 225 && first <= 236 then continuation raw size (index + 1) 2 128 191
        else if first == 237 then continuation raw size (index + 1) 2 128 159
        else if first >= 238 && first <= 239 then continuation raw size (index + 1) 2 128 191
        else if first == 240 then continuation raw size (index + 1) 3 144 191
        else if first >= 241 && first <= 243 then continuation raw size (index + 1) 3 128 191
        else if first == 244 then continuation raw size (index + 1) 3 128 143
        else False

continuation : bytes -> int -> int -> int -> int -> int -> bool
continuation raw size index remaining low high =
    if remaining == 0 then utf8 raw size index
    else if index >= size then False
    else
        let next = Builtin.indexByteString raw index in
        if next < low || next > high then False
        else continuation raw size (index + 1) (remaining - 1) 128 191

bool : decoder bool
bool value = case value of
    Constr pair(tag, []) ->
        if tag == 0 then Some False
        else if tag == 1 then Some True
        else None
    _ -> None

data : decoder Data
data value = Some value

list : decoder 'a -> decoder (list 'a)
list item value = case value of
    List values -> decodeList item values
    _ -> None

decodeList : decoder 'a -> list Data -> option (list 'a)
decodeList item values = case values of
    [] -> Some []
    first :: rest -> do
        value <- item first
        tail <- decodeList item rest
        Some (Builtin.mkCons value tail)

map : decoder 'k -> decoder 'v -> decoder (cons ('k, 'v))
map key item value = case value of
    Map entries -> decodeEntries key item entries
    _ -> None

decodeEntries : decoder 'k -> decoder 'v -> list (pair Data Data) -> option (cons ('k, 'v))
decodeEntries key item entries = case entries of
    [] -> Some Nil
    pair(k, v) :: rest -> do
        decodedKey <- key k
        decodedValue <- item v
        tail <- decodeEntries key item rest
        Some (Cons (decodedKey, decodedValue) tail)

constr : int -> decoder 'a -> decoder 'a
constr expected inner value = case value of
    Constr pair(tag, _) -> if tag == expected then inner value else None
    _ -> None

field : int -> decoder 'a -> decoder 'a
field index inner value = case value of
    Constr pair(_, items) -> do
        item <- List.at index items
        inner item
    _ -> None

oneOf : cons (decoder 'a) -> decoder 'a
oneOf decoders value = case decoders of
    Nil -> None
    Cons first rest -> case first value of
        Some item -> Some item
        None -> oneOf rest value
