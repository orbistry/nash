module Cons exposing
    ( type cons(..)
    , map
    , indexedMap
    , map2
    , foldr
    , foldl
    , append
    , length
    , singleton
    , fromList
    , toList
    )


import Builtin
import Function exposing ( (|>) )
import Lift exposing ( Lift )
import Primitive exposing ( type bool(..) )
import Literal
import Eq exposing ( Eq )
import Show exposing ( Show )
import Functor


{-| A Term list that can contain functions and other non-Storable values. Nil is empty; Cons holds an element and the remaining list. -}
type cons 'a
    = Nil
    | Cons 'a (cons 'a)


{-| Create a Term list with one element. -}
singleton : 'a -> cons 'a
singleton value = Cons value Nil


{-| Apply a function to each element of a Term list. -}
map : ('a -> 'b) -> cons 'a -> cons 'b
map = Functor.map


impl Functor.Functor cons where
    map f values =
        case values of
            Nil ->
                Nil

            Cons x xs ->
                Cons (f x) (Functor.map f xs)


{-| Map elements with zero-based indices. -}
indexedMap : (int -> 'a -> 'b) -> cons 'a -> cons 'b
indexedMap f values = indexedFrom 0 f values


indexedFrom : int -> (int -> 'a -> 'b) -> cons 'a -> cons 'b
indexedFrom index f values =
    case values of
        Nil ->
            Nil

        Cons x xs ->
            Cons (f index x) (indexedFrom (Builtin.addInteger index 1) f xs)


{-| Combine corresponding elements, stopping at the shorter input. -}
map2 : ('a -> 'b -> 'c) -> cons 'a -> cons 'b -> cons 'c
map2 f left right =
    case ( left, right ) of
        ( Cons x xs, Cons y ys ) ->
            Cons (f x y) (map2 f xs ys)

        _ ->
            Nil


{-| Fold from the right, passing each element before the accumulator. -}
foldr : ('a -> 'b -> 'b) -> 'b -> cons 'a -> 'b
foldr f acc values =
    case values of
        Nil ->
            acc

        Cons x xs ->
            f x (foldr f acc xs)


{-| Fold left to right, passing each element before the accumulator. -}
foldl : ('a -> 'b -> 'b) -> 'b -> cons 'a -> 'b
foldl f acc values =
    case values of
        Nil ->
            acc

        Cons x xs ->
            foldl f (f x acc) xs


{-| Append the second Term list to the first. -}
append : cons 'a -> cons 'a -> cons 'a
append left right =
    case left of
        Nil ->
            right

        Cons x xs ->
            Cons x (append xs right)


{-| Count the elements of a Term list. -}
length : cons 'a -> int
length values = foldl (\_ count -> Builtin.addInteger count 1) 0 values


{-| Convert a Big or little native list to a Term list, preserving its elements. -}
fromList : Lift (list 'a) ('f 'a) => 'f 'a -> cons 'a
fromList values =
    values
        |> lower
        |> fromLittleList


fromLittleList : list 'a -> cons 'a
fromLittleList values =
    case values of
        [] ->
            Nil

        x :: xs ->
            Cons x (fromLittleList xs)


{-| Convert a Term list to a native list. Its elements must be Storable. -}
toList : cons 'a -> list 'a
toList values =
    case values of
        Nil ->
            []

        Cons x xs ->
            Builtin.mkCons x (toList xs)


impl Eq 'a => Eq (cons 'a) where
    eq left right =
        case ( left, right ) of
            ( Nil, Nil ) ->
                True

            ( Cons x xs, Cons y ys ) ->
                if eq x y then
                    eq xs ys
                else
                    False

            _ ->
                False


impl Show 'a => Show (cons 'a) where
    show values =
        Builtin.appendString
            "Cons ["
            (Builtin.appendString (showItems values) "]")


showItems : Show 'a => cons 'a -> string
showItems values =
    case values of
        Nil ->
            ""

        Cons x Nil ->
            show x

        Cons x xs ->
            Builtin.appendString
                (show x)
                (Builtin.appendString ", " (showItems xs))
