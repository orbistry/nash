module List exposing
    ( singleton
    , repeat
    , range
    , head
    , tail
    , isEmpty
    , length
    , isLength
    , reverse
    , append
    , concat
    , map
    , indexedMap
    , filter
    , filterMap
    , foldl
    , foldr
    , any
    , all
    , find
    , member
    , take
    , drop
    , at
    , map2
    , sort
    , sortBy
    , sum
    , partition
    , toArray
    )


import Prelude exposing (..)
import Lift exposing ( Lift )
import Builtin
import Functor
import Option exposing ( type option(..) )
import Eq exposing ( Eq )
import Ord exposing ( Ord )
import Literal
import Primitive exposing ( type bool(..) )
import Ordering exposing ( type ordering(..) )


{-| Create a list containing one element. -}
singleton : 'a -> list 'a
singleton x = [ x ]


{-| Repeat a value count times. A nonpositive count returns an empty list. -}
repeat : Lift int 'n => 'n -> 'a -> list 'a
repeat count x = repeatList (lower count) x


repeatList : int -> 'a -> list 'a
repeatList n x =
    if n <= 0 then
        []
    else
        x :: repeatList (n - 1) x


{-| Generate integers from the inclusive start to the exclusive end. Reversed or equal bounds return an empty list. -}
range : ( Lift int 's, Lift int 'e ) => 's -> 'e -> list int
range start end = rangeList (lower start) (lower end)


rangeList : int -> int -> list int
rangeList start end =
    if start >= end then
        []
    else
        start :: rangeList (start + 1) end


{-| Return the first element, or None for an empty list. -}
head : Lift (list 'a) ('f 'a) => 'f 'a -> option 'a
head values =
    case lowerOuter values of
        [] ->
            None

        x :: _ ->
            Some x


{-| Return the remaining elements, or None for an empty list. -}
tail : Lift (list 'a) ('f 'a) => 'f 'a -> option (list 'a)
tail values =
    case lowerOuter values of
        [] ->
            None

        _ :: xs ->
            Some xs


{-| Test whether the list has no elements. -}
isEmpty : Lift (list 'a) ('f 'a) => 'f 'a -> bool
isEmpty values =
    values
        |> lowerOuter
        |> Builtin.nullList


{-| Count the elements. -}
length : Lift (list 'a) ('f 'a) => 'f 'a -> int
length values =
    values
        |> lowerOuter
        |> foldlList (\_ n -> n + 1) 0


{-| Test for exactly the supplied count without first computing the list's length. Negative counts return False. -}
isLength : ( Lift (list 'a) ('f 'a), Lift int 'n ) => 'f 'a -> 'n -> bool
isLength values mustLength =
    let
        count : int
        count = lower mustLength

        items = lowerOuter values
    in
        if count <= 0 then
            case items of
                [] ->
                    count == 0

                _ :: _ ->
                    False
        else
            case Builtin.dropList (count - 1) items of
                [ _ ] ->
                    True

                _ ->
                    False


{-| Reverse element order without converting the elements. -}
reverse : Lift (list 'a) ('f 'a) => 'f 'a -> list 'a
reverse values =
    values
        |> lowerOuter
        |> foldlList (\x xs -> x :: xs) []


{-| Append the second list to the first, preserving element representations. -}
append : ( Lift (list 'a) ('f 'a), Lift (list 'a) ('g 'a) )
    => 'f 'a -> 'g 'a -> list 'a
append xs ys = appendList (lowerOuter xs) (lowerOuter ys)


appendList : list 'a -> list 'a -> list 'a
appendList xs ys =
    case xs of
        [] ->
            ys

        x :: rest ->
            x :: appendList rest ys


{-| Flatten one level of lists, preserving element order. -}
concat : ( Lift (list ('f 'a)) ('g ('f 'a)), Lift (list 'a) ('f 'a) )
    => 'g ('f 'a) -> list 'a
concat values =
    values
        |> lowerOuter
        |> foldrList (\xs acc -> appendList (lowerOuter xs) acc) []


{-| Apply a function to each element. -}
map : Lift (list 'a) ('f 'a) => ('a -> 'b) -> 'f 'a -> list 'b
map f values = Functor.map f (lowerOuter values)


{-| Map elements with their zero-based indices. -}
indexedMap : Lift (list 'a) ('f 'a) => (int -> 'a -> 'b) -> 'f 'a -> list 'b
indexedMap f values = indexedFrom 0 f (lowerOuter values)


indexedFrom : int -> (int -> 'a -> 'b) -> list 'a -> list 'b
indexedFrom index f xs =
    case xs of
        [] ->
            []

        x :: rest ->
            f index x :: indexedFrom (index + 1) f rest


{-| Keep elements whose predicate is true. -}
filter : ( Lift (list 'a) ('f 'a), Lift bool 'p )
    => ('a -> 'p) -> 'f 'a -> list 'a
filter p values =
    foldrList
        (
            \x acc ->
                if lower (p x) then
                    x :: acc
                else
                    acc
        )
        []
        (lowerOuter values)


{-| Map each element and keep the payloads of Some results. -}
filterMap : ( Lift (list 'a) ('f 'a), Lift (option 'b) ('g 'b) )
    => ('a -> 'g 'b) -> 'f 'a -> list 'b
filterMap f values = filterMapList f (lowerOuter values)


filterMapList : Lift (option 'b) ('g 'b) => ('a -> 'g 'b) -> list 'a -> list 'b
filterMapList f xs =
    case xs of
        [] ->
            []

        x :: rest ->
            case lower (f x) of
                Some y ->
                    y :: filterMapList f rest

                None ->
                    filterMapList f rest


{-| Fold left to right, passing each element before the accumulator. -}
foldl : Lift (list 'a) ('f 'a) => ('a -> 'b -> 'b) -> 'b -> 'f 'a -> 'b
foldl f acc values = foldlList f acc (lowerOuter values)


foldlList : ('a -> 'b -> 'b) -> 'b -> list 'a -> 'b
foldlList f acc xs =
    case xs of
        [] ->
            acc

        x :: rest ->
            foldlList f (f x acc) rest


{-| Fold from the right, passing each element before the accumulator. -}
foldr : Lift (list 'a) ('f 'a) => ('a -> 'b -> 'b) -> 'b -> 'f 'a -> 'b
foldr f acc values = foldrList f acc (lowerOuter values)


foldrList : ('a -> 'b -> 'b) -> 'b -> list 'a -> 'b
foldrList f acc xs =
    case xs of
        [] ->
            acc

        x :: rest ->
            f x (foldrList f acc rest)


{-| Return True at the first matching element. An empty list returns False. -}
any : ( Lift (list 'a) ('f 'a), Lift bool 'p ) => ('a -> 'p) -> 'f 'a -> bool
any p values = anyList (\x -> lower (p x)) (lowerOuter values)


anyList : ('a -> bool) -> list 'a -> bool
anyList p xs =
    case xs of
        [] ->
            False

        x :: rest ->
            if p x then
                True
            else
                anyList p rest


{-| Return False at the first nonmatching element. An empty list returns True. -}
all : ( Lift (list 'a) ('f 'a), Lift bool 'p ) => ('a -> 'p) -> 'f 'a -> bool
all p values = allList (\x -> lower (p x)) (lowerOuter values)


allList : ('a -> bool) -> list 'a -> bool
allList p xs =
    case xs of
        [] ->
            True

        x :: rest ->
            if p x then
                allList p rest
            else
                False


{-| Return the first matching element, or None. -}
find : ( Lift (list 'a) ('f 'a), Lift bool 'p )
    => ('a -> 'p) -> 'f 'a -> option 'a
find p values = findList (\x -> lower (p x)) (lowerOuter values)


findList : ('a -> bool) -> list 'a -> option 'a
findList p xs =
    case xs of
        [] ->
            None

        x :: rest ->
            if p x then
                Some x
            else
                findList p rest


{-| Test whether an equal element occurs in the list. -}
member : ( Eq 'a, Lift (list 'a) ('f 'a) ) => 'a -> 'f 'a -> bool
member x values = anyList (\y -> x == y) (lowerOuter values)


{-| Keep at most count elements from the front. Nonpositive counts return an empty list. -}
take : ( Lift int 'n, Lift (list 'a) ('f 'a) ) => 'n -> 'f 'a -> list 'a
take count values = takeList (lower count) (lowerOuter values)


takeList : int -> list 'a -> list 'a
takeList n xs =
    if n <= 0 then
        []
    else
        case xs of
            [] ->
                []

            x :: rest ->
                x :: takeList (n - 1) rest


{-| Skip count elements. Nonpositive counts leave the list unchanged; counts past the end return an empty list. -}
drop : ( Lift int 'n, Lift (list 'a) ('f 'a) ) => 'n -> 'f 'a -> list 'a
drop count values =
    let
        n : int
        n = lower count
    in
        if n <= 0 then
            lowerOuter values
        else
            Builtin.dropList n (lowerOuter values)


{-| Return the element at a zero-based index, or None for an invalid index. -}
at : ( Lift int 'n, Lift (list 'a) ('f 'a) ) => 'n -> 'f 'a -> option 'a
at index values =
    let
        n : int
        n = lower index
    in
        if n < 0 then
            None
        else
            head (Builtin.dropList n (lowerOuter values))


{-| Combine corresponding elements, stopping at the shorter list. -}
map2 : ( Lift (list 'a) ('f 'a), Lift (list 'b) ('g 'b) )
    => ('a -> 'b -> 'c) -> 'f 'a -> 'g 'b -> list 'c
map2 f xs ys = map2List f (lowerOuter xs) (lowerOuter ys)


map2List : ('a -> 'b -> 'c) -> list 'a -> list 'b -> list 'c
map2List f xs ys =
    case ( xs, ys ) of
        ( x :: rest, y :: more ) ->
            f x y :: map2List f rest more

        _ ->
            []


{-| Sort in ascending order using Ord. Equal elements retain their original order. -}
sort : ( Ord 'a, Lift (list 'a) ('f 'a) ) => 'f 'a -> list 'a
sort values =
    values
        |> lowerOuter
        |> sortList compare


{-| Sort using a comparator that returns ordering or Ordering. Equal elements retain their original order. -}
sortBy : ( Lift (list 'a) ('f 'a), Lift ordering 'o )
    => ('a -> 'a -> 'o) -> 'f 'a -> list 'a
sortBy cmp values = sortList (\a b -> lower (cmp a b)) (lowerOuter values)


sortList : ('a -> 'a -> ordering) -> list 'a -> list 'a
sortList cmp xs = foldrList (insert cmp) [] xs


insert : ('a -> 'a -> ordering) -> 'a -> list 'a -> list 'a
insert cmp x xs =
    case xs of
        [] ->
            [ x ]

        y :: rest ->
            case cmp x y of
                GT ->
                    y :: insert cmp x rest

                _ ->
                    x :: xs


{-| Add integer elements, lowering each to int. An empty list sums to zero. -}
sum : ( Lift int 'a, Lift (list 'a) ('f 'a) ) => 'f 'a -> int
sum values =
    values
        |> lowerOuter
        |> foldlList (\x acc -> Builtin.addInteger (lower x) acc) 0


{-| Return matching elements first and nonmatching elements second, preserving order within both lists. -}
partition : ( Lift (list 'a) ('f 'a), Lift bool 'p )
    => ('a -> 'p) -> 'f 'a -> ( list 'a, list 'a )
partition p values = partitionList (\x -> lower (p x)) (lowerOuter values)


partitionList : ('a -> bool) -> list 'a -> ( list 'a, list 'a )
partitionList p xs =
    case xs of
        [] ->
            ( [], [] )

        x :: rest ->
            let
                ( yes, no ) = partitionList p rest
            in
                if p x then
                    ( x :: yes, no )
                else
                    ( yes, x :: no )


{-| Convert the outer list to an array without converting its elements. -}
toArray : Lift (list 'a) ('f 'a) => 'f 'a -> array 'a
toArray values =
    values
        |> lowerOuter
        |> Builtin.listToArray


lowerOuter : Lift (list 'a) ('f 'a) => 'f 'a -> list 'a
lowerOuter = lower
