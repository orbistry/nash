module Prop exposing (type prng(..), type choiceTree(..), type generator, group, choice, constant, intBetween, int, listOf, listBetween, tuple2, oneOf, bytes)

import Builtin
import Functor
import Applicative
import Monad
import Prelude exposing (..)
import Primitive exposing (type bool(..))
import Literal
import Num exposing (Num)
import Lift exposing (Lift)
import Option exposing (type option(..))
import Cons exposing (type cons(..))

type choiceTree = Choice int | Group (cons choiceTree)
type prng = Seeded bytes (cons choiceTree) | Replayed (cons choiceTree) (cons choiceTree) | Rebuilding (list int) (cons choiceTree)
type alias generator 'a = prng -> option ('a, prng)

reverse values = reverseOnto values Nil
reverseOnto values result =
    case values of
        Nil -> result
        Cons first rest -> reverseOnto rest (Cons first result)

choice : Lift int 'n => 'n -> generator int
choice bound = choiceInt (lower bound)

choiceInt : int -> generator int
choiceInt bound state =
    if bound < 0 || bound > 18446744073709551615 then
        (fail "Prop.choice bound must be in 0..18446744073709551615")
    else
        case state of
            Seeded seed recorded ->
                let
                    seed2 = Builtin.blake2b_256 seed
                    value = Builtin.byteStringToInteger True seed2 % (bound + 1)
                in
                Some (value, Seeded seed2 (Cons (Choice value) recorded))
            Rebuilding remaining recorded ->
                case remaining of
                    value :: rest ->
                        if value < 0 || value > bound then None
                        else Some (value, Rebuilding rest (Cons (Choice value) recorded))
                    [] -> None
            Replayed remaining recorded ->
                case remaining of
                    Cons (Choice value) rest ->
                        if value < 0 || value > bound then None
                        else Some (value, Replayed rest (Cons (Choice value) recorded))
                    _ -> None

group : generator 'a -> generator 'a
group generator state =
    case state of
        Seeded seed recorded ->
            case generator (Seeded seed Nil) of
                Some (value, Seeded next children) ->
                    Some (value, Seeded next (Cons (Group (reverse children)) recorded))
                _ -> None
        Rebuilding remaining recorded ->
            case generator (Rebuilding remaining Nil) of
                Some (value, Rebuilding rest children) ->
                    Some (value, Rebuilding rest (Cons (Group (reverse children)) recorded))
                _ -> None
        Replayed remaining recorded ->
            case remaining of
                Cons (Group children) rest ->
                    case generator (Replayed children Nil) of
                        Some (value, Replayed _ used) ->
                            Some (value, Replayed rest (Cons (Group (reverse used)) recorded))
                        _ -> None
                _ -> None

impl Functor.Functor generator where
    map f generator state =
        case generator state of
            None -> None
            Some (value, next) -> Some (f value, next)

impl Applicative.Applicative generator where
    pure = constant
    apply functions values state =
        case group functions state of
            None -> None
            Some (f, next) ->
                case group values next of
                    None -> None
                    Some (value, final) -> Some (f value, final)

impl Monad.Monad generator where
    bind generator continuation state =
        case group generator state of
            None -> None
            Some (value, next) -> continuation value next

constant : 'a -> generator 'a
constant a prng = Some (a, prng)

intBetween : (Lift int 'a, Lift int 'b) => 'a -> 'b -> generator int
intBetween low high = intBetweenInt (lower low) (lower high)

intBetweenInt : int -> int -> generator int
intBetweenInt lo hi =
    if hi < lo then (fail "Prop.intBetween has reversed bounds")
    else if hi == lo then constant lo
    else
        let draw = choice (hi - lo) in
        \state ->
            case draw state of
                None -> None
                Some (n, next) -> Some (lo + n, next)

-- Signed 64-bit values, with small-width draws favored.
int : generator int
int state =
    case choice 2 state of
        None -> None
        Some (width, next) ->
            case width of
                0 -> choice 255 next
                1 -> intBetween -32768 32767 next
                _ -> intBetween -9223372036854775808 9223372036854775807 next

listOf : generator 'a -> generator (list 'a)
listOf = listBetween 0 20

listBetween : (Lift int 'l, Lift int 'h) => 'l -> 'h -> generator 'a -> generator (list 'a)
listBetween low high generator = listBetweenInt (lower low) (lower high) generator

listBetweenInt : int -> int -> generator 'a -> generator (list 'a)
listBetweenInt lo hi item =
    if lo < 0 || hi < lo then (fail "Prop.listBetween has invalid bounds")
    else listFrom 0 lo hi item

listFrom : int -> int -> int -> generator 'a -> generator (list 'a)
listFrom n lo hi item =
    if n >= hi then Applicative.pure []
    else
        do
            step <- listIteration (n < lo) item
            case step of
                None -> Applicative.pure []
                Some value ->
                    Functor.map (Builtin.mkCons value) (listFrom (n + 1) lo hi item)

listIteration : bool -> generator 'a -> generator (option 'a)
listIteration required item state = do
    (continue, next) <- (if required then constant 1 else choice 1) state
    case continue of
        0 -> Some (None, next)
        _ -> (Functor.map Some (group item)) next

tuple2 : generator 'a -> generator 'b -> generator ('a, 'b)
tuple2 first second state =
    case group first state of
        None -> None
        Some (a, next) ->
            case group second next of
                None -> None
                Some (b, final) -> Some ((a, b), final)

-- Generators contain functions, so use the Term-representation Cons list.
oneOf : cons (generator 'a) -> generator 'a
oneOf generators =
    case generators of
        Nil -> \_ -> None
        Cons _ _ ->
            let draw = choice (Cons.length generators - 1) in
            \state ->
                case draw state of
                    None -> None
                    Some (n, next) -> pick n generators next

pick : int -> cons (generator 'a) -> generator 'a
pick index generators =
    case generators of
        Nil -> \_ -> None
        Cons first rest -> if index == 0 then group first else pick (index - 1) rest

bytes : generator bytes
bytes = Functor.map packBytes (listBetween 0 32 (choice 255))

packBytes : list int -> bytes
packBytes values =
    case values of
        [] -> #""
        x :: xs -> Builtin.consByteString x (packBytes xs)
