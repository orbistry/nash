module Prop exposing (type prng(..), type generator, run, choice, constant, intBetween, int, listOf, listBetween, tuple2, oneOf, bytes, map, bind)

import Builtin

import Prelude exposing (..)
import Primitive exposing (type bool(..))
import Literal
import Num exposing (Num)
import Lift exposing (Lift)
import Option exposing (type option(..))
import Functor exposing (Functor)
import Applicative exposing (Applicative)
import Monad exposing (Monad)
import Cons exposing (type cons(..))

type prng = Seeded bytes (list int) | Replayed (list int)
type alias generator 'a = prng -> option ('a, prng)

run : generator 'a -> prng -> option ('a, prng)
run f = f

-- The runner stores each primitive choice in a u64.
choice : Lift int 'n => 'n -> generator int
choice bound = choiceInt (lower bound)

choiceInt : int -> generator int
choiceInt bound prng =
    if bound < 0 || bound > 18446744073709551615 then
        (fail "Prop.choice bound must be in 0..18446744073709551615")
    else
        case prng of
            Seeded seed choices ->
                let
                    seed2 = Builtin.blake2b_256 seed
                    n = Builtin.byteStringToInteger True seed2 % (bound + 1)
                in
                Some (n, Seeded seed2 (Builtin.mkCons n choices))
            Replayed choices ->
                case choices of
                    [] -> None
                    n :: rest ->
                        if n < 0 || n > bound then None
                        else Some (n, Replayed rest)

map : ('a -> 'b) -> generator 'a -> generator 'b
map f g prng =
    case g prng of
        None -> None
        Some (a, next) -> Some (f a, next)

bind : generator 'a -> ('a -> generator 'b) -> generator 'b
bind g k prng =
    case g prng of
        None -> None
        Some (a, next) -> k a next

impl Functor generator where
    map = mapGenerator

mapGenerator : ('a -> 'b) -> generator 'a -> generator 'b
mapGenerator = map

impl Applicative generator where
    pure = constant
    apply ff fa = bind ff (\f -> map f fa)

impl Monad generator where
    bind = bindGenerator

bindGenerator : generator 'a -> ('a -> generator 'b) -> generator 'b
bindGenerator = bind

constant : 'a -> generator 'a
constant a prng = Some (a, prng)

intBetween : (Lift int 'a, Lift int 'b) => 'a -> 'b -> generator int
intBetween low high = intBetweenInt (lower low) (lower high)

intBetweenInt : int -> int -> generator int
intBetweenInt lo hi =
    if hi < lo then (fail "Prop.intBetween has reversed bounds")
    else if hi == lo then constant lo
    else map (\n -> lo + n) (choice (hi - lo))

-- Signed 64-bit values, with small-width draws favored.
int : generator int
int =
    bind (choice 2) (\width ->
        case width of
            0 -> choice 255
            1 -> intBetween -32768 32767
            _ -> intBetween -9223372036854775808 9223372036854775807)

listOf : generator 'a -> generator (list 'a)
listOf = listBetween 0 20

listBetween : (Lift int 'l, Lift int 'h) => 'l -> 'h -> generator 'a -> generator (list 'a)
listBetween low high generator = listBetweenInt (lower low) (lower high) generator

listBetweenInt : int -> int -> generator 'a -> generator (list 'a)
listBetweenInt lo hi item =
    if lo < 0 || hi < lo then (fail "Prop.listBetween has invalid bounds")
    else listFrom 0 lo hi item

listFrom : int -> int -> int -> generator 'a -> generator (list 'a)
listFrom n lo hi item =
    if n >= hi then constant []
    else if n < lo then listMore n lo hi item
    else bind (choice 1) (\continue ->
        if continue == 0 then constant [] else listMore n lo hi item)

listMore : int -> int -> int -> generator 'a -> generator (list 'a)
listMore n lo hi item =
    bind item (\x -> map (\xs -> Builtin.mkCons x xs) (listFrom (n + 1) lo hi item))

tuple2 : generator 'a -> generator 'b -> generator ('a, 'b)
tuple2 first second = bind first (\a -> map (\b -> (a, b)) second)

-- Generators contain functions, so use the Term-representation Cons list.
oneOf : cons (generator 'a) -> generator 'a
oneOf generators =
    case generators of
        Nil -> (fail "Prop.oneOf requires a generator")
        Cons _ _ -> bind (choice (Cons.length generators - 1)) (\n -> pick n generators)

pick : int -> cons (generator 'a) -> generator 'a
pick index generators =
    case generators of
        Nil -> (fail "Prop.oneOf index out of range")
        Cons first rest -> if index == 0 then first else pick (index - 1) rest

bytes : generator bytes
bytes = map packBytes (listBetween 0 32 (choice 255))

packBytes : list int -> bytes
packBytes values =
    case values of
        [] -> #""
        x :: xs -> Builtin.consByteString x (packBytes xs)
