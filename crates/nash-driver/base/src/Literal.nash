module Literal exposing ( FromInt, FromString, FromBytes, FromBool, FromUnit )


import Primitive exposing (..)
import Builtin exposing (..)


{-| Interpret an integer literal as the requested type. -}
trait FromInt 'a where
    fromInt : int -> 'a


{-| Interpret a string literal as the requested type. -}
trait FromString 'a where
    fromString : string -> 'a


{-| Interpret a bytes literal as the requested type. -}
trait FromBytes 'a where
    fromBytes : bytes -> 'a


impl FromInt int where
    fromInt value = value


impl FromString string where
    fromString value = value


impl FromBytes bytes where
    fromBytes value = value


impl FromInt Int where
    fromInt = Builtin.iData


impl FromBytes Bytes where
    fromBytes = Builtin.bData


impl FromString bytes where
    fromString = Builtin.encodeUtf8


{-| Interpret a Boolean literal as the requested type. -}
trait FromBool 'a where
    fromBool : bool -> 'a


{-| Interpret a unit literal as the requested type. -}
trait FromUnit 'a where
    fromUnit : unit -> 'a


impl FromBool bool where
    fromBool value = value


impl FromUnit unit where
    fromUnit value = value
