module Functor exposing ( Functor )


import Builtin


{-| Map a function over the contents of a little container. -}
trait Functor 'f where
    map : ('a -> 'b) -> 'f 'a -> 'f 'b


impl Functor list where
    map = mapList


mapList : ('a -> 'b) -> list 'a -> list 'b
mapList f values =
    case values of
        [] ->
            []

        x :: xs ->
            Builtin.mkCons (f x) (mapList f xs)
