        doc: "Constant representation; kind `Type`."
    - Declaration:
        name: value
        kind: Primitive
        signature: type value
        type_kind: Type
        doc: "Constant representation; kind `Type`."
    - Declaration:
        name: list
        kind: Primitive
        signature: "type list 'a"
        type_kind: Type -> Type
        doc: "Constant representation; kind `Type -> Type`. Parameter 1 requires `Storable`."
    - Declaration:
        name: array
        kind: Primitive
        signature: "type array 'a"
        type_kind: Type -> Type
        doc: "Constant representation; kind `Type -> Type`. Parameter 1 requires `Storable`."
    - Declaration:
        name: pair
        kind: Primitive
        signature: "type pair 'a 'b"
        type_kind: Type -> Type -> Type
        doc: "Constant representation; kind `Type -> Type -> Type`. Parameter 1 requires `Storable`. Parameter 2 requires `Storable`."
    - Declaration:
        name: Big
        kind: Trait
        signature: "trait Big 'a"
        type_kind: ~
