- name: Primitive
  blocks:
    - Declaration:
        name: Data
        kind: Primitive
        signature: type Data = Constr (pair int (list Data)) | Map (list (pair Data Data)) | List (list Data) | I int | B bytes
        type_kind: Type
        doc: "Data representation; kind `Type`."
    - Declaration:
        name: Int
        kind: Primitive
        signature: type Int
        type_kind: Type
        doc: "Data representation; kind `Type`."
    - Declaration:
        name: Bytes
        kind: Primitive
        signature: type Bytes
        type_kind: Type
        doc: "Data representation; kind `Type`."
    - Declaration:
        name: List
        kind: Primitive
        signature: "type List 'a"
        type_kind: Type -> Type
        doc: "Data representation; kind `Type -> Type`. Parameter 1 requires `Big`."
    - Declaration:
        name: Map
        kind: Primitive
        signature: "type Map 'a 'b"
        type_kind: Type -> Type -> Type
        doc: "Data representation; kind `Type -> Type -> Type`. Parameter 1 requires `Big`. Parameter 2 requires `Big`."
    - Declaration:
        name: int
        kind: Primitive
        signature: type int
        type_kind: Type
        doc: "Constant representation; kind `Type`."
    - Declaration:
        name: bytes
        kind: Primitive
        signature: type bytes
        type_kind: Type
        doc: "Constant representation; kind `Type`."
    - Declaration:
