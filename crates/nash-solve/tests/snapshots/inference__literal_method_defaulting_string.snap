---
source: crates/nash-solve/tests/inference.rs
description: "module Literal exposing (..)\nimport Primitive exposing (..)\nimport Builtin exposing (..)\ntrait FromString 'a where\n    fromString : string -> 'a\nimpl FromString string where\n    fromString x = x\n\n\nmodule Main exposing (..)\nimport Primitive exposing (..)\nimport Builtin exposing (..)\nimport Literal exposing (FromString, fromString)\ntype Box 'a = Box 'a\ntrait Permit 'a where\n    permit : 'a -> 'a\ntrait Gate 'a 'b where\n    gate : 'a -> 'b -> string\nimpl Permit 'a => Gate string (Box 'a) where\n    gate x box = x\nsame : 'a -> 'a -> 'a\nsame x y = x\nrun : Permit 'a => string -> Box 'a -> string\nrun n box = gate (same (fromString n) (fromString n)) box\ntype option 'a = None | Some 'a\ntrait Seed 'a where\n    seed : string -> 'a\nimpl Seed string where\n    seed n = n\ntrait Step 'a 'b where\n    step : 'a -> 'b -> string\nimpl FromString 'a => Step string (option 'a) where\n    step x box = x\nchain n = step (fromString n) (Some (seed n))\n"
---
chain : string -> string
run : forall a. (Permit a, Big a) => string -> Box a -> string
same : forall a. a -> a -> a
