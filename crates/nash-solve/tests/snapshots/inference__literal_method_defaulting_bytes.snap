---
source: crates/nash-solve/tests/inference.rs
description: "module Literal exposing (..)\nimport Builtin exposing (..)\ntrait FromInt 'a where\n    fromInt : int -> 'a\nimpl FromInt int where\n    fromInt x = x\n\n\nmodule Main exposing (..)\nimport Builtin exposing (..)\nimport Literal exposing (FromInt, fromInt)\ntype Box 'a = Box 'a\ntrait Permit 'a where\n    permit : 'a -> 'a\ntrait Gate 'a 'b where\n    gate : 'a -> 'b -> ()\nimpl Permit 'a => Gate int (Box 'a) where\n    gate x box = ()\nsame : 'a -> 'a -> 'a\nsame x y = x\nrun : Permit 'a => int -> Box 'a -> ()\nrun n box = gate (same (fromInt n) (fromInt n)) box\ntype option 'a = None | Some 'a\ntrait Seed 'a where\n    seed : int -> 'a\nimpl Seed int where\n    seed n = n\ntrait Step 'a 'b where\n    step : 'a -> 'b -> ()\nimpl FromInt 'a => Step int (option 'a) where\n    step x box = ()\nchain n = step (fromInt n) (Some (seed n))\n\n\nmodule Literal exposing (..)\nimport Builtin exposing (..)\ntrait FromString 'a where\n    fromString : string -> 'a\nimpl FromString string where\n    fromString x = x\n\n\nmodule Main exposing (..)\nimport Builtin exposing (..)\nimport Literal exposing (FromString, fromString)\ntype Box 'a = Box 'a\ntrait Permit 'a where\n    permit : 'a -> 'a\ntrait Gate 'a 'b where\n    gate : 'a -> 'b -> ()\nimpl Permit 'a => Gate string (Box 'a) where\n    gate x box = ()\nsame : 'a -> 'a -> 'a\nsame x y = x\nrun : Permit 'a => string -> Box 'a -> ()\nrun n box = gate (same (fromString n) (fromString n)) box\ntype option 'a = None | Some 'a\ntrait Seed 'a where\n    seed : string -> 'a\nimpl Seed string where\n    seed n = n\ntrait Step 'a 'b where\n    step : 'a -> 'b -> ()\nimpl FromString 'a => Step string (option 'a) where\n    step x box = ()\nchain n = step (fromString n) (Some (seed n))\n\n\nmodule Literal exposing (..)\nimport Builtin exposing (..)\ntrait FromBytes 'a where\n    fromBytes : bytes -> 'a\nimpl FromBytes bytes where\n    fromBytes x = x\n\n\nmodule Main exposing (..)\nimport Builtin exposing (..)\nimport Literal exposing (FromBytes, fromBytes)\ntype Box 'a = Box 'a\ntrait Permit 'a where\n    permit : 'a -> 'a\ntrait Gate 'a 'b where\n    gate : 'a -> 'b -> ()\nimpl Permit 'a => Gate bytes (Box 'a) where\n    gate x box = ()\nsame : 'a -> 'a -> 'a\nsame x y = x\nrun : Permit 'a => bytes -> Box 'a -> ()\nrun n box = gate (same (fromBytes n) (fromBytes n)) box\ntype option 'a = None | Some 'a\ntrait Seed 'a where\n    seed : bytes -> 'a\nimpl Seed bytes where\n    seed n = n\ntrait Step 'a 'b where\n    step : 'a -> 'b -> ()\nimpl FromBytes 'a => Step bytes (option 'a) where\n    step x box = ()\nchain n = step (fromBytes n) (Some (seed n))\n"
---
chain : bytes -> unit
run : forall a. (Permit a, Big a) => bytes -> Box a -> unit
same : forall a. a -> a -> a
