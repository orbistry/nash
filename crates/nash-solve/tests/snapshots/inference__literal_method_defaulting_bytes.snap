---
source: crates/nash-solve/tests/inference.rs
description: "module Literal exposing (..)\nimport Primitive exposing (..)\nimport Builtin exposing (..)\ntrait FromBytes 'a where\n    fromBytes : bytes -> 'a\nimpl FromBytes bytes where\n    fromBytes x = x\n\n\nmodule Main exposing (..)\nimport Primitive exposing (..)\nimport Builtin exposing (..)\nimport Literal exposing (FromBytes, fromBytes)\ntype Box 'a = Box 'a\ntrait Permit 'a where\n    permit : 'a -> 'a\ntrait Gate 'a 'b where\n    gate : 'a -> 'b -> bytes\nimpl Permit 'a => Gate bytes (Box 'a) where\n    gate x box = x\nsame : 'a -> 'a -> 'a\nsame x y = x\nrun : Permit 'a => bytes -> Box 'a -> bytes\nrun n box = gate (same (fromBytes n) (fromBytes n)) box\ntype option 'a = None | Some 'a\ntrait Seed 'a where\n    seed : bytes -> 'a\nimpl Seed bytes where\n    seed n = n\ntrait Step 'a 'b where\n    step : 'a -> 'b -> bytes\nimpl FromBytes 'a => Step bytes (option 'a) where\n    step x box = x\nchain n = step (fromBytes n) (Some (seed n))\n"
---
chain : bytes -> bytes
run : forall a. (Permit a, Big a) => bytes -> Box a -> bytes
same : forall a. a -> a -> a
