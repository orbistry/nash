source: crates/nash-solve/tests/inference.rs
description: "module Num exposing (Num)\ntrait Num 'a where\n    negate : 'a -> 'a\n\n\nmodule Main exposing (..)\nimport Num as N\nimport Literal exposing (..)\nnegate x = x\nflip x = -x\nnegative = -7\n"
---
flip : forall a. Num a => a -> a
negate : forall a. a -> a
negative : forall a. (Num a, FromInt a) => a
