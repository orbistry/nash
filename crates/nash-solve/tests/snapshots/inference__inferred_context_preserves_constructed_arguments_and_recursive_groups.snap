---
source: crates/nash-solve/tests/inference.rs
description: "Code:\n\nmodule Main exposing (..)\ntrait Observe 'a where\n    observe : 'a -> ()\nimpl Observe 'a => Observe (List 'a) where\n    observe xs = ()\ntrait Keep 'a where\n    keep : 'a -> 'a\nobserveList x = observe [x]\nfirst x = keep (second x)\nsecond x = first x\n"
---
first : forall (a : Any) (b : Any). Keep a => b -> a
observeList : forall (a : Big). Observe a => a -> ()
second : forall (a : Any) (b : Any). Keep a => b -> a
