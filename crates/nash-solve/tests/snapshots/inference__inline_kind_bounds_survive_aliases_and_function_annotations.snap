---
source: crates/nash-solve/tests/inference.rs
description: "Code:\n\nmodule Main exposing (..)\ntype alias Record 'a = ({ field : ('a : Big) } : Big)\nwrap : (('a : Big) -> Record 'a : Term)\nwrap x = Record x\nidentity : ('a : Big) -> 'a\nidentity x = x\npreserve : Record 'a -> Record 'a\npreserve x = identity x\n"
---
identity : forall (a : Big). a -> a
preserve : forall (a : Big). Record a -> Record a
wrap : forall (a : Big). a -> Record a
