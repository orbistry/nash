---
source: crates/nash-solve/tests/inference.rs
description: "Code:\n\nmodule Main exposing (..)\ntype option 'a = Some 'a\ntrait Keep 'a where\n    keep : 'a -> 'a\nimpl Keep () where\n    keep x = x\nimpl Keep 'a => Keep (option 'a) where\n    keep xs = xs\nsame : Keep 'a => 'a -> ()\nsame x = same x\nclosed : Keep 'a => 'a -> ()\nclosed x = closed ()\nplain : 'a -> ()\nplain x = plain (Some x)\nwrap : Keep 'a => 'a -> option 'a\nwrap x = keep (Some x)\nreset : (Keep 'a, Keep 'b) => 'a -> 'b -> ()\nreset x y = reset (Some y) ()\nnested : Keep 'a => 'a -> ()\nnested x =\n    let\n        helper : Keep 'b => 'b -> ()\n        helper y = nested (Some y)\n    in\n    helper ()\n"
---
closed : forall (a : Any). Keep a => a -> ()
nested : forall (a : Any). Keep a => a -> ()
plain : forall (a : Any). a -> ()
reset : forall (a : Any) (b : Any). (Keep a, Keep b) => a -> b -> ()
same : forall (a : Any). Keep a => a -> ()
wrap : forall (a : Any). Keep a => a -> option a
