source: crates/nash-solve/tests/inference.rs
description: "Code:\n\nmodule Main exposing (..)\ntrait Functor 'f where\n    map : ('a -> 'b) -> 'f 'a -> 'f 'b\ntrait Functor 'f => Applicative 'f where\n    pure : 'a -> 'f 'a\ntrait Applicative 'm => Monad 'm where\n    bind : 'm 'a -> ('a -> 'm 'b) -> 'm 'b\nchain f g mx = bind (bind mx f) g\n"
---
chain : forall (a : Any) (a1 : Any) b (m : Arrow). Monad m => [KindApplication { head: Var(3), arguments: [Var(4)], result: Var(5) }, KindApplication { head: Var(3), arguments: [Var(6)], result: Var(7) }, KindApplication { head: Var(3), arguments: [Var(8)], result: Var(9) }, KindApplication { head: Var(3), arguments: [Var(10)], result: Var(11) }, KindApplication { head: Var(3), arguments: [Var(12)], result: Var(13) }, KindApplication { head: Var(3), arguments: [Var(1)], result: Var(14) }, KindApplication { head: Var(3), arguments: [Var(2)], result: Var(15) }, KindApplication { head: Var(3), arguments: [Var(16)], result: Var(17) }, KindApplication { head: Var(3), arguments: [Var(18)], result: Var(19) }, KindApplication { head: Var(3), arguments: [Var(20)], result: Var(21) }, KindApplication { head: Var(3), arguments: [Var(22)], result: Var(23) }, KindApplication { head: Var(3), arguments: [Var(24)], result: Var(25) }, KindApplication { head: Var(3), arguments: [Var(0)], result: Var(26) }] => (a -> m a1) -> (a1 -> m b) -> m a -> m b
