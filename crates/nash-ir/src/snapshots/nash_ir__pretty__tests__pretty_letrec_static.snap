---
source: crates/nash-ir/src/pretty.rs
description: "LetRec {\n    binders: [\n        RecBinder {\n            binder: Binder {\n                name: Name {\n                    text: \"loop\",\n                    unique: 1,\n                },\n                ty: Term(\n                    Fun(\n                        [\n                            Const(\n                                Int,\n                            ),\n                            Const(\n                                Int,\n                            ),\n                        ],\n                        Const(\n                            Int,\n                        ),\n                    ),\n                ),\n            },\n            params: [\n                Binder {\n                    name: Name {\n                        text: \"step\",\n                        unique: 2,\n                    },\n                    ty: Const(\n                        Int,\n                    ),\n                },\n                Binder {\n                    name: Name {\n                        text: \"n\",\n                        unique: 3,\n                    },\n                    ty: Const(\n                        Int,\n                    ),\n                },\n            ],\n            static_params: [\n                0,\n            ],\n            body: App {\n                func: Var(\n                    Name {\n                        text: \"loop\",\n                        unique: 1,\n                    },\n                ),\n                args: [\n                    Var(\n                        Name {\n                            text: \"step\",\n                            unique: 2,\n                        },\n                    ),\n                    Builtin {\n                        func: SubtractInteger,\n                        args: [\n                            Var(\n                                Name {\n                                    text: \"n\",\n                                    unique: 3,\n                                },\n                            ),\n                            Var(\n                                Name {\n                                    text: \"step\",\n                                    unique: 2,\n                                },\n                            ),\n                        ],\n                    },\n                ],\n            },\n        },\n    ],\n    body: App {\n        func: Var(\n            Name {\n                text: \"loop\",\n                unique: 1,\n            },\n        ),\n        args: [\n            Lit(\n                Integer(\n                    1,\n                ),\n            ),\n            Lit(\n                Integer(\n                    5,\n                ),\n            ),\n        ],\n    },\n}"
---
letrec
  loop#1 : int -> int -> int [static [0]] = \step#2 : int n#3 : int -> loop#1 step#2 (subtractInteger n#3 step#2)
in
loop#1 1 5
