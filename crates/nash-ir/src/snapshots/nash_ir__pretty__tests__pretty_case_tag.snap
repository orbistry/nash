---
source: crates/nash-ir/src/pretty.rs
description: "Case {\n    kind: Tag,\n    scrutinee: Var(\n        Name {\n            text: \"s\",\n            unique: 1,\n        },\n    ),\n    branches: [\n        Branch {\n            test: Tag(\n                0,\n            ),\n            binders: [\n                Binder {\n                    name: Name {\n                        text: \"a\",\n                        unique: 2,\n                    },\n                    ty: Const(\n                        Int,\n                    ),\n                },\n            ],\n            body: Var(\n                Name {\n                    text: \"a\",\n                    unique: 2,\n                },\n            ),\n        },\n        Branch {\n            test: Tag(\n                1,\n            ),\n            binders: [\n                Binder {\n                    name: Name {\n                        text: \"n\",\n                        unique: 3,\n                    },\n                    ty: Const(\n                        Int,\n                    ),\n                },\n                Binder {\n                    name: Name {\n                        text: \"a\",\n                        unique: 4,\n                    },\n                    ty: Const(\n                        Int,\n                    ),\n                },\n            ],\n            body: Var(\n                Name {\n                    text: \"a\",\n                    unique: 4,\n                },\n            ),\n        },\n    ],\n    default: None,\n}"
---
case@Tag s#1 of
  0 a#2 -> a#2
  1 n#3 a#4 -> a#4
