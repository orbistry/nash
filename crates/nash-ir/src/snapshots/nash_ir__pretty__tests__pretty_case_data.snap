---
source: crates/nash-ir/src/pretty.rs
description: "Case {\n    kind: Data,\n    scrutinee: Var(\n        Name {\n            text: \"data\",\n            unique: 1,\n        },\n    ),\n    branches: [\n        Branch {\n            test: DataConstr,\n            binders: [\n                Binder {\n                    name: Name {\n                        text: \"pair\",\n                        unique: 8,\n                    },\n                    ty: Const(\n                        Pair(\n                            Const(\n                                Int,\n                            ),\n                            Const(\n                                List(\n                                    Big(\n                                        Data,\n                                    ),\n                                ),\n                            ),\n                        ),\n                    ),\n                },\n            ],\n            body: Case {\n                kind: Pair,\n                scrutinee: Var(\n                    Name {\n                        text: \"pair\",\n                        unique: 8,\n                    },\n                ),\n                branches: [\n                    Branch {\n                        test: Pair,\n                        binders: [\n                            Binder {\n                                name: Name {\n                                    text: \"tag\",\n                                    unique: 2,\n                                },\n                                ty: Const(\n                                    Int,\n                                ),\n                            },\n                            Binder {\n                                name: Name {\n                                    text: \"fields\",\n                                    unique: 3,\n                                },\n                                ty: Const(\n                                    List(\n                                        Big(\n                                            Data,\n                                        ),\n                                    ),\n                                ),\n                            },\n                        ],\n                        body: Lit(\n                            Integer(\n                                0,\n                            ),\n                        ),\n                    },\n                ],\n                default: None,\n            },\n        },\n        Branch {\n            test: DataMap,\n            binders: [\n                Binder {\n                    name: Name {\n                        text: \"map\",\n                        unique: 4,\n                    },\n                    ty: Const(\n                        List(\n                            Const(\n                                Pair(\n                                    Big(\n                                        Data,\n                                    ),\n                                    Big(\n                                        Data,\n                                    ),\n                                ),\n                            ),\n                        ),\n                    ),\n                },\n            ],\n            body: Lit(\n                Integer(\n                    1,\n                ),\n            ),\n        },\n        Branch {\n            test: DataList,\n            binders: [\n                Binder {\n                    name: Name {\n                        text: \"list\",\n                        unique: 5,\n                    },\n                    ty: Const(\n                        List(\n                            Big(\n                                Data,\n                            ),\n                        ),\n                    ),\n                },\n            ],\n            body: Lit(\n                Integer(\n                    2,\n                ),\n            ),\n        },\n        Branch {\n            test: DataI,\n            binders: [\n                Binder {\n                    name: Name {\n                        text: \"integer\",\n                        unique: 6,\n                    },\n                    ty: Const(\n                        Int,\n                    ),\n                },\n            ],\n            body: Lit(\n                Integer(\n                    3,\n                ),\n            ),\n        },\n        Branch {\n            test: DataB,\n            binders: [\n                Binder {\n                    name: Name {\n                        text: \"bytes\",\n                        unique: 7,\n                    },\n                    ty: Const(\n                        Bytes,\n                    ),\n                },\n            ],\n            body: Lit(\n                Integer(\n                    4,\n                ),\n            ),\n        },\n    ],\n    default: Some(\n        Error,\n    ),\n}"
---
case@Data data#1 of
  DataConstr pair#8 -> case@Pair pair#8 of
    Pair tag#2 fields#3 -> 0
  DataMap map#4 -> 1
  DataList list#5 -> 2
  DataI integer#6 -> 3
  DataB bytes#7 -> 4
  _ -> error
