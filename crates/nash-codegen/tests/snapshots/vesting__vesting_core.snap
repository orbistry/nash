  DataMap field#90 -> force leaf#75
  DataList field#91 -> force leaf#75
  DataI field#92 -> force leaf#75
  DataB field#93 -> force leaf#75 in
let main#1 : Vesting.Datum -> Vesting.Redeemer -> Data -> unit = \datum#2 : Vesting.Datum redeemer#3 : Vesting.Redeemer ctx#4 : Data -> let match#8 : Vesting.Redeemer = redeemer#3 in
case@Data match#8 of
  DataConstr tag#9 fields#10 -> case@Int tag#9 of
    0 -> let projection#95 : pair int (list Data) = unConstrData datum#2 in
    let projection#96 : list Data = sndPair projection#95 in
    let projection#97 : list Data = tailList projection#96 in
    let projection#98 : Data = headList projection#97 in
    case@Bool lessThanInteger (lower#5 projection#98) (currentSlot#6 ctx#4) of
