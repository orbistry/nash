        DataConstr field#83 field#84 -> force leaf#76
        DataMap field#85 -> force leaf#76
        DataList field#86 -> force leaf#76
        DataI field#87 -> force leaf#76
        DataB field#88 -> case@List field#82 of
          Nil -> let signer#55 : bytes = field#88 in
          equalsByteString signer#55 (lower#56 owner#54)
          Cons field#89 field#90 -> force leaf#76
  DataMap field#91 -> force leaf#76
  DataList field#92 -> force leaf#76
  DataI field#93 -> force leaf#76
  DataB field#94 -> force leaf#76 in
let main#1 : Vesting.Datum -> Vesting.Redeemer -> Data -> unit = \datum#2 : Vesting.Datum redeemer#3 : Vesting.Redeemer ctx#4 : Data -> let match#8 : Vesting.Redeemer = redeemer#3 in
case@Data match#8 of
  DataConstr tag#9 fields#10 -> case@Int tag#9 of
    0 -> let projection#97 : pair int (list Data) = unConstrData datum#2 in
    let projection#98 : list Data = sndPair projection#97 in
    let projection#99 : list Data = tailList projection#98 in
    let projection#100 : Data = headList projection#99 in
    case@Bool lessThanInteger (lower#5 projection#100) (currentSlot#6 ctx#4) of
      True -> ()
      False -> trace message#104 in error
    1 -> let projection#101 : pair int (list Data) = unConstrData datum#2 in
    let projection#102 : list Data = sndPair projection#101 in
    let projection#103 : Data = headList projection#102 in
    case@Bool signedBy#7 ctx#4 projection#103 of
      True -> ()
      False -> trace message#104 in error
    _ -> trace message#105 in error
  _ -> trace message#105 in error in
main#1
