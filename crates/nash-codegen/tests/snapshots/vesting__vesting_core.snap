---
source: crates/nash-codegen/tests/vesting.rs
description: "module Literal exposing (..)\n\nimport Builtin exposing (..)\n\ntrait FromInt 'a where\n    fromInt : int -> 'a\n\ntrait FromString 'a where\n    fromString : string -> 'a\n\ntrait FromBytes 'a where\n    fromBytes : bytes -> 'a\n\nimpl FromInt int where\n    fromInt x = x\n\nimpl FromString string where\n    fromString x = x\n\nimpl FromBytes bytes where\n    fromBytes x = x\n\nmodule Lift exposing (..)\n\nimport Builtin exposing (..)\n\ntrait Lift 'a 'b where\n    lift : 'a -> 'b\n    lower : 'b -> 'a\n\nimpl Lift int Int where\n    lift value = Builtin.castLift value\n    lower value = Builtin.castLower value\n\nimpl Lift bytes Bytes where\n    lift value = Builtin.castLift value\n    lower value = Builtin.castLower value\n\nmodule Cardano.Tx exposing (currentSlot, signedBy)\n\nimport Builtin exposing (..)\nimport Lift exposing (lower)\n\n-- Test contexts encode the current slot and one signer as two Data fields.\ncurrentSlot : Data -> int\ncurrentSlot ctx =\n    case ctx of\n        Constr _ [ I slot, _ ] -> slot\n        _ -> fail\n\nsignedBy : Data -> Bytes -> bool\nsignedBy ctx owner =\n    case ctx of\n        Constr _ [ _, B signer ] -> Builtin.equalsByteString signer (lower owner)\n        _ -> fail\n\nvalidator module Vesting exposing (main)\n\nimport Builtin exposing (..)\nimport Lift exposing (lower)\nimport Cardano.Tx exposing (currentSlot, signedBy)\n\ntype Datum = Datum { owner : Bytes, deadline : Int }\n\ntype step 'a = Done 'a | Next int 'a\n\ntype alias acc = { total : int, seen : list Int }\n\ntype Redeemer = Claim | Cancel\n\nmain : Datum -> Redeemer -> Data -> unit\nmain datum redeemer ctx =\n    case redeemer of\n        Claim -> assert (Builtin.lessThanInteger (lower datum.deadline) (currentSlot ctx))\n        Cancel -> assert (signedBy ctx datum.owner)\n"
---
let message#104 : string = "assertion failed" in
let message#105 : string = "incomplete pattern match" in
let lower#5 : Int -> int = \value#11 : Int -> (\value#12 : Int -> unIData value#12) value#11 in
let currentSlot#6 : Data -> int = \ctx#13 : Data -> let match#15 : Data = ctx#13 in
let leaf#34 : 'erased = delay error in
case@Data match#15 of
  DataConstr field#35 field#36 -> case@List field#36 of
    Nil -> force leaf#34
    Cons field#37 field#38 -> case@Data field#37 of
      DataConstr field#39 field#40 -> force leaf#34
      DataMap field#41 -> force leaf#34
      DataList field#42 -> force leaf#34
      DataI field#43 -> case@List field#38 of
        Nil -> force leaf#34
        Cons field#44 field#45 -> case@List field#45 of
          Nil -> let slot#14 : int = field#43 in
          slot#14
          Cons field#46 field#47 -> force leaf#34
      DataB field#48 -> force leaf#34
  DataMap field#49 -> force leaf#34
  DataList field#50 -> force leaf#34
  DataI field#51 -> force leaf#34
  DataB field#52 -> force leaf#34 in
let lower#56 : Bytes -> bytes = \value#95 : Bytes -> (\value#96 : Bytes -> unBData value#96) value#95 in
let signedBy#7 : Data -> Bytes -> bool = \ctx#53 : Data owner#54 : Bytes -> let match#57 : Data = ctx#53 in
let leaf#76 : 'erased = delay error in
case@Data match#57 of
  DataConstr field#77 field#78 -> case@List field#78 of
    Nil -> force leaf#76
    Cons field#79 field#80 -> case@List field#80 of
      Nil -> force leaf#76
