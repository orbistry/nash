      False -> trace message#102 in error
    1 -> let projection#99 : pair int (list Data) = unConstrData datum#2 in
    let projection#100 : list Data = sndPair projection#99 in
    let projection#101 : Data = headList projection#100 in
    case@Bool signedBy#7 ctx#4 projection#101 of
      True -> ()
      False -> trace message#102 in error
    _ -> trace message#103 in error
  _ -> trace message#103 in error in
main#1
