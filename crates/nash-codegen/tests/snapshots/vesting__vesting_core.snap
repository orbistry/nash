  DataB field#105 -> force leaf#86 in
let main#1 : Vesting.Datum -> Vesting.Redeemer -> Data -> unit = \datum#2 : Vesting.Datum redeemer#3 : Vesting.Redeemer ctx#4 : Data -> let match#12 : Vesting.Redeemer = redeemer#3 in
case@Data match#12 of
