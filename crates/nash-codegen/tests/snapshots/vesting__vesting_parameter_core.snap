      DataI field#43 -> case@List field#38 of
        Nil -> force leaf#34
        Cons field#44 field#45 -> case@List field#45 of
          Nil -> let slot#14 : int = field#43 in
          slot#14
          Cons field#46 field#47 -> force leaf#34
      DataB field#48 -> force leaf#34
  DataMap field#49 -> force leaf#34
  DataList field#50 -> force leaf#34
  DataI field#51 -> force leaf#34
  DataB field#52 -> force leaf#34 in
let lower#56 : Bytes -> bytes = \value#95 : Bytes -> unBData value#95 in
let signedBy#8 : Data -> Bytes -> bool = \ctx#53 : Data owner#54 : Bytes -> let match#57 : Data = ctx#53 in
let leaf#76 : 'erased = delay error in
case@Data match#57 of
  DataConstr field#77 field#78 -> case@List field#78 of
    Nil -> force leaf#76
    Cons field#79 field#80 -> case@List field#80 of
      Nil -> force leaf#76
      Cons field#81 field#82 -> case@Data field#81 of
        DataConstr field#83 field#84 -> force leaf#76
        DataMap field#85 -> force leaf#76
        DataList field#86 -> force leaf#76
        DataI field#87 -> force leaf#76
        DataB field#88 -> case@List field#82 of
          Nil -> let signer#55 : bytes = field#88 in
          equalsByteString signer#55 (lower#56 owner#54)
          Cons field#89 field#90 -> force leaf#76
  DataMap field#91 -> force leaf#76
  DataList field#92 -> force leaf#76
  DataI field#93 -> force leaf#76
  DataB field#94 -> force leaf#76 in
let main#1 : int -> VestingParam.Datum -> VestingParam.Redeemer -> Data -> unit = \minimumLock#2 : int datum#3 : VestingParam.Datum redeemer#4 : VestingParam.Redeemer ctx#5 : Data -> let match#9 : VestingParam.Redeemer = redeemer#4 in
case@Data match#9 of
  DataConstr tag#10 fields#11 -> case@Int tag#10 of
    0 -> let projection#96 : pair int (list Data) = unConstrData datum#3 in
    let projection#97 : list Data = sndPair projection#96 in
    let projection#98 : list Data = tailList projection#97 in
    let projection#99 : Data = headList projection#98 in
    case@Bool lessThanInteger (addInteger (lower#6 projection#99) minimumLock#2) (currentSlot#7 ctx#5) of
      True -> ()
      False -> trace message#103 in error
    1 -> let projection#100 : pair int (list Data) = unConstrData datum#3 in
    let projection#101 : list Data = sndPair projection#100 in
    let projection#102 : Data = headList projection#101 in
    case@Bool signedBy#8 ctx#5 projection#102 of
      True -> ()
      False -> trace message#103 in error
    _ -> trace message#104 in error
  _ -> trace message#104 in error in
main#1
