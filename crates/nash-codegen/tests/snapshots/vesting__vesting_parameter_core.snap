    1 -> let projection#102 : pair int (list Data) = unConstrData datum#3 in
    let projection#103 : list Data = sndPair projection#102 in
    let projection#104 : Data = headList projection#103 in
    case@Bool signedBy#8 ctx#5 projection#104 of
      True -> ()
