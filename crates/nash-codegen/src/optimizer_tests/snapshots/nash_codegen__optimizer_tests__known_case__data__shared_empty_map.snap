payload#32 in
constr 0 data#29 anf#33 anf#34
--- isolated cleaned Core
let data_payload#35 : list (pair Data Data) = (con (list (pair data data)) []) in
constr 0 (con data (Map [])) data_payload#35 data_payload#35
--- isolated UPLC before
(program 1.1.0
  [(lam data_29
    [(lam alias_30
      [(lam anf_33
        [(lam anf_34 (constr 0 data_29 anf_33 anf_34))
          [(lam generated_35
            (force
              [[[[[[(force (builtin chooseData)) generated_35] (delay (error))]
                (delay [(lam payload_32 payload_32) [(builtin unMapData) generated_35]])]
