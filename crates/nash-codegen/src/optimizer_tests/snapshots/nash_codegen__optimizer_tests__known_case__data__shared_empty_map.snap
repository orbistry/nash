---
source: crates/nash-codegen/src/optimizer_tests/known_case.rs
expression: "crate::harness::pass_snapshot(b.arena, original,\nformat!(\"--- isolated ANF input\\n{}\\n--- isolated folded Core\\n{}\\n--- isolated cleaned Core\\n{}\\n--- isolated UPLC before\\n{}\\n--- isolated UPLC after\\n{}\\n--- result\\n{}\\n--- logs\\n{:?}\",\npretty(before), pretty(folded), pretty(after), left.uplc, right.uplc,\nright.result, right.logs))"
---
--- unoptimized Core
let data#29 : Data = (con data (Map [])) in
let alias#30 : Data = data#29 in
constr 0 data#29 (case@Data alias#30 of
  DataMap payload#31 -> payload#31) (case@Data alias#30 of
  DataMap payload#32 -> payload#32)
--- unoptimized UPLC
(program 1.1.0
  [(lam data_29
    [(lam alias_30
      (constr 0
        data_29
        [(lam generated_33
          (force
            [[[[[[(force (builtin chooseData)) generated_33] (delay (error))]
              (delay [(lam payload_31 payload_31) [(builtin unMapData) generated_33]])]
              (delay (error))]
              (delay (error))]
              (delay (error))]))
          alias_30]
        [(lam generated_34
          (force
            [[[[[[(force (builtin chooseData)) generated_34] (delay (error))]
              (delay [(lam payload_32 payload_32) [(builtin unMapData) generated_34]])]
              (delay (error))]
              (delay (error))]
              (delay (error))]))
          alias_30]))
      data_29])
    (con data (Map []))])
--- optimized Core
