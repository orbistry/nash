--- isolated pass
--- isolated ANF input
let data#29 : Data = (con data (Map [])) in
let alias#30 : Data = data#29 in
let anf#33 : list (pair Data Data) = case@Data alias#30 of
  DataMap payload#31 -> payload#31 in
let anf#34 : list (pair Data Data) = case@Data alias#30 of
  DataMap payload#32 -> payload#32 in
constr 0 data#29 anf#33 anf#34
--- isolated folded Core
