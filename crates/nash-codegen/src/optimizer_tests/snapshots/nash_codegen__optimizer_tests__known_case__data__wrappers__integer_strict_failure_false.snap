let data#1 : Data = iData anf#4 in
let effect#3 : int = trace "between" in 0 in
let payload#2 : int = anf#4 in
trace "selected" in 9
--- isolated cleaned Core
let anf#4 : int = trace "operand" in 42 in
let data#1 : Data = iData anf#4 in
let effect#3 : int = trace "between" in 0 in
trace "selected" in 9
--- isolated UPLC before
(program 1.1.0
  [(lam anf_4
    [(lam data_1
      [(lam effect_3
        [(lam generated_5
          (force
            [[[[[[(force (builtin chooseData)) generated_5] (delay (error))] (delay (error))]
              (delay (error))]
              (delay
                (force
                  [[(force (builtin trace)) (con string "selected")] (delay (con integer 9))]))]
              (delay (error))]))
          data_1])
        (force
          [[(force (builtin trace)) (con string "between")] (delay (con integer 0))])])
      [(builtin iData) anf_4]])
    (force
      [[(force (builtin trace)) (con string "operand")] (delay (con integer 42))])])
--- isolated UPLC after
(program 1.1.0
  [(lam anf_4
    [(lam data_1
      [(lam effect_3
        (force
          [[(force (builtin trace)) (con string "selected")] (delay (con integer 9))]))
        (force
          [[(force (builtin trace)) (con string "between")] (delay (con integer 0))])])
