---
source: crates/nash-codegen/src/optimizer_tests/inverse.rs
expression: "crate::harness::pass_snapshot(b.arena, before,\nformat!(\"--- core before\\n{}\\n--- uplc before\\n{}\\n--- core after\\n{}\\n--- uplc after\\n{}\\n--- result\\n{}\\n--- logs\\n{:?}\",\npretty(before), left.uplc, pretty(after), right.uplc, right.result,\nright.logs))"
---
--- unoptimized Core
let x#9 : list Data = trace "once" in (con (list data) [(I 7)]) in
let encoded#10 : Data = listData x#9 in
let alias#11 : Data = encoded#10 in
constr 0 encoded#10 (unListData alias#11) (unListData alias#11)
--- unoptimized UPLC
(program 1.1.0
  [(lam x_9
    [(lam encoded_10
      [(lam alias_11
        (constr 0
          encoded_10
          [(builtin unListData) alias_11]
          [(builtin unListData) alias_11]))
        encoded_10])
      [(builtin listData) x_9]])
    (force
      [[(force (builtin trace)) (con string "once")]
        (delay (con (list data) [(I 7)]))])])
--- optimized Core
