let anf#1 : int = trace "ignored field" in error in
let anf#2 : @constr[0](int, int) = constr 0 42 anf#1 in
field@0/2 anf#2
--- rewritten core (no second ANF)
let anf#3 : int = trace "ignored field" in error in
let anf#4 : @constr[0](int, int) = constr 0 42 anf#3 in
field@0/2 anf#4
