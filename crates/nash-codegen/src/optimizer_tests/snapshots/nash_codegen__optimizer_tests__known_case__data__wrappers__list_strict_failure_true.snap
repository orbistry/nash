                  (delay (error))]
                  (delay (error))]))
              data_6])
            (force [[builtin_10 (con string "between")] (delay (con integer 0))])])
          [(builtin listData) anf_5]])
        (force [[builtin_10 (con string "operand")] (delay (error))])])
      (force (builtin chooseData))])
    (force (builtin trace))])
--- isolated pass
