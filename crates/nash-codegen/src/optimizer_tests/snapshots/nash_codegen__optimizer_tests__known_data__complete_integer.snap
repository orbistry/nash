---
source: crates/nash-codegen/src/optimizer_tests/known_data.rs
expression: "crate::harness::pass_snapshot(b.arena, original,\nformat!(\"--- isolated ANF input\\n{}\\n--- isolated folded Core\\n{}\\n--- isolated cleaned Core\\n{}\\n--- isolated UPLC before\\n{}\\n--- isolated UPLC after\\n{}\\n--- result\\n{}\\n--- logs\\n{:?}\",\npretty(before), pretty(folded), pretty(after), left.uplc, right.uplc,\nright.result, right.logs))"
---
--- unoptimized Core
case@Data (con data (I 42)) of
  DataI unused#1 -> trace "integer" in 0
  DataB unused#2 -> trace "integer" in 1
  DataList unused#3 -> trace "integer" in 2
  DataMap unused#4 -> trace "integer" in 4
  DataConstr unused#5 -> trace "integer" in 6
  _ -> error
--- unoptimized UPLC
(program 1.1.0
  [(lam generated_6
    (force
      [[[[[[(force (builtin chooseData)) generated_6]
        (delay
          (force
            [[(force (builtin trace)) (con string "integer")] (delay (con integer 6))]))]
        (delay
          (force
            [[(force (builtin trace)) (con string "integer")] (delay (con integer 4))]))]
        (delay
          (force
            [[(force (builtin trace)) (con string "integer")] (delay (con integer 2))]))]
        (delay
          (force
            [[(force (builtin trace)) (con string "integer")] (delay (con integer 0))]))]
        (delay
          (force
            [[(force (builtin trace)) (con string "integer")] (delay (con integer 1))]))]))
    (con data (I 42))])
--- optimized Core
