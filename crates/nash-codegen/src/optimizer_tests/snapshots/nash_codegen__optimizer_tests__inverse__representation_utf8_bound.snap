---
source: crates/nash-codegen/src/optimizer_tests/inverse.rs
expression: "crate::harness::pass_snapshot(b.arena, before,\nformat!(\"--- core before\\n{}\\n--- uplc before\\n{}\\n--- core after\\n{}\\n--- uplc after\\n{}\\n--- result\\n{}\\n--- logs\\n{:?}\",\npretty(before), left.uplc, pretty(after), right.uplc, right.result,\nright.logs))"
---
--- unoptimized Core
let x#17 : string = trace "once" in "héllo" in
let encoded#18 : bytes = encodeUtf8 x#17 in
let alias#19 : bytes = encoded#18 in
trace "after encoding" in decodeUtf8 alias#19
--- unoptimized UPLC
(program 1.1.0
  [(lam x_17
    [(lam encoded_18
      [(lam alias_19
        (force
          [[(force (builtin trace)) (con string "after encoding")]
            (delay [(builtin decodeUtf8) alias_19])]))
        encoded_18])
      [(builtin encodeUtf8) x_17]])
    (force
      [[(force (builtin trace)) (con string "once")] (delay (con string "héllo"))])])
--- optimized Core
let x#1 : string = trace "once" in "héllo" in
