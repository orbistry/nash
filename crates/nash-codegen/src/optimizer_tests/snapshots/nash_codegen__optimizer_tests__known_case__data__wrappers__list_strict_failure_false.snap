---
source: crates/nash-codegen/src/optimizer_tests/known_case.rs
expression: "crate::harness::pass_snapshot(b.arena, original,\nformat!(\"--- isolated ANF input\\n{}\\n--- isolated folded Core\\n{}\\n--- isolated cleaned Core\\n{}\\n--- isolated UPLC before\\n{}\\n--- isolated UPLC after\\n{}\\n--- result\\n{}\\n--- logs\\n{:?}\",\npretty(before), pretty(folded), pretty(after), left.uplc, right.uplc,\nright.result, right.logs))"
---
--- unoptimized Core
let data#17 : Data = listData (trace "operand" in (con (list data) [(I 42)])) in
let effect#19 : int = trace "between" in 0 in
case@Data data#17 of
  DataList payload#18 -> trace "selected" in 9
--- unoptimized UPLC
(program 1.1.0
  [(lam data_17
    [(lam effect_19
      [(lam generated_20
        (force
          [[[[[[(force (builtin chooseData)) generated_20] (delay (error))] (delay (error))]
            (delay
              (force
                [[(force (builtin trace)) (con string "selected")] (delay (con integer 9))]))]
            (delay (error))]
            (delay (error))]))
        data_17])
      (force
        [[(force (builtin trace)) (con string "between")] (delay (con integer 0))])])
    [(builtin listData)
      (force
        [[(force (builtin trace)) (con string "operand")]
          (delay (con (list data) [(I 42)]))])]])
--- optimized Core
let anf#4 : list Data = trace "operand" in (con (list data) [(I 42)]) in
let data#1 : Data = listData anf#4 in
let effect#2 : int = trace "between" in 0 in
case@Data data#1 of
  DataList payload#3 -> trace "selected" in 9
--- optimized UPLC
(program 1.1.0
  [(lam builtin_10
    [(lam builtin_11
      [(lam anf_5
        [(lam data_6
          [(lam effect_7
            [(lam generated_9
              (force
                [[[[[[builtin_11 generated_9] (delay (error))] (delay (error))]
                  (delay (force [[builtin_10 (con string "selected")] (delay (con integer 9))]))]
                  (delay (error))]
                  (delay (error))]))
              data_6])
            (force [[builtin_10 (con string "between")] (delay (con integer 0))])])
          [(builtin listData) anf_5]])
        (force [[builtin_10 (con string "operand")] (delay (con (list data) [(I 42)]))])])
      (force (builtin chooseData))])
    (force (builtin trace))])
