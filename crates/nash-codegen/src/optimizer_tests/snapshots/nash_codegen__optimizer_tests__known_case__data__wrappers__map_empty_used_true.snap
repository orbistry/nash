--- isolated pass
--- isolated ANF input
let anf#65 : Data = mapData (con (list (pair data data)) []) in
case@Data anf#65 of
  DataMap payload#64 -> payload#64
--- isolated folded Core
let data_operand#66 : list (pair Data Data) = (con (list (pair data data)) []) in
let anf#65 : Data = mapData data_operand#66 in
let payload#64 : list (pair Data Data) = data_operand#66 in
payload#64
--- isolated cleaned Core
let data_operand#66 : list (pair Data Data) = (con (list (pair data data)) []) in
let anf#65 : Data = mapData data_operand#66 in
data_operand#66
