(program 1.1.0
  [(lam anf_65
    [(lam generated_66
      (force
        [[[[[[(force (builtin chooseData)) generated_66] (delay (error))]
          (delay [(lam payload_64 payload_64) [(builtin unMapData) generated_66]])]
          (delay (error))]
          (delay (error))]
          (delay (error))]))
      anf_65])
    [(builtin mapData) (con (list (pair data data)) [])]])
--- isolated UPLC after
