            [[(builtin equalsByteString) generated_2] (con bytestring #00)]
            (case
              [[(builtin equalsByteString) generated_2] (con bytestring #01)]
              (case
                [[(builtin equalsByteString) generated_2] (con bytestring #02)]
                (error)
                (force [partial_4 (delay (con integer 2))]))
              (force [partial_4 (delay (error))]))
            (force [partial_4 (delay (con integer 0))])))
          (con bytestring #09)])
        (force [[builtin_3 (con string "before")] (delay (con integer 7))])])
      [builtin_3 (con string "unselected")]])
    (force (builtin trace))])
