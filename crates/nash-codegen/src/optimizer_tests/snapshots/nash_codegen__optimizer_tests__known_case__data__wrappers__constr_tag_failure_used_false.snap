let effect#12 : int = trace "between" in 0 in
trace "selected" in 9
--- isolated UPLC before
(program 1.1.0
  [(lam anf_14
    [(lam anf_15
      [(lam data_11
        [(lam effect_12
          [(lam generated_16
            (force
              [[[[[[(force (builtin chooseData)) generated_16]
                (delay
                  (force
                    [[(force (builtin trace)) (con string "selected")] (delay (con integer 9))]))]
