expression: "crate::harness::pass_snapshot(b.arena, original,\nformat!(\"--- isolated ANF input\\n{}\\n--- isolated folded Core\\n{}\\n--- isolated cleaned Core\\n{}\\n--- isolated UPLC before\\n{}\\n--- isolated UPLC after\\n{}\\n--- result\\n{}\\n--- logs\\n{:?}\",\npretty(before), pretty(folded), pretty(after), left.uplc, right.uplc,\nright.result, right.logs))"
---
--- unoptimized Core
let data#9 : Data = listData (trace "before" in (con (list data) [(I 42)])) in
case@Bool false of
  True -> (con (list data) [(I 42)])
  False -> force (delay (case@Data data#9 of
    DataList payload#10 -> payload#10))
--- unoptimized UPLC
(program 1.1.0
  [(lam data_9
    (case
      (con bool False)
      (force
        (delay
          [(lam generated_11
            (force
              [[[[[[(force (builtin chooseData)) generated_11] (delay (error))] (delay (error))]
                (delay [(lam payload_10 payload_10) [(builtin unListData) generated_11]])]
                (delay (error))]
                (delay (error))]))
            data_9]))
      (con (list data) [(I 42)])))
    [(builtin listData)
      (force
        [[(force (builtin trace)) (con string "before")]
          (delay (con (list data) [(I 42)]))])]])
