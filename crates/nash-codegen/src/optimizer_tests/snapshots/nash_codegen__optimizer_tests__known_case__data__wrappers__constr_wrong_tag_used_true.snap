(program 1.1.0
  [(lam anf_39
    [(lam anf_40
      [(lam data_36
        [(lam effect_37
          [(lam generated_41
            (force
              [[[[[[(force (builtin chooseData)) generated_41]
                (delay
                  [(lam pair_38
                    (force
                      [[(force (builtin trace)) (con string "selected")]
                        (delay [(force (force (builtin fstPair))) pair_38])]))
