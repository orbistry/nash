---
source: crates/nash-codegen/src/optimizer_tests/known_case.rs
expression: "crate::harness::pass_snapshot(b.arena, original,\nformat!(\"--- isolated ANF input\\n{}\\n--- isolated folded Core\\n{}\\n--- isolated cleaned Core\\n{}\\n--- isolated UPLC before\\n{}\\n--- isolated UPLC after\\n{}\\n--- result\\n{}\\n--- logs\\n{:?}\",\npretty(before), pretty(folded), pretty(after), left.uplc, right.uplc,\nright.result, right.logs))"
---
--- unoptimized Core
let data#36 : Data = constrData (trace "tag" in true) (trace "fields" in (con (list data) [(I 42)])) in
let effect#37 : int = trace "between" in 0 in
case@Data data#36 of
  DataConstr pair#38 -> trace "selected" in fstPair pair#38
--- unoptimized UPLC
(program 1.1.0
  [(lam data_36
    [(lam effect_37
      [(lam generated_39
        (force
          [[[[[[(force (builtin chooseData)) generated_39]
            (delay
              [(lam pair_38
                (force
                  [[(force (builtin trace)) (con string "selected")]
                    (delay [(force (force (builtin fstPair))) pair_38])]))
                [(builtin unConstrData) generated_39]])]
            (delay (error))]
            (delay (error))]
            (delay (error))]
            (delay (error))]))
        data_36])
      (force
        [[(force (builtin trace)) (con string "between")] (delay (con integer 0))])])
    [[(builtin constrData)
      (force [[(force (builtin trace)) (con string "tag")] (delay (con bool True))])]
      (force
        [[(force (builtin trace)) (con string "fields")]
          (delay (con (list data) [(I 42)]))])]])
--- optimized Core
let anf#4 : bool = trace "tag" in true in
let anf#5 : list Data = trace "fields" in (con (list data) [(I 42)]) in
let data#1 : Data = constrData anf#4 anf#5 in
let effect#2 : int = trace "between" in 0 in
let pair#3 : pair int (list Data) = unConstrData data#1 in
trace "selected" in anf#4
--- optimized UPLC
(program 1.1.0
  [(lam builtin_11
    [(lam anf_6
      [(lam anf_7
        [(lam data_8
          [(lam effect_9
            [(lam pair_10 (force [[builtin_11 (con string "selected")] (delay anf_6)]))
              [(builtin unConstrData) data_8]])
            (force [[builtin_11 (con string "between")] (delay (con integer 0))])])
          [[(builtin constrData) anf_6] anf_7]])
        (force [[builtin_11 (con string "fields")] (delay (con (list data) [(I 42)]))])])
      (force [[builtin_11 (con string "tag")] (delay (con bool True))])])
    (force (builtin trace))])
--- isolated pass
--- isolated ANF input
let anf#39 : bool = trace "tag" in true in
let anf#40 : list Data = trace "fields" in (con (list data) [(I 42)]) in
let data#36 : Data = constrData anf#39 anf#40 in
let effect#37 : int = trace "between" in 0 in
case@Data data#36 of
  DataConstr pair#38 -> trace "selected" in fstPair pair#38
--- isolated folded Core
