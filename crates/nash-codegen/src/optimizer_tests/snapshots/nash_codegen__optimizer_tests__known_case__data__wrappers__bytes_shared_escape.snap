            [[[[[[(force (builtin chooseData)) generated_12] (delay (error))] (delay (error))]
              (delay (error))]
              (delay (error))]
              (delay [(lam payload_10 payload_10) [(builtin unBData) generated_12]])]))
          alias_9]
        [(lam generated_13
