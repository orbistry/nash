            [[[[[[(force (builtin chooseData)) generated_13] (delay (error))] (delay (error))]
              (delay (error))]
              (delay (error))]
              (delay [(lam payload_11 payload_11) [(builtin unBData) generated_13]])]))
          alias_9]))
      data_8])
    [(builtin bData)
      (force
        [[(force (builtin trace)) (con string "once")]
          (delay (con bytestring #6e617368))])]])
--- optimized Core
