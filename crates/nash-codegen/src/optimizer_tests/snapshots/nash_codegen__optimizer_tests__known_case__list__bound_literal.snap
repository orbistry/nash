  Cons head#16 tail#17 -> head#16 in
let anf#21 : int = case@List alias2#15 of
  Cons head#18 tail#19 -> head#18 in
let anf#22 : int = addInteger anf#20 anf#21 in
mkCons anf#22 xs#13
--- isolated folded Core
let list_field#23 : int = 21 in
