mkCons anf#22 (con (list integer) [21, 7])
--- isolated UPLC before
(program 1.1.0
  [(lam xs_13
    [(lam alias_14
      [(lam alias2_15
        [(lam anf_20
          [(lam anf_21
            [(lam anf_22 [[(force (builtin mkCons)) anf_22] xs_13])
