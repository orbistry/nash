(program 1.1.0
  [(lam anf_21
    [(lam anf_22
      [(lam data_14
        [(lam alias_15
          (case
            (con bool True)
            (force
              (delay
                [(lam anf_24
                  [(lam anf_25
                    [(lam anf_26 (constr 0 data_14 anf_25 anf_26))
                      [(lam generated_27
                        (force
                          [[[[[[(force (builtin chooseData)) generated_27]
                            (delay [(lam second_20 second_20) [(builtin unConstrData) generated_27]])]
                            (delay (error))]
                            (delay (error))]
                            (delay (error))]
                            (delay (error))]))
                        alias_15]])
                    [anf_24 (con integer 7)]])
                  [(lam generated_28
                    (force
                      [[[[[[(force (builtin chooseData)) generated_28]
                        (delay
                          [(lam pair_16
                            (lam x_17
                              [(lam anf_23 (constr 0 pair_16 anf_23 x_17))
                                (case pair_16 (lam tag_18 (lam fields_19 (constr 0 tag_18 fields_19))))]))
                            [(builtin unConstrData) generated_28]])]
                        (delay (error))]
                        (delay (error))]
                        (delay (error))]
                        (delay (error))]))
                    alias_15]]))
            (constr 1)))
          data_14])
        [[(builtin constrData) anf_21] anf_22]])
      (force
        [[(force (builtin trace)) (con string "fields")]
          (delay (con (list data) [(I 42)]))])])
    (force [[(force (builtin trace)) (con string "tag")] (delay (con integer 59))])])
--- isolated UPLC after
(program 1.1.0
