      (force
        [[[[[[builtin_3 generated_2] (delay (error))] (delay (error))] (delay (error))]
          (delay [(lam number_1 number_1) [(builtin unIData) generated_2]])]
          (delay (error))]))
      (con integer 42)])
    (force (builtin chooseData))])
