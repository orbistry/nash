---
source: crates/nash-codegen/src/optimizer_tests/known_case.rs
expression: "crate::harness::pass_snapshot(b.arena, original,\nformat!(\"--- isolated ANF input\\n{}\\n--- isolated folded Core\\n{}\\n--- isolated cleaned Core\\n{}\\n--- isolated UPLC before\\n{}\\n--- isolated UPLC after\\n{}\\n--- result\\n{}\\n--- logs\\n{:?}\",\npretty(before), pretty(folded), pretty(after), left.uplc, right.uplc,\nright.result, right.logs))"
---
--- unoptimized Core
let subject#5 : @constr[0](int) = constr 0 (trace "field" in 42) in
force (delay (case@Tag subject#5 of
  0 x#6 -> x#6))
--- unoptimized UPLC
(program 1.1.0
  [(lam subject_5 (force (delay (case subject_5 (lam x_6 x_6)))))
    (constr 0
      (force
        [[(force (builtin trace)) (con string "field")] (delay (con integer 42))]))])
--- optimized Core
trace "field" in 42
--- optimized UPLC
(program 1.1.0
  [(lam builtin_1
    (force [[builtin_1 (con string "field")] (delay (con integer 42))]))
    (force (builtin trace))])
--- isolated pass
--- isolated ANF input
let anf#8 : int = trace "field" in 42 in
let subject#5 : @constr[0](int) = constr 0 anf#8 in
force (delay (case@Tag subject#5 of
  0 x#6 -> x#6))
--- isolated folded Core
let anf#8 : int = trace "field" in 42 in
let subject#5 : @constr[0](int) = constr 0 anf#8 in
force (delay (let x#6 : int = anf#8 in
x#6))
--- isolated cleaned Core
trace "field" in 42
--- isolated UPLC before
(program 1.1.0
  [(lam anf_8
    [(lam subject_5 (force (delay (case subject_5 (lam x_6 x_6)))))
      (constr 0 anf_8)])
    (force
      [[(force (builtin trace)) (con string "field")] (delay (con integer 42))])])
--- isolated UPLC after
(program 1.1.0
  (force
    [[(force (builtin trace)) (con string "field")] (delay (con integer 42))]))
--- result
(con integer 42)
--- logs
["field"]
