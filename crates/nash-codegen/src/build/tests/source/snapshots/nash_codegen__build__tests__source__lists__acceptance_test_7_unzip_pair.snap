let x#2 : list (pair Data Data) = mkCons (mkPairData (iData (fromInt#5 3)) (bData (fromBytes#6 (con bytestring #55)))) (mkCons (mkPairData (iData (fromInt#5 4)) (bData (fromBytes#6 (con bytestring #7799)))) (con (list (pair data data)) [])) in
let main#1 : bool = same#3 (unzip#4 x#2) (mkPairData (listData (mkCons (iData (fromInt#5 3)) (mkCons (iData (fromInt#5 4)) (con (list data) [])))) (listData (mkCons (bData (fromBytes#6 (con bytestring #55))) (mkCons (bData (fromBytes#6 (con bytestring #7799))) (con (list data) []))))) in
