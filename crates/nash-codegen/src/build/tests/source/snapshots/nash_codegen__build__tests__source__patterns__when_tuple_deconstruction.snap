let match#8 : (Main.datum, Main.redSpend) = constr 0 ((\field#2 : Main.thing -> constr 0 field#2) ((\field#3 : int -> constr 0 field#3) (fromInt#4 42))) (constr 1) in
let leaf#13 : 'erased = delay true in
let main#1 : bool = case@Tag match#8 of
  0 field#14 field#15 -> case@Tag field#14 of
    0 field#16 -> case@Tag field#15 of
      0 field#17 -> let a#5 : Main.thing = field#16 in
      let x#6 : int = field#17 in
      let projection#20 : 'erased = field@0/1 a#5 in
      case@Bool equalsInteger projection#20 x#6 of
        True -> true
        False -> trace (fromString#7 message#21) in false
      1 -> force leaf#13
    1 -> force leaf#13 in
main#1
