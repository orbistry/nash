(\field#14 : list (pair Data Data) -> constr 0 field#14) (con (list (pair data data)) []) in
let main#1 : bool = same#2 (new#3 ()) ((\field#4 : list (pair Data Data) -> constr 0 field#4) (con (list (pair data data)) [])) in
main#1
