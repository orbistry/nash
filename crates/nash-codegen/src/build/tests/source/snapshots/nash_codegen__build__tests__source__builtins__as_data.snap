let main#1 : bool = case@Bool nullList (mkCons (toData#2 ((\field#3 : Int -> constrData 0 (mkCons field#3 (con (list data) []))) (fromInt#4 14))) (mkCons (toData#2 ((\field#5 : Int -> constrData 0 (mkCons field#5 (con (list data) []))) (fromInt#4 42))) (con (list data) []))) of
  True -> false
  False -> true in
main#1
