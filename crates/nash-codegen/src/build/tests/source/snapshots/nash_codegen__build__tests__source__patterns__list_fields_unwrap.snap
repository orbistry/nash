mkCons ((\field#16 : Bytes field#17 : Int -> constrData 0 (mkCons field#16 (mkCons field#17 (con (list data) [])))) (fromBytes#18 (con bytestring #)) (fromInt#19 14)) (mkCons ((\field#20 : Bytes field#21 : Int -> constrData 0 (mkCons field#20 (mkCons field#21 (con (list data) [])))) (fromBytes#18 (con bytestring #aa)) (fromInt#19 0)) (con (list data) [])) in
