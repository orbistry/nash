let main#1 : bool = case@Bool equalsInteger (unIData decodedInt#2) (fromInt#3 42) of
  True -> case@Bool equalsByteString (unBData decodedBytes#4) (fromBytes#5 (con bytestring #abcd)) of
    True -> equalsData (toData#6 decodedInt#2) ((\field#7 : int -> iData field#7) (fromInt#3 42))
    False -> false
  False -> false in
main#1
