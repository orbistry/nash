---
source: crates/nash-codegen/src/build/tests.rs
description: "module Literal exposing (FromInt, FromString, FromBytes)\n\nimport Builtin exposing (..)\n\ntrait FromInt 'a where\n    fromInt : int -> 'a\n\ntrait FromString 'a where\n    fromString : string -> 'a\n\ntrait FromBytes 'a where\n    fromBytes : bytes -> 'a\n\nimpl FromInt int where\n    fromInt value = value\n\nimpl FromString string where\n    fromString value = value\n\nimpl FromBytes bytes where\n    fromBytes value = value\n\nimpl FromInt Int where\n    fromInt = Builtin.iData\n\nimpl FromBytes Bytes where\n    fromBytes = Builtin.bData\n\nimpl FromString bytes where\n    fromString = Builtin.encodeUtf8\n\nmodule Eq exposing (Eq)\n\nimport Builtin exposing (..)\n\ntrait Eq 'a where\n    eq : 'a -> 'a -> bool\n\n    neq : 'a -> 'a -> bool\n    neq a b = if eq a b then False else True\n\nimpl Eq int where\n    eq = Builtin.equalsInteger\n\nimpl Eq bytes where\n    eq = Builtin.equalsByteString\n\nimpl Eq string where\n    eq = Builtin.equalsString\n\nimpl Eq bool where\n    eq a b = if a then b else if b then False else True\n\nimpl Eq unit where\n    eq _ _ = True\n\nimpl Eq 'a => Eq (list 'a) where\n    eq xs ys =\n        if Builtin.nullList xs then Builtin.nullList ys\n        else if Builtin.nullList ys then False\n        else if eq (Builtin.headList xs) (Builtin.headList ys) then eq (Builtin.tailList xs) (Builtin.tailList ys)\n        else False\n\nimpl (Eq 'a, Eq 'b) => Eq (pair 'a 'b) where\n    eq a b =\n        if eq (Builtin.fstPair a) (Builtin.fstPair b) then\n            eq (Builtin.sndPair a) (Builtin.sndPair b)\n        else False\nimpl Eq value where\n    eq a b = Builtin.equalsData (Builtin.valueData a) (Builtin.valueData b)\n\nmodule Main exposing (..)\nimport Builtin exposing (..)\nchoose : bool -> int\nchoose flag =\n    if trace \"condition\" flag then trace \"true\" 42\n    else trace \"false\" 7\nmain = (choose True, choose False)\n"
---
--- uplc
(program 1.1.0
  [(lam message_8
    [(lam message_9
      [(lam message_10
        [(lam fromInt_4
          [(lam fromString_5
            [(lam choose_2
              [(lam main_1 main_1)
                (constr 0 [choose_2 (con bool True)] [choose_2 (con bool False)])])
              (lam flag_3
                [(lam generated_11
                  (case
                    generated_11
                    (force
                      [[(force (builtin trace)) [fromString_5 message_10]]
                        (delay [fromInt_4 (con integer 7)])])
                    (force
                      [[(force (builtin trace)) [fromString_5 message_9]]
                        (delay [fromInt_4 (con integer 42)])])))
                  (force [[(force (builtin trace)) [fromString_5 message_8]] (delay flag_3)])])])
            (lam value_7 value_7)])
          (lam value_6 value_6)])
        (con string "false")])
      (con string "true")])
    (con string "condition")])
