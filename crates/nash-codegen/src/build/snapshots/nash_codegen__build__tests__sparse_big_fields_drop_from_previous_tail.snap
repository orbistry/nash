        Cons head#11 tail#12 -> addInteger evaluated#16 (addInteger evaluated#15 (unIData head#11)) in
let fromInt#3 : int -> Int = iData in
let main#1 : int = select#2 (listData (mkCons (fromInt#3 1) (mkCons (fromInt#3 2) (mkCons (fromInt#3 3) (mkCons (fromInt#3 4) (mkCons (fromInt#3 5) (mkCons (fromInt#3 6) (con (list data) [])))))))) in
main#1
